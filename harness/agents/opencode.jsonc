{
  "$schema": "https://opencode.ai/config.json",
  // Written into every run by the harness before each turn; edits by an agent do not survive.
  "policies": [
    // code-mode `execute` runs fetch() outside the webfetch allowlist (research/opencode-execute-bypass-2026-10-16.md)
    { "action": "tool.use", "resource": "execute:*", "effect": "deny" }
  ]
}
