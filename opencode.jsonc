{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    // code-mode `execute` runs fetch() outside the webfetch domain allowlist,
    // so it is denied project-wide (research/opencode-execute-bypass-2026-10-16.md).
    { "action": "tool.use", "resource": "execute:*", "effect": "deny" }
  ]
}
