{
  "schemaVersion": "1.2",
  "profileId": "profile.business.crm",
  "profileVersion": "1.2",
  "resourceType": "business-saas-template",
  "scopeId": "scope.crm.sandbox.single-tenant",
  "owner": "security-license-reviewer",
  "maxAttestableLevel": "L3",
  "validationMethod": {
    "type": "MIXED",
    "procedureRef": "14_GATE_PROFILES.md"
  },
  "expiryPolicy": {
    "maxAgeDays": 180,
    "reviewWindowDays": 30,
    "reusePolicy": "SAME_DIGEST_ONLY"
  },
  "levels": {
    "L1": [
      "G-ORIGIN",
      "G-LICENSE",
      "G-BUILD",
      "G-CORE",
      "G-SECURITY",
      "G-SCOPE",
      "G-ISOLATION"
    ],
    "L2": [
      "G-DOMAIN-COMPLETE",
      "G-AUTHZ",
      "G-FAILURES",
      "G-INSTALL",
      "G-MIGRATION",
      "G-OPERATIONS"
    ],
    "L3": [
      "G-REUSE",
      "G-UPGRADE",
      "G-RESILIENCE",
      "G-UX",
      "G-MAINTENANCE"
    ]
  },
  "conditional": [
    {
      "gateId": "P-LIVE-TEST",
      "trigger": "PAYMENTS",
      "description": "Real payment channels require the live-qualification gate when the scope declares a LIVE payment channel.",
      "requiredWhenActivated": true
    },
    {
      "gateId": "A-LIVE-MOCK-LABEL",
      "trigger": "AI_LIVE",
      "description": "Real model calls require the mock/live labelling gate when a LIVE AI channel is declared.",
      "requiredWhenActivated": true
    },
    {
      "gateId": "U-ASSET-LICENSE",
      "trigger": "PROTOTYPE_INTEGRATED",
      "description": "Integrated prototypes must prove asset licensing.",
      "requiredWhenActivated": true
    }
  ],
  "reviewPolicy": {
    "independentValidatorRequired": true
  }
}
