{
  "schemaVersion": "1.2",
  "batchId": "pilot-discovery-sample",
  "catalogRevision": "catalog-v0.2-sample",
  "targetIds": [
    "saas.payments.wechat",
    "business.crm",
    "ai.workflow"
  ],
  "riskClass": "READ_ONLY",
  "dedicatedRiskExecution": false,
  "executionMode": "READ_ONLY",
  "dryRun": true,
  "concurrency": {
    "discovery": 3,
    "build": 1
  },
  "budget": {
    "maxUsd": 0,
    "maxAttemptsPerJob": 2,
    "maxRuntimeMinutes": 20
  },
  "retryPolicy": {
    "maxAttempts": 2,
    "backoff": "EXPONENTIAL",
    "maxBackoffSeconds": 60
  },
  "timeout": {
    "perJobMinutes": 20,
    "totalMinutes": 60
  },
  "approvalRequired": true,
  "approvalStrategy": {
    "mode": "MANUAL_REQUIRED",
    "approverRole": "PRODUCT_OWNER"
  },
  "auditScope": {
    "level": "METADATA",
    "retentionDays": 90,
    "includePayloadHashes": true
  },
  "stopConditions": [
    "license blocked",
    "security unknown",
    "budget exhausted",
    "attempted host write"
  ],
  "dependencies": []
}
