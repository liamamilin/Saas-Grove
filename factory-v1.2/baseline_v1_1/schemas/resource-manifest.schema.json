{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/factory/v1.1/resource-manifest.schema.json",
  "title": "resource-manifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "resourceType": {
      "type": "string",
      "enum": [
        "saas-core-module",
        "business-saas-template",
        "ai-native-template",
        "saas-ai-module"
      ]
    },
    "version": {
      "type": "string"
    },
    "maintainer": {
      "type": "string"
    },
    "capabilitiesProvided": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "deliveryForm": {
      "type": "string",
      "enum": [
        "NATIVE",
        "FORK",
        "INTEGRATION"
      ]
    },
    "origins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "usage": {
            "type": "string",
            "enum": [
              "vendored",
              "dependency",
              "integration",
              "reference",
              "first-party"
            ]
          },
          "licenseStatus": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REVIEW_REQUIRED",
              "BLOCKED",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "url",
          "revision",
          "usage",
          "licenseStatus"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "prototypeResources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "versionRange": {
            "type": "string"
          },
          "implementationLevel": {
            "type": "string",
            "enum": [
              "design-only",
              "interactive-mock",
              "integrated"
            ]
          },
          "coverage": {
            "type": "string",
            "enum": [
              "full-app",
              "page",
              "flow"
            ]
          }
        },
        "required": [
          "id",
          "versionRange",
          "implementationLevel",
          "coverage"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "qualityLevel": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "CATALOGED",
        "VERIFIED",
        "RELEASE_READY"
      ]
    },
    "usePolicy": {
      "type": "string",
      "enum": [
        "RESEARCH_ONLY",
        "SANDBOX_ONLY",
        "INTERNAL_ONLY",
        "PRODUCTION_ELIGIBLE"
      ]
    },
    "publicationStatus": {
      "type": "string",
      "enum": [
        "PRIVATE",
        "LISTED",
        "DEPRECATED",
        "QUARANTINED",
        "WITHDRAWN"
      ]
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "knownLimitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^([a-f0-9]{64}|UNBUILT)$"
    },
    "licenseReport": {
      "type": "string"
    },
    "installGuide": {
      "type": "string"
    },
    "testPlan": {
      "type": "string"
    },
    "defaultScopeId": {
      "type": "string",
      "minLength": 1
    },
    "attestationRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "resourceType",
    "version",
    "maintainer",
    "capabilitiesProvided",
    "deliveryForm",
    "origins",
    "qualityLevel",
    "verificationStatus",
    "usePolicy",
    "publicationStatus",
    "evidenceIds",
    "knownLimitations",
    "artifactSha256",
    "licenseReport",
    "installGuide",
    "testPlan"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "qualityLevel": {
            "const": "L0"
          }
        },
        "required": [
          "qualityLevel"
        ]
      },
      "then": {
        "properties": {
          "verificationStatus": {
            "const": "CATALOGED"
          },
          "usePolicy": {
            "const": "RESEARCH_ONLY"
          },
          "publicationStatus": {
            "const": "PRIVATE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "qualityLevel": {
            "enum": [
              "L1",
              "L2",
              "L3"
            ]
          }
        },
        "required": [
          "qualityLevel"
        ]
      },
      "then": {
        "properties": {
          "verificationStatus": {
            "enum": [
              "VERIFIED",
              "RELEASE_READY"
            ]
          },
          "artifactSha256": {
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "evidenceIds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "usePolicy": {
            "const": "PRODUCTION_ELIGIBLE"
          }
        },
        "required": [
          "usePolicy"
        ]
      },
      "then": {
        "properties": {
          "verificationStatus": {
            "const": "RELEASE_READY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publicationStatus": {
            "const": "LISTED"
          }
        },
        "required": [
          "publicationStatus"
        ]
      },
      "then": {
        "properties": {
          "verificationStatus": {
            "const": "RELEASE_READY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "qualityLevel": {
            "enum": [
              "L1",
              "L2",
              "L3"
            ]
          }
        },
        "required": [
          "qualityLevel"
        ]
      },
      "then": {
        "required": [
          "defaultScopeId",
          "attestationRefs"
        ],
        "properties": {
          "attestationRefs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
