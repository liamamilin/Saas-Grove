{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/factory/v1.2/scoped-attestation.schema.json",
  "title": "scoped-attestation",
  "description": "V1.2: unchanged V1.1 keys plus optional freezeId / payloadManifestSha256 (CF-5 digest chain) and activeConditionalTriggers (CF-3 conditional-gate activation). usePolicy is deliberately NOT a field here (CF-4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attestationId",
    "resourceId",
    "resourceVersion",
    "artifactSha256",
    "scopeId",
    "profileId",
    "profileVersion",
    "requestedLevel",
    "attestedLevel",
    "attestationStatus",
    "gateEvidenceIds",
    "issuedAt",
    "expiresAt",
    "reviewerId",
    "reviewDecisionId",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2"
    },
    "attestationId": {
      "type": "string",
      "minLength": 1
    },
    "resourceId": {
      "type": "string",
      "minLength": 1
    },
    "resourceVersion": {
      "type": "string",
      "minLength": 1
    },
    "artifactSha256": {
      "pattern": "^([a-f0-9]{64}|UNBUILT)$",
      "type": "string"
    },
    "freezeId": {
      "type": "string",
      "minLength": 1
    },
    "payloadManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "profileVersion": {
      "type": "string",
      "minLength": 1
    },
    "requestedLevel": {
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "attestedLevel": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "L1",
        "L2",
        "L3",
        null
      ]
    },
    "attestationStatus": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "REVIEW_DUE",
        "REVOKED",
        "SUPERSEDED"
      ]
    },
    "gateEvidenceIds": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "activeConditionalTriggers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PAYMENTS",
          "AI_LIVE",
          "PROTOTYPE_INTEGRATED",
          "TENANT_MULTI",
          "PII",
          "EXTERNAL_API"
        ]
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewerId": {
      "type": "string"
    },
    "reviewDecisionId": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "attestationStatus": {
            "const": "ACTIVE"
          }
        }
      },
      "then": {
        "properties": {
          "artifactSha256": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "attestedLevel": {
            "type": "string"
          },
          "reviewerId": {
            "minLength": 1
          },
          "reviewDecisionId": {
            "minLength": 1
          }
        }
      }
    }
  ]
}
