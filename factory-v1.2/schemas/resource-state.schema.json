{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/factory/v1.2/resource-state.schema.json",
  "title": "resource-state",
  "description": "CF-4/CF-5 fix. Post-freeze projection / registry index entry. This is the ONLY place where qualityLevel / verificationStatus / publicationStatus are cached, and it is updated OUTSIDE the frozen payload. usePolicy is intentionally absent: it is decided solely by a DeploymentEligibilityDecision referenced via deploymentEligibilityRef.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resourceId",
    "resourceVersion",
    "artifactSha256",
    "qualityLevel",
    "verificationStatus",
    "publicationStatus",
    "evidenceIds",
    "attestationRefs",
    "defaultScopeId"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.2"
      ]
    },
    "resourceId": {
      "type": "string",
      "minLength": 1
    },
    "resourceVersion": {
      "type": "string",
      "minLength": 1
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^([a-f0-9]{64}|UNBUILT)$"
    },
    "qualityLevel": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "CATALOGED",
        "VERIFIED",
        "RELEASE_READY"
      ]
    },
    "publicationStatus": {
      "type": "string",
      "enum": [
        "PRIVATE",
        "LISTED",
        "DEPRECATED",
        "QUARANTINED",
        "WITHDRAWN"
      ]
    },
    "attestationRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "deploymentEligibilityRef": {
      "type": "string",
      "minLength": 1
    },
    "defaultScopeId": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "qualityLevel": {
            "const": "L0"
          }
        },
        "required": [
          "qualityLevel"
        ]
      },
      "then": {
        "properties": {
          "verificationStatus": {
            "const": "CATALOGED"
          },
          "publicationStatus": {
            "const": "PRIVATE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "qualityLevel": {
            "enum": [
              "L1",
              "L2",
              "L3"
            ]
          }
        },
        "required": [
          "qualityLevel"
        ]
      },
      "then": {
        "properties": {
          "verificationStatus": {
            "enum": [
              "VERIFIED",
              "RELEASE_READY"
            ]
          },
          "artifactSha256": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "attestationRefs": {
            "minItems": 1
          },
          "evidenceIds": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publicationStatus": {
            "const": "LISTED"
          }
        },
        "required": [
          "publicationStatus"
        ]
      },
      "then": {
        "properties": {
          "verificationStatus": {
            "const": "RELEASE_READY"
          },
          "deploymentEligibilityRef": {
            "minLength": 1
          }
        },
        "required": [
          "deploymentEligibilityRef"
        ]
      }
    }
  ]
}
