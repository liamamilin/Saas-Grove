{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/factory/v1.1/evidence.schema.json",
  "title": "evidence",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.2"
      ]
    },
    "id": {
      "type": "string"
    },
    "subjectId": {
      "type": "string"
    },
    "gateId": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "UNKNOWN"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "SPEC",
        "CODE",
        "UNIT",
        "INTEGRATION",
        "E2E",
        "BLIND",
        "LIVE",
        "LICENSE",
        "SECURITY",
        "RELEASE"
      ]
    },
    "sourceCommit": {
      "type": "string"
    },
    "artifactSha256": {
      "type": "string"
    },
    "freezeId": {
      "type": "string",
      "minLength": 1
    },
    "payloadManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "STATIC",
            "MOCK",
            "SANDBOX",
            "LIVE"
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "description"
      ],
      "additionalProperties": false
    },
    "validatorVersion": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "outputUri": {
      "type": "string"
    },
    "outputSha256": {
      "type": "string"
    },
    "collectedAt": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "reviewer": {
      "type": "string"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "profileVersion": {
      "type": "string",
      "minLength": 1
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "validationRole": {
      "enum": [
        "BUILDER",
        "INDEPENDENT_VALIDATOR",
        "LICENSE_REVIEWER",
        "SECURITY_REVIEWER",
        "RELEASE_APPROVER"
      ]
    },
    "actorRole": {
      "description": "CF-7 canonical governance role of the actor. Distinct axis from validationRole.",
      "enum": [
        "PRODUCT_OWNER",
        "DISCOVERY_AGENT",
        "BUILDER_AGENT",
        "VALIDATOR",
        "SECURITY_LICENSE_REVIEWER",
        "RELEASE_APPROVER"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "subjectId",
    "gateId",
    "result",
    "kind",
    "sourceCommit",
    "artifactSha256",
    "environment",
    "validatorVersion",
    "method",
    "outputUri",
    "outputSha256",
    "collectedAt",
    "actor",
    "scope",
    "limitations",
    "scopeId",
    "profileId",
    "profileVersion",
    "validationRole"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "required": [
          "expiresAt"
        ],
        "properties": {
          "artifactSha256": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "outputSha256": {
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
