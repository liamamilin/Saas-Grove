{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/factory/v1.2/change-impact-record.schema.json",
  "title": "change-impact-record",
  "description": "CF-8 fix. Schema for the ChangeImpactRecord required by 19_RISK_AND_CHANGE_CONTROL.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "changeSource",
    "affectedArtifacts",
    "invalidatedGates",
    "recommendedAction",
    "owner",
    "dueDate",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.2"
      ]
    },
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "changeSource": {
      "type": "string",
      "enum": [
        "UPSTREAM",
        "SELF",
        "SCENARIO"
      ]
    },
    "affectedArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resourceId",
          "resourceVersion",
          "artifactSha256"
        ],
        "properties": {
          "resourceId": {
            "type": "string",
            "minLength": 1
          },
          "resourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^([a-f0-9]{64}|UNBUILT)$"
          },
          "scopeId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "invalidatedGates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "recommendedAction": {
      "type": "string",
      "enum": [
        "NO_IMPACT",
        "PARTIAL_RECHECK",
        "FULL_RECHECK",
        "QUARANTINE"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "dueDate": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
