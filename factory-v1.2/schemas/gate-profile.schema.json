{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/factory/v1.2/gate-profile.schema.json",
  "title": "gate-profile",
  "description": "CF-3 fix. Retains levels{L1,L2,L3}/reviewPolicy from V1.1 and adds the doc-09 model: conditional[], validationMethod, expiryPolicy, owner, plus an explicit maxAttestableLevel cap used by the reference engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "profileVersion",
    "resourceType",
    "scopeId",
    "owner",
    "validationMethod",
    "expiryPolicy",
    "levels",
    "reviewPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2"
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "profileVersion": {
      "type": "string",
      "minLength": 1
    },
    "resourceType": {
      "enum": [
        "saas-core-module",
        "business-saas-template",
        "ai-native-template",
        "saas-ai-module"
      ]
    },
    "scopeId": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "maxAttestableLevel": {
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "validationMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "MACHINE",
            "HUMAN",
            "MIXED"
          ]
        },
        "procedureRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expiryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAgeDays"
      ],
      "properties": {
        "maxAgeDays": {
          "type": "integer",
          "minimum": 1
        },
        "reviewWindowDays": {
          "type": "integer",
          "minimum": 1
        },
        "reusePolicy": {
          "type": "string",
          "enum": [
            "NO_REUSE",
            "SAME_DIGEST_ONLY",
            "REVIEWER_APPROVED_ONLY"
          ]
        }
      }
    },
    "levels": {
      "type": "object",
      "required": [
        "L1",
        "L2",
        "L3"
      ],
      "additionalProperties": false,
      "properties": {
        "L1": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "L2": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "L3": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "conditional": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gateId",
          "trigger",
          "description",
          "requiredWhenActivated"
        ],
        "properties": {
          "gateId": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "enum": [
              "PAYMENTS",
              "AI_LIVE",
              "PROTOTYPE_INTEGRATED",
              "TENANT_MULTI",
              "PII",
              "EXTERNAL_API"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "requiredWhenActivated": {
            "type": "boolean"
          }
        }
      }
    },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independentValidatorRequired"
      ],
      "properties": {
        "independentValidatorRequired": {
          "type": "boolean"
        }
      }
    }
  }
}
