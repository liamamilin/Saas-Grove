# Real model provider for products built from blueprints (decision H1).
# Copy to .env and fill in. .env is git-ignored; never commit a key.
# Acceptance runs never read this file: they always use MODEL_PROVIDER=fake.

MODEL_PROVIDER=real
# OpenAI-compatible endpoint, e.g. the open-design endpoint configured for opencode:
# https://amr-link.open-design.ai/v1
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=deepseek-v4.1-flash

# USD per million tokens, used for usage accounting and budgets.
# Products refuse to start in real mode without them (no silent zero-cost billing).
MODEL_INPUT_USD_PER_MTOK=
MODEL_OUTPUT_USD_PER_MTOK=

# Embeddings: "local" = deterministic, offline. Switch to "openai-compatible"
# once an embedding endpoint is available (and uncomment the three below).
EMBEDDING_PROVIDER=local
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
