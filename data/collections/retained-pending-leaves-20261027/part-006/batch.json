  "entries": [
    {
      "id": "github:1160427004",
      "name": "Open2DMeasure",
      "track": "open_source",
      "summary": "开源 Windows 桌面 2D 尺寸计量应用：导入零件图像并按已知距离标定比例，创建点/线/圆等几何并构造交点、中点等派生特征，测量距离、X/Y 距离、直径、半径和角度；可为每项测量设置名义值及上下公差，软件逐项给出 OK/KO 判定，保存工程并导出 CSV 检验记录，包含零件代码、描述、计量员、时间戳等表头及逐特征的名义值、公差、实测值、偏差和状态。",
      "homepage": "https://github.com/Marcross91/Open2DMeasure",
      "repository_url": "https://github.com/Marcross91/Open2DMeasure",
      "github_repository_id": 1160427004,
      "license": "GPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/Marcross91/Open2DMeasure/license",
      "features": [
        "导入零件图像并按已知距离标定像素比例",
        "创建点、线、圆并构造交点、中点等派生几何",
        "测量距离、X/Y 距离、直径、半径和角度",
        "为测量设置名义值、上公差和下公差",
        "按名义值±公差逐项计算 OK/KO 状态",
        "导出含零件信息表头和逐特征结果的 CSV 检验报告",
        "保存和载入测量工程"
      ],
      "deployment": [
        "Windows 桌面本地运行（.NET WinForms）",
        "自托管、离线使用，不依赖远程服务"
      ],
      "technology_stack": [
        "C#",
        ".NET Framework",
        "WinForms"
      ],
