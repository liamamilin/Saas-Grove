    {
      "id": "github:36218357",
      "name": "Superdesk Publisher",
      "track": "open_source",
      "summary": "Open-source (AGPL-3.0) publishing platform for journalists and newsrooms in the Superdesk suite. Articles are held as persistent records and pass through an output-control gate: incoming articles are not visible online until assigned to a tenant and route, and published articles can be moved to another route, published to additional tenants or unpublished. Editors can also build manual content lists by dragging and dropping published stories, with the list order defining front-page order. Content can also originate in Superdesk or a legacy editorial back end.",
      "homepage": "https://www.superdesk.org/publishing/publisher",
      "repository_url": "https://github.com/superdesk/web-publisher",
      "github_repository_id": 36218357,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/superdesk/web-publisher/license",
      "features": [
        "Persistent article records with title, URL, route, metadata, keywords, authors and related media",
        "Output control separates incoming articles from published articles; incoming content stays offline until assigned to a tenant and route",
        "Explicit publishing to a tenant and route, publishing to additional tenants, route changes and unpublishing of published articles",
        "Webhook events for publish, unpublish and update of articles",
        "Site redirects plus an original article URL retained after slug or route changes",
        "Manual content lists where editors drag and drop published stories and the list order determines front-page order",
        "Automatic content lists driven by route, author, publication date and metadata rules"
      ],
      "deployment": [
        "Self-hosted Symfony/PHP application on a standard web server",
        "Official Docker installation path",
        "Integrated with Superdesk for editorial production; can be extended to legacy back ends"
      ],
      "technology_stack": [
        "PHP",
        "Symfony",
        "PostgreSQL",
        "Twig"
      ],
