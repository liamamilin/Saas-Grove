      "id": "github:375152",
      "name": "Open Journal Systems",
      "track": "open_source",
      "summary": "Open-source journal and periodical publishing system for maintaining a journal and its Future/Back issue records, scheduling articles into dated issues, publishing or unpublishing issues, and recording subscription/access terms.",
      "homepage": "https://pkp.sfu.ca/software/ojs/",
      "repository_url": "https://github.com/pkp/ojs",
      "github_repository_id": 375152,
      "license": "GPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/pkp/ojs/license",
      "features": [
        "Journal record with Future Issues and Back Issues",
        "Issue creation with volume, number, year, title, description, cover and URL path",
        "Article scheduling into issues with publication dates",
        "Issue publication, unpublishing, deletion and article version history",
        "Subscription types, expiry, renewal reminders and payment records",
        "Open access, subscription and hybrid issue/article access"
      ],
      "deployment": [
        "Self-hosted PHP 8.2+ application",
        "MySQL/MariaDB or PostgreSQL database"
      ],
      "technology_stack": [
        "PHP",
        "MySQL/MariaDB",
        "PostgreSQL"
      ],
