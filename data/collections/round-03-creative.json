    {
      "id": "github:119160553",
      "name": "PhotoPrism",
      "track": "open_source",
      "summary": "PhotoPrism 是用于浏览、整理、搜索和分享照片及视频的自托管 Web/PWA 应用，含多格式图像显示和可持续管理的照片库。",
      "homepage": "https://photoprism.app",
      "repository_url": "https://github.com/photoprism/photoprism",
      "github_repository_id": 119160553,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://raw.githubusercontent.com/photoprism/photoprism/develop/LICENSE",
      "license_review": {
        "reviewer": "source_research",
        "source_url": "https://raw.githubusercontent.com/photoprism/photoprism/develop/LICENSE",
        "spdx_id": "AGPL-3.0",
        "scope": "repository",
        "rationale": "核对官方仓库 LICENSE 全文及 README 的 AGPL 3.0 标识；第18节 PhotoPrism® Trademark and Brand Assets 保留品牌资产/商标权，品牌资产不包含在开源许可声明中。官方同时说明文档采用 CC BY-NC-SA 4.0，不将文档许可误作软件许可。"
      },
      "features": [
        "在 Web/PWA 中查看照片和视频，支持 RAW 与常见图像、视频格式",
        "按标签、位置、分辨率、颜色和质量组合搜索；提取并合并 Exif、XMP 等元数据",
        "管理照片库并通过链接分享；支持与手机备份及 WebDAV 客户端协作"
      ],
      "deployment": [
        "官方提供 Docker Compose 等社区版自托管方式，服务通过 Web 浏览器访问；亦提供商业托管服务"
      ],
      "technology_stack": [
        "Go 服务端",
        "Vue.js 前端",
        "SQLite 或 MariaDB 10.5.12+（官方当前支持；MySQL 8 支持已停止）"
      ],
