      "license": "GPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/PatWie/digitalmusicstand/license",
      "features": [
        "以单个可执行文件内嵌全部静态资源并提供浏览器界面，无需数据库",
        "从指定目录读取 PDF 乐谱，按 interpret_title.pdf 命名建立曲库条目",
        "可用 YAML 定义歌本、曲目与曲目使用的页序，按场次顺序翻阅",
        "按 P 打开模糊检索，在曲库中快速定位乐谱",
        "方向键或 1/2 键翻至上一页/下一页，官方说明为可编程脚踏板设计",
        "可选开启浏览器上传 PDF"
      ],
      "deployment": [
        "下载官方 release 的单二进制运行",
        "源码自行 go build（官方 README 提供构建步骤）"
      ],
      "technology_stack": [
        "Go",
        "JavaScript",
        "PDF.js"
      ],
