    {
      "id": "github:501292795",
      "name": "Frappe HR",
      "track": "open_source",
      "summary": "开源 HR 与薪资系统（GPL-3.0），其 Job Portal 子模块提供雇主自有站点的公开招聘门户：职位记录经发布开关上线，公开职位页支持搜索筛选与站内申请，提交后生成 Job Applicant 记录。",
      "homepage": "https://frappe.io/hr",
      "repository_url": "https://github.com/frappe/hrms",
      "github_repository_id": 501292795,
      "license": "GPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/frappe/hrms/license",
      "features": [
        "Job Portal 公开职位列表，按标题/描述搜索并按公司、部门、地点、雇佣类型筛选",
        "Job Opening 的 Publish on website 开关控制职位是否发布到门户",
        "公开职位详情页显示地点、部门、雇佣类型与可选薪资范围，并提供 Apply Now 站内申请",
        "公开申请 Web Form 提交后生成 Job Applicant 记录并进入招聘流程",
        "职位关闭后从公开门户下线，详情页显示 Opening closed 且不能再创建申请",
        "职位描述富文本与发布状态、申请路径由雇主在后台无代码维护",
        "站点层 Website Theme 可配置配色、字体与按钮样式以匹配雇主品牌"
      ],
      "deployment": [
        "自托管 Web 应用（Frappe 站点）",
        "Frappe Cloud 可选托管"
      ],
      "technology_stack": [
        "Python",
        "JavaScript",
        "Frappe Framework"
      ],
