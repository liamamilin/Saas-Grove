  "entries": [
    {
      "id": "github:440752086",
      "name": "Coder",
      "track": "open_source",
      "summary": "Coder 是自托管的开发工作区平台开源核心：用 Terraform 模板定义并配置可丢弃的云端开发环境，用户从 Web 控制台/CLI 创建工作区，再用自有 IDE 或 SSH 接入；仓库主线为 AGPL-3.0。",
      "homepage": "https://coder.com",
      "repository_url": "https://github.com/coder/coder",
      "github_repository_id": 440752086,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/coder/coder/license",
      "features": [
        "用 Terraform 模板定义工作区基础设施（EC2 虚拟机、Kubernetes Pod、Docker 容器等）",
        "用户从模板在自己的账号下创建工作区，团队成员获得配置与资源一致的相同环境",
        "空闲工作区自动关机，并可按计划自动启停以节省成本",
        "以模板版本为真源更新工作区：运行中的工作区先停止、重建、再启动",
        "编辑器从环境外部接入：官方提供 VS Code 扩展、JetBrains 插件，其余可用 SSH/终端连接",
        "支持 devcontainer.json：可自动发现仓库中的 Dev Containers 或用 coder_devcontainer 资源在模板内显式启动"
      ],
      "deployment": [
        "自托管服务端：安装脚本或发行版二进制启动 coder server，默认打开 http://localhost:3000 创建首个用户与 Docker 模板；生产环境可配 PostgreSQL 与外部访问 URL",
        "工作区由控制面通过 Terraform 在所选基础设施上配置；本轮未部署或运行"
      ],
      "technology_stack": [
        "Terraform",
        "Dev Containers",
        "Docker",
        "Kubernetes"
      ],
