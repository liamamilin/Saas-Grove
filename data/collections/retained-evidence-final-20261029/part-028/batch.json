    {
      "id": "github:909666349",
      "name": "ImgCompress",
      "track": "open_source",
      "summary": "ImgCompress 是可自托管的图像批处理 Web 服务：在浏览器中一次拖入多张图片、统一设置裁剪/缩放/质量/输出格式后，由容器内服务端逐图执行并打包下载结果。",
      "homepage": "https://imgcompress.karimzouine.com",
      "repository_url": "https://github.com/karimz1/imgcompress",
      "github_repository_id": 909666349,
      "license": "GPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/karimz1/imgcompress/license",
      "features": [
        "一次上传多张图片，统一设置质量、输出格式与目标体积",
        "批量压缩，README 称可跨整个照片库多核并行处理",
        "批量格式转换，支持 70+ 输入格式并可将图片批次输出为分页 PDF",
        "逐图裁剪（比例预设或自定义像素尺寸），裁剪先于缩放、格式转换与压缩执行",
        "下载单张结果或整包 ZIP"
      ],
      "deployment": [
        "单个 Docker 容器自托管，浏览器访问 Web UI",
        "提供 Docker Compose 部署示例（局域网与反向代理两种）",
        "可选 CLI 供脚本调用"
      ],
      "technology_stack": [
        "TypeScript",
        "Docker",
        "Web UI"
      ],
