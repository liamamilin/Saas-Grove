    {
      "id": "github:1398097510",
      "name": "VectorCraft",
      "track": "open_source",
      "summary": "VectorCraft 是开源矢量插画应用：用钢笔与直接选择工具逐对象绘制贝塞尔路径和形状，文档保持对象可编辑，可导入导出 SVG、PDF 与位图。除 macOS、Windows、Linux、FreeBSD 原生应用与 CLI 外，同一代码库提供浏览器内运行的 WebAssembly 版本（官方产品页在平台标注中列出 Web、设有 Launch App 入口，并发布可自行托管的 Web 构建），构成完整应用服务形态而非仅客户端/引擎。以 MIT 或 Apache-2.0 双许可发布，被许可方可任选其一；项目自述仍在 active development（自评约 65% ready for real work）。",
      "homepage": "https://getartcraft.com/apps/vectorcraft",
      "repository_url": "https://github.com/storytold/vectorcraft",
      "github_repository_id": 1398097510,
      "license": "MIT",
      "license_evidence_url": "https://raw.githubusercontent.com/storytold/vectorcraft/main/LICENSE-MIT",
      "features": [
        "钢笔与直接选择工具编辑贝塞尔锚点和控制柄",
        "路径查找器、渐变网格、封套变形与透视网格",
        "图层与实时混合，对象保持可编辑",
        "原生 .vectorcraft(JSON) 文档格式",
        "SVG/PDF 导入导出与 PNG/JPEG/WebP 导出",
        "浏览器内 WebAssembly 版与可自行托管的 Web 构建"
      ],
      "deployment": [
        "原生支持 macOS、Windows、Linux、FreeBSD",
        "浏览器内通过 WebAssembly 运行，同一 UI 与桌面版共用代码库",
        "发布静态 Web 构建，可托管在任意静态服务器"
      ],
      "technology_stack": [
        "Rust",
        "WebAssembly"
      ],
