    {
      "id": "github:465885927",
      "name": "IETF Datatracker",
      "track": "open_source",
      "summary": "IETF 的开源标准制定工作流平台（BSD-3-Clause）：以 Internet-Draft 为在制记录，组织工作组/领域与负责人，保留草案版本历史，承载 WG Last Call、评审状态与 IESG 的 Yes/No Objection/Discuss 投票、评论和立场变更，并跟踪 RFC 发布流程；Django + PostgreSQL Web 应用，可自托管。",
      "homepage": "https://datatracker.ietf.org",
      "repository_url": "https://github.com/ietf-tools/datatracker",
      "github_repository_id": 465885927,
      "license": "BSD-3-Clause",
      "license_evidence_url": "https://api.github.com/repos/ietf-tools/datatracker/license",
      "features": [
        "Internet-Draft/标准项目记录、状态与发布队列",
        "工作组、领域、Chairs 与 Area Director 组织",
        "草案多版本历史（示例 -00 至 -21）与版本比较",
        "WG Last Call、评审任务与草案状态门控",
        "IESG 投票（Yes/No Objection/Discuss/Abstain）及逐条评论",
        "Discuss 评论处置、立场变更与清除记录"
      ],
      "deployment": [
        "Docker Compose 环境（PostgreSQL + MinIO 对象存储）",
        "README 说明支持原生安装（较复杂）",
        "Django collectstatic 静态资源部署"
      ],
      "technology_stack": [
        "Python",
        "Django",
        "PostgreSQL",
        "Vue 3",
        "Docker"
      ],
      "leaf_matches": [
        {
          "slug": "standards-development-platform",
          "reason": "官方仓库与站点证明其为完整开源 Web 应用：草案页保留 -00 至 -21 版本历史，WG 页提供委员会/Chairs/章程，RFC 6174 定义 WG Last Call 与 WG Consensus 状态，ballot 页展示 IESG 对具体草案的 Yes/Discuss/No Objection 投票、评论及 (was Discuss) 处置。平台内意见处置以 IESG 投票评论与立场变更为据；WG 逐条技术意见主要在邮件列表/issue tracker，未夸大为平台内逐条登记。",
