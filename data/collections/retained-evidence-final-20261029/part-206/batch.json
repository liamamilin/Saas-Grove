  "entries": [
    {
      "id": "github:1148837454",
      "name": "OpenSPP",
      "track": "open_source",
      "summary": "OpenSPP 是开源社会保护/公共福利管理平台（基于 Odoo 19），面向政府与机构管理受益人与家庭登记、项目资格规则、参保周期、现金与实物权益、支付批次、合规与申诉；仓库整体采用 LGPL-3.0，可通过 Docker Compose 自托管为完整 Web 应用。",
      "homepage": "https://openspp.org",
      "repository_url": "https://github.com/OpenSPP/OpenSPP2",
      "github_repository_id": 1148837454,
      "license": "LGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/OpenSPP/OpenSPP2/license",
      "features": [
        "个人与家庭（group）统一登记、成员关系、证件与去重",
        "按项目配置资格规则、参保/退出与时间限定周期",
        "现金和实物权益的计算、审批与发放",
        "支付批次、发放对账与项目资金跟踪",
        "持续合规条件、通知与申诉处理"
      ],
      "deployment": [
        "Docker Compose 自托管（docker compose --profile ui up -d）",
        "Web 管理界面（Odoo 19，默认 8069 端口）"
      ],
      "technology_stack": [
        "Python",
        "Odoo 19",
        "Docker"
      ],
