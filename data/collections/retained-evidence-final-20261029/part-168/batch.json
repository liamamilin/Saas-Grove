      "id": "github:169558966",
      "name": "LibreClinica",
      "track": "open_source",
      "summary": "Open-source Java web application for electronic data capture (EDC) and clinical data management (CDM): CRF data entry, validation-triggered discrepancy notes, query/annotation resolution, reason-for-change on completed CRFs, electronic signatures, CRF-level completed/locked status, source data verification and a study audit log. LGPL-3.0 per the project's official license statement; the repository ships the GPL-3.0 base text in LICENSE and the LGPL-3.0 additional permissions in COPYING.LESSER.",
      "homepage": "https://libreclinica.org",
      "repository_url": "https://github.com/reliatec-gmbh/LibreClinica",
      "github_repository_id": 169558966,
      "license": "LGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/reliatec-gmbh/LibreClinica/license",
      "features": [
        "CRF/eCRF data entry",
        "validation checks and discrepancy notes",
        "query and annotation resolution workflow",
        "reason-for-change on completed CRFs",
        "electronic signatures",
        "CRF-level completed/locked status",
        "source data verification (SDV)",
        "study audit log",
        "study/site and role management"
      ],
      "deployment": [
        "self-hosted Java web application (Tomcat, PostgreSQL)"
      ],
      "technology_stack": [
        "Java",
        "Tomcat",
        "PostgreSQL"
      ],
