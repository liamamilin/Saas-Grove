  "entries": [
    {
      "id": "github:2196186",
      "name": "Ekylibre",
      "track": "open_source",
      "summary": "Ekylibre 是开源的农业企业资源计划/农场管理信息系统，以 Ruby on Rails 构建的自托管 Web 应用。官方文档显示其把会计（日记账、总账、科目表、VAT、固定资产）、采购（订单→收货→发票）、销售（报价/订单→发货→开票）、库存（初始库存、移动、交付、盘点）与农业生产（地块、作物活动、按 campaign 的生产、干预与成本）放在同一后台，并自动把库存、采购、销售和盘点转换为会计分录。",
      "homepage": "https://ekylibre.org/",
      "repository_url": "https://github.com/ekylibre/ekylibre",
      "github_repository_id": 2196186,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/ekylibre/ekylibre/license",
      "features": [
        "会计：日记账、会计期间、科目表、VAT、资金、固定资产、试算与总账",
        "采购：采购订单→收货→发票→付款",
        "销售：报价/订单→发货→开票→收款",
        "库存：初始库存、库存移动、交付/发货、盘点",
        "农业生产：地块与作物活动、按 campaign 的生产、干预计划与记录、生产成本",
        "库存、采购、销售与盘点自动生成会计分录",
        "栽培记录、植保登记等可追溯文档",
        "多用户角色与权限管理"
      ],
      "deployment": [
        "自托管 Web 应用",
        "Docker Compose（开发/生产）",
        "Ubuntu 原生安装"
      ],
      "technology_stack": [
        "Ruby on Rails",
        "PostgreSQL/PostGIS",
        "Redis",
        "Sidekiq",
        "Caddy"
      ],
