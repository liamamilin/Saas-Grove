    {
      "id": "github:862650765",
      "name": "tscircuit",
      "track": "open_source",
      "summary": "开源（MIT）在线 PCB 设计 Web 应用：在浏览器中用 TypeScript/React 描述电路板，放置封装、定义网络与走线，实时查看 PCB/原理图/3D 视图，并下载 Gerber、钻孔、BOM 等制造文件；仓库包含在线编辑器及本地开发/生产构建脚本。",
      "homepage": "https://tscircuit.com",
      "repository_url": "https://github.com/tscircuit/tscircuit.com",
      "github_repository_id": 862650765,
      "license": "MIT",
      "license_evidence_url": "https://raw.githubusercontent.com/tscircuit/tscircuit.com/main/LICENSE",
      "license_review": {
        "reviewer": "collector: deepseek-v4.1-flash (unit 137)",
        "source_url": "https://raw.githubusercontent.com/tscircuit/tscircuit.com/main/LICENSE",
        "spdx_id": "MIT",
        "scope": "repository",
        "rationale": "仓库根目录 LICENSE 为完整 MIT 文本，含版权声明、许可授予与免责声明；README 的 License 段亦明确写明 MIT。"
      },
      "features": [
        "在线编辑器：创建 board/module 项目，TypeScript 语法高亮、补全与类型检查",
        "板级设计：board 轮廓与尺寸，footprint 放置及自定义（platedhole、smtpad 等）",
        "连接性：net 分组网络，trace 连接元件/网络/引脚，支持铜宽、长度约束与 pcbPath 手工走线",
        "实时 PCB/原理图/3D 视图与自动布线",
        "制造输出：Gerber 铜层、钻孔、板框、BOM，在线下载 fabrication files",
        "分享与协作：项目分享、评论、版本差异与回滚（官网/README 所述）"
      ],
      "deployment": [
        "托管在线版：tscircuit.com，可直接在浏览器使用，无需安装",
        "仓库提供本地开发与生产构建：Bun 安装依赖，bun run dev 启动开发服务器，bun run build 生成生产构建",
        "开发模式使用 fake API；完整生产后端/注册表部署未在本次验证"
      ],
      "technology_stack": [
        "React",
        "TypeScript",
        "Vite",
        "Tailwind CSS",
        "Bun"
      ],
