      "id": "github:8495499",
      "name": "CiviCRM",
      "track": "open_source",
      "summary": "CiviCRM 是面向非营利组织的开源 CRM；其 CiviCase 组件在联系人记录上开立并管理个案，分配个案角色与工作人员，以活动时间线记录服务与沟通，并通过状态变更和审计报告跟踪个案进展与结案。",
      "homepage": "https://civicrm.org/",
      "repository_url": "https://github.com/civicrm/civicrm-core",
      "github_repository_id": 8495499,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/civicrm/civicrm-core/license",
      "features": [
        "客户联系人记录与新建联系人",
        "个案（Case）与个案类型",
        "个案角色及工作人员分配",
        "个案活动与时间线",
        "个案状态变更（Ongoing/Resolved）并生成变更活动记录",
        "个案附件与邮件通信归档",
        "个案仪表盘、搜索与审计报告"
      ],
      "deployment": [
        "自托管",
        "可作为独立 PHP Web 应用运行，也可作为 Backdrop/Drupal/Joomla/WordPress 模块运行"
      ],
