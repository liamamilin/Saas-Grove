    {
      "id": "github:847006986",
      "name": "Openlane",
      "track": "open_source",
      "summary": "开源（Apache-2.0）合规自动化平台：compliance management 下含 policies、controls、evidence、programs 四类对象，每类对象均有编辑、审批、评论与完整历史；政策与程序在平台文档中为独立文档类型，支持自动版本化、审批后发布、向人员发送签署请求（签署绑定所读修订版本）并留存签署时间与来源，另可映射 SOC 2、ISO 27001、NIST 800-53 等框架并授予审计员只读访问。开源核心包括 core 服务端/编排服务与 openlane-ui Web 控制台（均为 Apache-2.0）；SaaS/云服务按商业条款提供，logo 与商标不在 Apache-2.0 范围内。",
      "homepage": "https://theopenlane.io/",
      "repository_url": "https://github.com/theopenlane/core",
      "github_repository_id": 847006986,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/theopenlane/core/license",
      "license_review": {
        "reviewer": "opencode-collector-u074-correction-round",
        "source_url": "https://api.github.com/repos/theopenlane/core/license",
        "spdx_id": "Apache-2.0",
        "scope": "community_core",
        "rationale": "core 仓库 LICENSE 快照 174c480c… 为 GitHub license API 返回的 Apache-2.0 完整正文（含 Definitions 与 Grant of Patent License 等条款）；控制台 openlane-ui 的 LICENSE 快照 1a81a3ff… 同为 Apache-2.0 完整正文。README Licensing 段声明 SaaS/云服务按商业条款、logo 与商标不在 Apache-2.0 内，故仅对开源核心范围作许可声明。"
      },
      "features": [
        "policies、controls、evidence、programs 四类对象均有 editors、approvals、comments 与 full history",
        "政策与程序作为独立文档类型，支持模板/AI 起草、导入与 Drive/OneDrive 同步",
        "自动版本化、任意两版本对比、审批后发布，历史修订保留",
        "向人员发送政策签署请求，签署绑定所读修订版本并记录时间、邮箱、IP 与浏览器",
        "政策映射到控件与 SOC 2、ISO 27001、NIST 800-53 等框架，审计员只读访问"
      ],
      "deployment": [
        "Docker 自托管开发/运行栈",
        "GHCR 容器镜像自托管"
      ],
      "technology_stack": [
        "Go",
        "PostgreSQL",
        "Redis",
        "GraphQL",
        "React",
        "TypeScript",
        "Docker"
      ],
