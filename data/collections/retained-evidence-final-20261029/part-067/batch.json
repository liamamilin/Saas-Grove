    {
      "id": "github:439861",
      "name": "Moodle",
      "track": "open_source",
      "summary": "Moodle LMS 是 GPL-3.0 开源、自托管的 Web 学习管理系统：组织自建课程，用站点级 cohort 维护组织内学员分组，并以手动注册或 cohort 同步把学习者与课程关联（含注册有效期与到期动作），再按学员记录活动完成、课程完成进度与完成报告。本条只依据开源核心仓库与官方开发文档，不以商业 Moodle Workplace 资料作为证据。",
      "homepage": "https://moodle.com",
      "repository_url": "https://github.com/moodle/moodle",
      "github_repository_id": 439861,
      "license": "GPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/moodle/moodle/license",
      "features": [
        "课程与结构化学习内容管理",
        "站点级 cohort 维护组织内学员分组",
        "手动注册：有权限的管理者/教师把学习者加入课程",
        "cohort 同步注册：cohort 成员与课程参与者保持同步",
        "注册有效期、到期通知与到期动作",
        "活动完成规则（浏览/评分/自定义规则）",
        "按学员计算课程完成百分比",
        "课程完成报告与学员完成日期记录"
      ],
      "deployment": [
        "自托管 Web 应用",
        "官方仓库可下载自行部署",
        "需要 Web 服务器运行 PHP 应用"
      ],
      "technology_stack": [
        "PHP",
        "Web application"
      ],
