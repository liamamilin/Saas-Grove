      "leaf_matches": [
        {
          "slug": "podcast-editing-application",
          "reason": "官方 README 与站点写明以 show 与 episode 为持久对象，每个 episode 由 segments 组成：可录制或在浏览器上传片段、插入库内 intro/bumper、裁剪/分割/去静音/重排，最终合成成品单集音频并生成 RSS；同时提供转录、多轨远程录音与托管导出。服务形态为单进程自托管 Web 应用（Fastify API + React 前端，Docker/Terraform 部署）。覆盖单集工作单元、语音优先捕获与编辑、面向发布的成品导出三项核心。",
          "source_urls": [
            "https://harborfm.com/",
            "https://raw.githubusercontent.com/LoganRickert/harborfm/main/README.md"
          ]
        }
      ],
      "features": [
        "show 与 episode 持久化管理，含草稿/排程/已发布状态与单集元数据",
        "episode 由 segments 组装：浏览器录音或上传，插入库内 intro/outro/bumper",
        "片段裁剪、分割、去静音、噪声抑制与重排，ffmpeg 合成成品单集音频",
        "远程嘉宾多轨录音（可选 WebRTC 服务）与转录（可选 Whisper ASR）",
        "生成 RSS 与公开节目页，支持 S3/FTP/SFTP/WebDAV 等目标导出"
      ],
      "deployment": [
        "Docker 单容器或 Docker Compose + Caddy/nginx",
        "Terraform 部署到 AWS EC2 或 Vultr",
        "Node.js 22+ 本地/PM2 运行，SQLite 持久化，需 ffmpeg 与 audiowaveform"
      ],
      "technology_stack": [
        "Node.js / Fastify",
        "React / Vite / TanStack Query",
        "SQLite (better-sqlite3)",
        "ffmpeg / ffprobe",
        "可选 mediasoup WebRTC 服务"
      ],
