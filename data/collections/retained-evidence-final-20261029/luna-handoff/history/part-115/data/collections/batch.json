      "leaf_matches": [
        {
          "slug": "capacity-management",
          "reason": "官方 User Reference 正文写明 Trending 报表给出 datastore 容量与 host CPU/内存的投影，Tenants 配额报表列出 total/in use/allocated/available，Optimization 报表覆盖 CPU、内存、磁盘的可优化领域与潜在节省，并要求开启 Capacity and Utilization 采集；这些对应容量状态、容量风险（前瞻投影）与容量决策（回收/调整建议）。文档把 Optimization 定位为报表，未证明自动执行优化动作，故不写自动闭环。",
          "source_urls": [
            "https://www.manageiq.org/docs/reference/latest/monitoring_alerts_and_reporting/index.html",
            "https://raw.githubusercontent.com/ManageIQ/manageiq/master/README.md"
          ]
        }
