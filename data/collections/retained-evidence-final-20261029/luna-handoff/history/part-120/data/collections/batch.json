      "name": "Traefik",
      "track": "open_source",
      "summary": "Traefik is an open-source HTTP reverse proxy and load balancer that dynamically configures HTTP routing services, backend server pools, load-balancing strategies, health checks and sticky sessions.",
      "homepage": "https://traefik.io",
      "repository_url": "https://github.com/traefik/traefik",
      "github_repository_id": 42408804,
      "license": "MIT",
      "license_evidence_url": "https://raw.githubusercontent.com/traefik/traefik/master/LICENSE.md",
      "features": [
        "HTTP and TCP/UDP routing with dynamically updated configuration",
        "Backend server pools with weighted round robin, power-of-two-choices, highest-random-weight and least-time strategies",
        "Active and passive health checks that remove unhealthy servers from rotation",
        "Sticky sessions and a REST API plus web dashboard"
      ],
      "deployment": [
        "Single binary or official Docker image; integrates with Docker, Kubernetes and other providers"
      ],
      "technology_stack": [
        "Go"
