      },
      "features": [
        "校友登记：注册必填院系与毕业批次，导师或协调员审核后生效",
        "校友目录：按批次、院系、角色和公司筛选检索",
        "活动管理：协调员/管理员创建活动，校友/导师/协调员/管理员可报名并记录 RSVP",
        "导师辅导：学生发起申请，导师按容量上限审批并维护 active_mentees",
        "沟通与公告：私聊、批次群聊、按批次广播及系统公告",
        "就业与实习：职位发布、两级审核与申请跟踪",
        "分析看板：院系就业率与 platform 级统计"
      ],
      "deployment": [
        "自托管 Django + PostgreSQL Web 应用，前端为静态 SPA",
        "按 README 执行 npm run setup:backend、数据库迁移与 npm run dev 启动前端和 API"
      ],
      "technology_stack": [
        "Python 3.11+",
        "Django 5.2",
        "Django REST Framework",
        "SimpleJWT",
        "PostgreSQL 14+",
        "JavaScript/HTML/CSS"
      ],
