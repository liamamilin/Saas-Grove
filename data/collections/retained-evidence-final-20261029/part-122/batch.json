  "entries": [
    {
      "id": "github:1007555070",
      "name": "CertMate",
      "track": "open_source",
      "summary": "自托管的 TLS 证书生命周期管理 Web 应用：集中签发与续订证书，发现并盘点未纳管证书，按有效期与续订规则自动续订，并通过部署钩子把新证书交付到服务端点。",
      "homepage": "https://www.certmate.org/",
      "repository_url": "https://github.com/fabriziosalmi/certmate",
      "github_repository_id": 1007555070,
      "license": "MIT",
      "license_evidence_url": "https://raw.githubusercontent.com/fabriziosalmi/certmate/main/LICENSE",
      "features": [
        "在自托管 Web 界面与 REST API 中集中创建、查看和管理 TLS 证书",
        "从 Let's Encrypt、ZeroSSL、Google Trust Services、DigiCert、Sectigo 等公共 CA 或私有 CA 签发证书",
        "按 renews_at 与 ARI 在到期前自动续订，续订生成新证书而非延长旧证书",
        "通过部署钩子、Webhook 与部署探针把续订后的证书交付到服务位置并核验",
        "通过探针与证书透明度日志发现未纳管证书，维护签发者、到期时间和部署位置清单",
        "创建、续订、吊销客户端证书，并提供 OCSP 与 CRL"
      ],
      "deployment": [
        "Docker Compose 单实例部署，Web 进程内含续订调度器",
        "Linux systemd 安装",
        "Kubernetes Helm chart（按设计限制为单副本）"
      ],
      "technology_stack": [
        "Python 3.12",
        "Docker",
        "Kubernetes/Helm",
        "REST API"
      ],
