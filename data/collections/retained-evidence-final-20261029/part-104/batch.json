  "entries": [
    {
      "id": "github:460571962",
      "name": "Konveyor Hub",
      "track": "open_source",
      "summary": "Konveyor 应用现代化平台的核心应用服务（Hub）：以 Web 控制台维护遗留应用清单与依赖，执行问卷式评估和源码/二进制静态分析，规划迁移波次并编排分析任务；配套 tackle2-ui 与 Konveyor Operator 自托管部署。",
      "homepage": "https://konveyor.io/",
      "repository_url": "https://github.com/konveyor/tackle2-hub",
      "github_repository_id": 460571962,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/konveyor/tackle2-hub/license",
      "features": [
        "现有应用清单、业务服务关联与依赖建模",
        "问卷式评估，输出迁移风险与采用计划",
        "源码/二进制静态分析（集成 Windup/analyzer）并生成问题清单与工作量估计",
        "迁移波次规划与迁移工作排序",
        "Hub task manager 编排分析任务并跟踪任务结果",
        "配合 Konveyor AI 按分析结果生成并应用代码修复建议"
      ],
      "deployment": [
        "Kubernetes/OpenShift 上通过 Konveyor Operator（OLM）自托管部署",
        "Hub 服务以容器镜像发布（quay.io/konveyor/tackle2-hub）",
        "Web UI 以容器化 Node.js 应用运行并代理 Hub API"
      ],
      "technology_stack": [
        "Go（Hub 服务端）",
        "React + PatternFly（Web UI）",
        "Kubernetes/OpenShift",
        "REST API",
        "容器镜像"
      ],
