  "entries": [
    {
      "id": "github:21491087",
      "name": "OpenUDS",
      "track": "open_source",
      "summary": "开源多平台连接代理，提供自托管 Web 管理门户与 REST API，将 Windows/Linux 桌面和 RemoteApp 应用作为命名服务/服务池发布，按用户和组授予服务池访问，并通过 RDP/HTML5/SPICE 等传输建立远程交互会话；后端管理多种虚拟化与 RDS 主机群。",
      "homepage": "https://github.com/VirtualCable/openuds",
      "repository_url": "https://github.com/VirtualCable/openuds",
      "github_repository_id": 21491087,
      "license": "BSD-3-Clause",
      "license_evidence_url": "https://raw.githubusercontent.com/VirtualCable/openuds/master/LICENSE",
      "features": [
        "服务与服务池发布：ServiceItem/ServicePoolItem 提供服务命名、可见性与服务池配置，ServicePoolGroupItem 组织目录，PublicationItem 记录发布状态",
        "按用户/组授权：组和用户均可关联可访问的 service pool，服务池带 permission 权限位",
        "远程应用与桌面会话：RemoteAppService 定义 application_path，RemoteSessionService 面向 RDS 服务器，TransportItem 提供 RDP/HTML5/SPICE 等传输",
        "受管主机群：/servers/groups 与 /servers/groups/{uuid}/servers 管理服务器组及成员，服务池配置 initial_srvs/max_srvs",
        "多虚拟化平台服务类型：OpenStack、oVirt、Proxmox、VMware、Xen、Hyper-V、Azure、AWS 等"
      ],
      "deployment": [
        "自托管连接代理（Web 门户 + REST API）",
        "Python 3.11 运行环境",
        "多仓库/子模块部署（master 分支）"
      ],
      "technology_stack": [
        "Python 3.11",
        "REST/OpenAPI",
        "RDS / RemoteApp",
        "多虚拟化平台（OpenStack/oVirt/Proxmox/VMware/Xen 等）"
      ],
