      "name": "e-petitions",
      "track": "open_source",
      "summary": "英国政府与议会官方电子请愿服务的开源完整 Web 应用：请愿经支持者提交并审核后发布，限时收集署名；达到 10,000 署名由政府在请愿页公开回应，达到 100,000 署名由请愿委员会考虑安排议会辩论，处置结果与时间线留存在同一请愿记录中。",
      "homepage": "https://petition.parliament.uk",
      "repository_url": "https://github.com/alphagov/e-petitions",
      "github_repository_id": 4434819,
      "license": "MIT",
      "license_evidence_url": "https://raw.githubusercontent.com/alphagov/e-petitions/master/LICENCE.txt",
      "features": [
        "请愿起草与提交，需 5 名支持者后进入审核",
        "工作人员审核、拒绝并发布合规请愿",
        "发布后 6 个月限时收集署名",
        "10,000 署名触发政府回应，回应正文与发布日期显示在请愿页",
        "100,000 署名由请愿委员会考虑辩论，辩论记录链接回请愿页",
        "请愿进度时间线公开记录发布、回应、辩论与关闭",
        "内置审核后台与角色权限"
      ],
      "deployment": [
        "Docker Compose 自托管",
        "Ruby on Rails + PostgreSQL"
      ],
      "technology_stack": [
        "Ruby on Rails",
        "PostgreSQL",
        "Docker"
      ],
