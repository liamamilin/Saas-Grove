      "id": "github:27911088",
      "name": "Apache NiFi",
      "track": "open_source",
      "summary": "Apache NiFi 是开源的数据流（dataflow）平台：浏览器界面上设计、控制、反馈与监控 flow，processor 负责数据的路由、转换和系统间中介，具备 FlowFile 属性与内容、provenance 端到端血缘、模板复用、背压控制与运行时修改 flow 配置；官方定位为可自托管、可保障投递的数据处理与分发系统。",
      "homepage": "https://nifi.apache.org/",
      "repository_url": "https://github.com/apache/nifi",
      "github_repository_id": 27911088,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/apache/nifi/license",
      "features": [
        "浏览器界面设计、控制与监控 flow",
        "processor 执行数据路由、转换与系统间中介",
        "数据 provenance 端到端血缘追踪",
        "模板复用与运行时修改 flow 配置",
        "背压控制与容错、保障投递",
        "多租户授权与 TLS/SSH 加密通信"
      ],
      "deployment": [
        "自托管（Java 应用服务）",
        "浏览器访问的 Web UI"
      ],
      "technology_stack": [
        "Java"
      ],
