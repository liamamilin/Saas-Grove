    {
      "id": "github:210579021",
      "name": "Apache Hop",
      "track": "open_source",
      "summary": "Apache Hop 是开源的数据集成与编排平台：在画布上设计 pipeline/workflow，内置 250+ pipeline transforms、80+ workflow actions 和 40+ 数据库方言；同一 pipeline 可运行在本地引擎、远程 Hop Server、Spark，或经 Apache Beam 运行于 Flink/Dataflow。除桌面 GUI 外，官方还提供浏览器版 Hop Web（Tomcat 部署，Docker 镜像 apache/hop-web，访问 /ui）与 Hop REST Web 应用（hop-rest WAR，/hop/api/v1 元数据与执行服务），构成可自托管的完整应用服务；Projects/Environments 支持从开发切换到生产，凭据不写入 pipeline。",
      "homepage": "https://hop.apache.org",
      "repository_url": "https://github.com/apache/hop",
      "github_repository_id": 210579021,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/apache/hop/license",
      "features": [
        "可视化 pipeline/workflow 设计（桌面 GUI 与浏览器版 Hop Web）",
        "250+ pipeline transforms 与 80+ workflow actions",
        "本地、Hop Server、Spark、Flink/Dataflow 多运行时",
        "Hop REST Web 应用提供元数据与执行 API",
        "Projects 与 Environments 环境切换",
        "数据库连接凭据不写入 pipeline"
      ],
      "deployment": [
        "Hop Web（Tomcat / Docker apache/hop-web）",
        "Hop Server",
        "本地引擎",
        "Apache Spark",
        "Flink/Dataflow (Apache Beam)",
        "hop-rest WAR"
      ],
      "technology_stack": [
        "Java",
        "Apache Tomcat",
        "Apache Beam",
        "Docker"
      ],
