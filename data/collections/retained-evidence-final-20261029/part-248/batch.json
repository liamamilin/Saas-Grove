    {
      "id": "github:598537999",
      "name": "Gym Management System (Laravel)",
      "track": "open_source",
      "summary": "MIT 许可、可自托管的 Laravel Web 健身会籍管理应用，面向健身房运营方后台。会员档案与计划目录之外，以会员×计划的订阅记录保存起止日期和 ongoing/expired/renewed/cancelled 状态，并由发票、收款和欠款状态管理会费；提供续费、取消订阅和到期自动置为 expired 的命令。采用预付期限计划，不依赖自动定期扣款。",
      "homepage": "https://github.com/zorenleolumosbog/gym-management-system-in-laravel",
      "repository_url": "https://github.com/zorenleolumosbog/gym-management-system-in-laravel",
      "github_repository_id": 598537999,
      "license": "MIT",
      "license_evidence_url": "https://raw.githubusercontent.com/zorenleolumosbog/gym-management-system-in-laravel/main/LICENSE.md",
      "license_review": {
        "reviewer": "opencode-go/deepseek-v4.1-flash",
