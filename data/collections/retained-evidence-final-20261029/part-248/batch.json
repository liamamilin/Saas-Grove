        "spdx_id": "MIT",
        "scope": "repository",
        "rationale": "仓库 LICENSE.md 保存完整 MIT 许可证正文，包含授权、版权声明与免责声明，并与 README 的 MIT 表述一致；按整仓库范围记录。"
      },
      "features": [
        "会员档案与会员编码",
        "会员计划目录：名称、天数、金额、所属服务",
        "会员×计划订阅：起止日期、续费标记、ongoing/expired/renewed/cancelled 状态",
        "发票与收款：总额、待收金额、未付/部分付/已付/超额支付状态",
        "订阅续费与取消操作",
        "定时命令将会员到期订阅置为 expired"
      ],
      "deployment": [
        "自托管 PHP/Laravel Web 应用",
        "MySQL 数据库",
        "需配置 Web 服务器并运行 set:expired 定时任务"
      ],
      "technology_stack": [
        "PHP",
        "Laravel 5.1",
        "MySQL",
        "Blade"
      ],
