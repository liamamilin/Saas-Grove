          ]
        }
      ],
      "features": [
        "identity and entitlement ingestion from CSV, LDAP/AD, Microsoft Entra ID and SQL sources",
        "entitlement catalog with privilege classification",
        "scoped certification campaigns with approve/revoke reviewer decisions",
        "segregation-of-duties checks",
        "decision-triggered remediation with email, webhook and directory write-back",
        "SCIM provisioning",
        "risk scoring and campaign reports",
        "append-only hash-chained audit trail"
      ],
      "deployment": [
        "self-hosted Docker Compose stack: nginx load balancer, three stateless FastAPI replicas, PostgreSQL 16, and a one-shot Alembic migration container"
      ],
      "technology_stack": [
        "Python 3.12 / FastAPI",
        "SQLAlchemy 2.x / Alembic",
        "PostgreSQL 16",
        "React 18 / TypeScript / Vite",
        "nginx",
        "Docker"
      ],
