    {
      "id": "github:1432012861",
      "name": "Campus Tap",
      "track": "open_source",
      "summary": "Campus Tap 是面向高校的开源 NFC 校园卡系统：每名学生一张在用 NTAG 424 DNA 卡，服务端将卡按学号绑定，统一处理课堂考勤、食堂餐次和校园商户消费，逐次按余额、限额、卡状态与重复刷卡规则判定并记录追加式台账；管理员页面可停用/恢复和充值调账。代码采用 MIT 许可，以 FastAPI + SQLite 自托管，实体读卡器为可选的硬件端。",
      "homepage": "https://github.com/kartikeyy12/campus-tap",
      "repository_url": "https://github.com/kartikeyy12/campus-tap",
      "github_repository_id": 1432012861,
      "license": "MIT",
      "license_evidence_url": "https://raw.githubusercontent.com/kartikeyy12/campus-tap/main/LICENSE",
      "license_review": {
        "reviewer": "opencode-go/deepseek-v4.1-flash",
        "source_url": "https://raw.githubusercontent.com/kartikeyy12/campus-tap/main/LICENSE",
        "spdx_id": "MIT",
        "scope": "repository",
        "rationale": "逐字核对仓库根 LICENSE 全文（1065 字节），包含 MIT 授权条款与免责声明；README 亦明确代码为 MIT，覆盖本仓库代码。"
      },
      "features": [
        "一名学生一张 NTAG 424 DNA NFC 卡，按学号/UID 绑定到已识别持卡人",
        "同一张卡用于课堂考勤、食堂餐次计次和校园商户余额支付",
        "每次刷卡由服务端验证签名 URL，并按余额、单笔/每日限额、卡状态与重复刷卡规则逐次判定",
        "每名学生仅允许一张在用卡，停用立即生效、恢复需学生 PIN；台账与事件追加写入且禁止改写",
        "保存消费与考勤台账，拒绝重复刷卡、余额不足、未登记卡和篡改刷卡",
        "管理员控制台支持发卡、停用/恢复、充值调账与规则配置，学生和商户各有自助页面"
      ],
      "deployment": [
        "自托管 FastAPI 服务与 SQLite 数据库，提供 admin、student、vendor 三类网页",
        "可选 ESP32 + PN532 读卡器固件；无硬件时可用软件模拟刷卡运行完整演示"
      ],
      "technology_stack": [
        "Python / FastAPI",
        "SQLite",
        "NTAG 424 DNA（SUN/SDM）",
        "ESP32 / PN532 固件",
        "HTML / JavaScript 管理、学生与商户页面"
      ],
