      "leaf_matches": [
        {
          "slug": "audio-restoration-application",
          "reason": "官方算法文档以 Auphonic Web Service 的上传处理流程描述修复循环：先分析并把信号分段分类为语音、音乐、不同背景噪声与静音，再用 Static/Dynamic Denoiser 或 Speech Isolation 等专用处理器抑制噪声、交流声与混响，Classic Denoiser 会为各段提取 noise print 并检测 50/60 Hz 交流声及谐波；官方还给出先不 leveling、不 gate、不压缩的使用纪律以保住噪声指纹，并提供移除量调节与修复前后试听示例，符合损伤分类、专用处理器、保留节目素材并输出修复音频的定义。",
          "source_urls": [
            "https://auphonic.com/features",
            "https://auphonic.com/help/algorithms/singletrack.html"
          ]
        }
      ],
      "verification_status": "official_sources_reviewed",
      "runtime_tested": false
    },
    {
      "id": "github:1001427463",
      "name": "HarmonyRestorer",
      "track": "open_source",
      "summary": "开源 AI 音频修复 Web 应用：FastAPI 后端加 React 前端，上传带噪录音后由 OpGAN 或 UVR 去噪引擎处理，提供任务状态、波形与修复前后 A/B 对比，并可下载修复结果；支持 Docker 自托管。",
      "homepage": "https://harmonyrestorer.online",
      "repository_url": "https://github.com/jacob7choi-xyz/harmonyrestorer-v1",
      "github_repository_id": 1001427463,
      "license": "MIT",
