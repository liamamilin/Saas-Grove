  "entries": [
    {
      "id": "github:27965134",
      "name": "OPNsense",
      "track": "open_source",
      "summary": "开源、可自托管的完整防火墙与路由平台：以状态化包过滤对经过本机的流量按有序规则逐会话放行、阻断或拒绝，默认拒绝未匹配流量，并支持 NAT、接口/浮动规则与 Web GUI/API 策略管理。威胁防护引擎为可选附加能力，不是本条目的匹配依据。",
      "homepage": "https://opnsense.org/",
      "repository_url": "https://github.com/opnsense/core",
      "github_repository_id": 27965134,
      "license": "BSD-2-Clause",
      "license_evidence_url": "https://api.github.com/repos/opnsense/core/license",
      "features": [
        "状态化包过滤与会话状态跟踪（默认启用）",
        "有序规则与 quick 首次匹配；未匹配时由默认拒绝规则丢弃流量",
        "Pass/Block/Reject 规则动作",
        "按入方向过滤，支持接口与浮动规则",
        "NAT 规则在过滤规则之前处理",
        "通过 Web GUI 与 API 管理策略和系统配置"
      ],
      "deployment": [
        "作为自托管防火墙平台安装于硬件或虚拟机，部署在网络区域边界或分段点并内联流量",
        "通过 Web GUI 或 API 管理防火墙规则与系统配置",
        "可用 OPNsense tools 从源码构建/升级软件包"
      ],
      "technology_stack": [
        "FreeBSD",
        "pf（状态化包过滤器）",
        "PHP"
      ],
