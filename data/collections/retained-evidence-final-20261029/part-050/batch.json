  "entries": [
    {
      "id": "github:133735379",
      "name": "OpenCue",
      "track": "open_source",
      "summary": "开源渲染管理系统：以 Cuebot 中央服务接收制作工具提交的渲染作业，拆分为帧级任务，调度到渲染机群槽位并跟踪至完成，提供 CueWeb 浏览器界面与 REST 网关。",
      "homepage": "https://opencue.io",
      "repository_url": "https://github.com/AcademySoftwareFoundation/OpenCue",
      "github_repository_id": 133735379,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/AcademySoftwareFoundation/OpenCue/license",
      "features": [
        "作业提交到可配置调度队列，并拆分为独立任务/帧级单元",
        "Cuebot 中央管理服务器统一管理作业提交、向渲染节点分发工作并响应 API 请求",
        "主机可切分为多个 proc 槽位，各自保留 CPU 核与内存；支持标签把特定作业分配到特定机型",
        "按帧跟踪状态：FRAME_STARTED/FRAME_COMPLETED/FRAME_FAILED/FRAME_RETRIED，失败帧自动重试，全部帧完成后 JOB_FINISHED 关闭作业",
        "OpenCueWeb 浏览器界面提供作业/层/帧监视与重试、终止等操作，REST Gateway 提供 HTTP 接口",
        "管理器自身不计算图像，由 Katana、RenderMan、Arnold 等第三方渲染器在渲染节点执行"
      ],
      "deployment": [
        "自托管：Cuebot 服务端 + PostgreSQL 数据库 + 共享文件系统（常为 NFS），单一 Cuebot 实例供全部用户共享",
        "渲染节点运行 RQD（Python 或 Rust 实现）注册到 Cuebot 并上报结果",
        "随附 Docker Compose、Docker 镜像与 Kubernetes 部署路径；CueWeb 可用 Docker/反向代理部署"
      ],
      "technology_stack": [
        "Java",
        "Python",
        "Rust",
        "PostgreSQL",
        "gRPC",
        "Next.js",
        "React"
      ],
