    {
      "id": "github:1331339595",
      "name": "DeedBox",
      "track": "open_source",
      "summary": "DeedBox 是面向律所的开源实务管理系统（整仓 AGPL-3.0，无独立社区版，Next.js + PostgreSQL，自托管），涵盖事项、当事人、时间计费、账单与信托资金管理。冲突审查是其内置的完整业务子模块：以当事人名称、事项、收案与历史检查快照构建关系索引，执行模糊与语音匹配检索，永久留存检索快照与命中，登记册记录处置结果；在执业领域或事务所开启冲突检查要求时，开立事项须提供已处置、未附加他处的检查。",
      "homepage": "https://github.com/deedbox-maintainers/deedbox-app",
      "repository_url": "https://github.com/deedbox-maintainers/deedbox-app",
      "github_repository_id": 1331339595,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/deedbox-maintainers/deedbox-app/license",
      "features": [
        "事项与当事人管理",
        "时间与计费",
        "账单与信用票据",
        "信托资金与对账",
        "工作流与关键日期",
        "冲突检索：以当事人名称索引、语音匹配与三元组相似度检索当事人、事项、收案及历史检查快照",
        "检索快照不可变留存，登记册可回看每次检查的检索词、执行人、时间、附加对象与处置结果",
        "冲突处置：每次检查仅记录一条结论（未发现冲突 / 发现冲突并已采取措施），选择“已采取措施”时必须填写处置说明",
        "准入控制（可配置）：执业领域标记或事务所设置开启后，开立事项须提供已记录处置且尚未附加的冲突检查"
      ],
      "deployment": [
        "自托管 Next.js 服务（Node.js 20+）",
        "PostgreSQL 及 btree_gist、fuzzystrmatch、pg_trgm、unaccent 扩展"
      ],
      "technology_stack": [
        "TypeScript",
        "Next.js",
        "PostgreSQL"
      ],
