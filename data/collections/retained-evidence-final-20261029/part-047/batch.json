    {
      "id": "github:584016836",
      "name": "Chili3D",
      "track": "open_source",
      "summary": "浏览器中运行的开源三维 CAD 应用：在交互式 3D 视口中绘制草图、创建实体并通过布尔、拉伸、倒角等操作编辑几何，以文档形式创建、打开与保存模型，并可导入导出 STEP/IGES/BREP/STL。",
      "homepage": "https://chili3d.com",
      "repository_url": "https://github.com/xiangechen/chili3d",
      "github_repository_id": 584016836,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/xiangechen/chili3d/license",
      "features": [
        "3D 视口带相机控制，可保存并召回相机位置",
        "2D 草图工具绘制直线、圆弧、圆、矩形、多边形与贝塞尔曲线",
        "拉伸、旋转、扫掠、放样及布尔并/差/交等实体建模操作",
        "对象吸附到点/边/面等工作平面与几何特征，用于精确编辑",
        "倒角、圆角、修剪、打断、分割、缝合、子形状操作与特征移除",
        "创建、打开与保存文档，完整撤销/重做与事务历史",
        "STEP、IGES、BREP、STL 导入导出"
      ],
      "deployment": [
        "公共 Web 应用 chili3d.com（浏览器直接使用，无需本地安装）",
        "自托管：npm 构建后由静态服务提供，或用仓库内 docker compose 启动"
      ],
      "technology_stack": [
        "TypeScript",
        "Three.js",
        "OpenCascade (OCCT) via WebAssembly",
        "IndexedDB"
      ],
