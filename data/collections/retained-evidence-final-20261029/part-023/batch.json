    {
      "id": "github:21611548",
      "name": "SVG-Edit",
      "track": "open_source",
      "summary": "SVG-Edit 是浏览器内运行的完整 SVG 矢量图形编辑器：在 SVG 画布上绘制与编辑路径、形状和文本对象，可打开既有 SVG 文档，并以标准 SVG 文件保存输出。提供在线构建入口，也可自建静态站点部署。",
      "homepage": "https://svg-edit.github.io/svgedit/",
      "repository_url": "https://github.com/SVG-Edit/svgedit",
      "github_repository_id": 21611548,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/SVG-Edit/svgedit/license",
      "features": [
        "浏览器内 SVG 画布绘制路径、形状与文本",
        "路径节点独立编辑、旋转与缩放",
        "对象选择、层级与属性调整",
        "通过默认 opensave 扩展打开既有或预载的 SVG 文档",
        "将画布序列化为标准 SVG（image/svg+xml）并保存为 .svg 文件"
      ],
      "deployment": [
        "纯浏览器运行，无需安装",
        "可将构建产物部署到自有 Web 服务器",
        "官方 README 提供 Netlify 在线构建入口",
        "提供 npm 包 @svgedit/svgcanvas 供嵌入"
      ],
      "technology_stack": [
        "JavaScript",
        "SVG",
        "Web Components"
      ],
