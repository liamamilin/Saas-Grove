    {
      "id": "github:4767074",
      "name": "Method Draw",
      "track": "open_source",
      "summary": "Method Draw 是面向 Web 的简化开源 SVG 矢量绘图应用：在浏览器画布上用路径、形状与文本工具绘制并直接调整对象几何，可打开既有 SVG 文档、保存为标准 SVG 文件并导出 PNG。提供在线实例，也可构建为静态站点自托管。",
      "homepage": "https://editor.method.ac/",
      "repository_url": "https://github.com/methodofaction/Method-Draw",
      "github_repository_id": 4767074,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/methodofaction/Method-Draw/license",
      "features": [
        "浏览器内绘制路径、矩形、椭圆、直线与文本对象",
        "对象选择、编组、层级与路径节点编辑",
        "Open SVG... 载入既有 SVG 文档",
        "Save Image... 序列化为标准 SVG 并下载 .svg 文件",
        "Export as PNG 光栅导出",
        "撤销/重做、网格吸附与标尺"
      ],
      "deployment": [
        "在线实例 editor.method.ac 直接使用，无需注册",
        "克隆后以静态服务器托管 src 目录",
        "npm install 后 gulp build，将 dist 部署到自有静态服务器"
      ],
      "technology_stack": [
        "JavaScript",
        "SVG",
        "HTML5 Canvas"
      ],
