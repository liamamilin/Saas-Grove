    {
      "id": "github:1174129021",
      "name": "Legal Training Tracker",
      "track": "open_source",
      "summary": "Legal Training Tracker 是 MIT 许可的自托管法律培训与 CLE 继续教育管理 Web 应用（FastAPI 后端 + Streamlit 前端）。它按 12 个美国州维护 CLE 报告周期、总学分及伦理、技能、多元化、网络安全等专项学分要求，按用户和司法辖区记录学分活动（提供方、学分类型、学分数、完成日期、证书编号、核验状态），并按辖区报告周期长度生成截至当日的滚动窗口计算个人合规状态；另提供培训课程、测验、能力评估和团队合规报告。",
      "homepage": "https://github.com/noamrazbuilds/legal-training-tracker",
      "repository_url": "https://github.com/noamrazbuilds/legal-training-tracker",
      "github_repository_id": 1174129021,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/noamrazbuilds/legal-training-tracker/license",
      "features": [
        "按 12 个美国州维护 CLE 报告周期、总学分与伦理/技能/多元化/网络安全专项学分要求",
        "按用户和司法辖区记录 CLE 学分活动，含提供方、学分类型、完成日期、证书编号与核验状态",
        "按辖区报告周期长度生成截至当日的滚动窗口，并计算个人 CLE 合规状态（compliant / at_risk / non_compliant）",
        "管理员和经理可查看指定用户的学分记录与合规状态",
        "admin / manager / member 角色权限控制",
        "团队合规汇总、培训完成率与测验表现报告",
        "内置培训课程库、自动评分测验、能力评估与发展目标"
      ],
      "deployment": [
        "本地自托管：./start.sh 或 start.bat 启动并在浏览器打开",
        "Docker Compose（前端 8501，API 8000）",
        "提供 Railway 部署配置"
      ],
      "technology_stack": [
        "Python 3.11+",
        "FastAPI 与 Pydantic v2",
        "SQLAlchemy 2.0",
        "Streamlit",
        "SQLite（原型数据库，设计可迁移 PostgreSQL）",
        "bcrypt 密码哈希与会话令牌认证"
      ],
