    {
      "id": "github:1174128093",
      "name": "Legal Hold Manager",
      "track": "open_source",
      "summary": "面向法务与法务运营团队的自托管法律留置管理 Web 应用，按事项创建、签发、暂停与解除留置，管理保管人群体，发送留置通知并逐人跟踪送达/确认/逾期状态，含自动提醒、不可变审计日志与管理员/保管人角色。",
      "homepage": "https://github.com/noamrazbuilds/legal-hold-manager",
      "repository_url": "https://github.com/noamrazbuilds/legal-hold-manager",
      "github_repository_id": 1174128093,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/noamrazbuilds/legal-hold-manager/license",
      "features": [
        "留置记录管理：创建、更新、暂停、解除，含事项名称、触发事件、范围、日期区间",
        "保管人数据库：联系方式、部门、职位、数据源映射",
        "留置通知生成与邮件发送（SMTP 或模拟模式）",
        "逐保管人确认跟踪：待处理、已通知、已确认、逾期",
        "对未响应保管人的自动重复提醒",
        "不可变审计日志",
        "管理员与保管人角色权限"
      ],
      "deployment": [
        "self-hosted",
        "docker",
        "railway"
      ],
      "technology_stack": [
        "Python",
        "FastAPI",
        "SQLAlchemy",
        "Streamlit",
        "SQLite"
      ],
