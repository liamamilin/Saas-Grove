  "entries": [
    {
      "id": "github:1159568793",
      "name": "OpenMES",
      "track": "open_source",
      "summary": "可自托管的开源制造执行系统（MES）Web 应用，面向中小制造车间。以产线、工位、工单、批次与工序为实时运营对象，操作员可按类别上报问题并由主管按 Open→Acknowledged→Resolved→Closed 流程处理，关键问题自动阻断工单；提供停机原因与停机报表、计划与实际产量、周期时间和 OEE 看板，并通过 MQTT、REST API 与 ERP/CSV 导入连接计划层和机器层。",
      "homepage": "https://getopenmes.com",
      "repository_url": "https://github.com/Mes-Open/OpenMes",
      "github_repository_id": 1159568793,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/Mes-Open/OpenMes/license",
      "features": [
        "多产线排程与工单生命周期（Pending/Accepted/In Progress/Paused/Done）",
        "实时产线状态（运行、换型、故障、计划停机、非计划停机）及批次/工序进度",
        "Andon 问题上报、预定义类别（物料短缺、质量缺陷、工具故障、机器故障）、升级主管与处置闭环",
        "关键问题自动阻断工单，解决后可继续生产",
        "停机原因分解、停机报表、计划与实际产量、周期时间、问题趋势与 OEE 看板/API",
        "质量检验与处置、维护事件、批次与物料谱系追溯",
        "MQTT 机器数据采集、REST API、CSV/Excel 从 SAP/Odoo/Comarch 导入"
      ],
      "deployment": [
        "Docker Compose 自托管（Laravel + PostgreSQL 两个容器）",
        "提供单命令安装脚本与在线演示；平板/PWA 操作员端"
      ],
      "technology_stack": [
        "PHP",
        "Laravel 12",
        "Livewire 4",
        "PostgreSQL 17",
        "Docker",
        "MQTT"
      ],
