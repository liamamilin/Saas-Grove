  "entries": [
    {
      "id": "github:57224308",
      "name": "ActivityWatch",
      "track": "open_source",
      "summary": "ActivityWatch 是本地优先的开源自动时间追踪应用：托盘程序启动本地 server 与 watcher，持续记录前台应用、窗口标题与浏览器标签，在本地 Web 界面形成时间线与分类汇总，用可编辑的类别规则把时间解读为工作/娱乐等用途。",
      "homepage": "https://activitywatch.net/",
      "repository_url": "https://github.com/ActivityWatch/activitywatch",
      "github_repository_id": 57224308,
      "license": "MPL-2.0",
      "license_evidence_url": "https://api.github.com/repos/ActivityWatch/activitywatch/license",
      "features": [
        "自动记录前台应用、窗口标题与浏览器标签 URL",
        "通过键鼠活动判断离开状态（AFK）",
        "事件持久化存储为 buckets/events，可在时间线与原始数据视图中浏览",
        "用户自定义类别层级与基于窗口标题/应用名的正则分类规则",
        "可在托盘菜单暂停指定 watcher 模块的记录",
        "通过 Web 界面或 REST API 导出 JSON 数据"
      ],
      "deployment": [
        "本地运行 aw-qt 托盘程序，自动启动 aw-server 与默认 watcher",
        "Web 界面默认运行于 http://localhost:5600",
        "提供 Windows/macOS/Linux 安装包与 Android 客户端"
      ],
      "technology_stack": [
        "Python",
        "Rust",
        "SQLite"
      ],
