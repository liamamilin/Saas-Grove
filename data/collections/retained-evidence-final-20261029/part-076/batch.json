  "entries": [
    {
      "id": "github:1203202128",
      "name": "LQGovernance — Board Management Portal",
      "track": "open_source",
      "summary": "自托管董事会治理门户：以会议为单元组织议程与出席、按成员权限分发董事会材料、起草并签署会议纪要，同时提供决议投票、任务与审计链。",
      "homepage": "https://github.com/LegalQuants/LQGovernance-OpenBoard",
      "repository_url": "https://github.com/LegalQuants/LQGovernance-OpenBoard",
      "github_repository_id": 1203202128,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/LegalQuants/LQGovernance-OpenBoard/license",
      "features": [
        "董事会与成员范围：董事会、成员、治理档案与规则持久化为统一记录，操作按角色、董事会、回避与保密规则校验",
        "会议：带议程与出席记录的会议，出席数据被投票计票读取",
        "董事会材料：上传、分类、下载，按成员授权并支持显式拒绝（回避优先）的文档访问控制",
        "会议记录：纪要草稿、评论、签署，签署人持个人 Ed25519 密钥",
        "决议与投票：会议表决与传签，法定人数、通过门槛、回避、代理与加权投票，结束后生成签名证书",
        "治理义务：任务分派、证据提交与复核，截止期限触发提醒或失效",
        "审计：HMAC 审计链，写入失败即回滚；完整记录导出与留存快照"
      ],
      "deployment": [
        "Docker Compose 自托管，应用与 PostgreSQL 由同一 Compose 编排",
        "提供 Dockerfile、Caddyfile 与生产部署文档，可置于自有 HTTPS 反向代理之后"
      ],
      "technology_stack": [
        "TypeScript",
        "React",
        "Express",
        "PostgreSQL",
        "Socket.IO",
        "Docker"
      ],
