      "id": "github:6358188",
      "name": "Apache Druid",
      "track": "open_source",
      "summary": "Apache Druid 分析数据平台自带的 Web 控制台 Query 视图：用户在同一 SQL 编辑器中编写、运行并预览针对 Druid 自身 datasource 的查询，查看结果网格、解释计划与查询历史，并可原地改写后重跑；它是平台内绑定的分析查询界面，不是跨库通用 SQL 客户端。",
      "homepage": "https://druid.apache.org/",
      "repository_url": "https://github.com/apache/druid",
      "github_repository_id": 6358188,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/apache/druid/license",
      "features": [
        "多标签 SQL 查询编辑器",
        "Run 运行与 Preview 预览",
        "结果网格（Smart query limit 默认限制预览行数）",
        "EXPLAIN / Explain SQL query 计划",
        "查询历史与 Recent query tasks",
        "查询计时、进度条、live reports 与取消运行中查询",
        "浏览 Druid schema、datasource 与列"
      ],
      "deployment": [
        "Docker 快速启动",
        "源码构建/集群部署",
        "Kubernetes（druid-operator，独立仓库）"
      ],
      "technology_stack": [
        "Java"
      ],
