      "name": "Dashy",
      "track": "open_source",
      "summary": "Dashy 是自托管的个人仪表盘/起始页：用 YAML 或页面内编辑把多个页面、分区与小组件组合成个人常驻主页，展示天气、日历、RSS、行情、服务状态等动态内容，并可对小部件开启连续自动更新。",
      "homepage": "https://dashy.to",
      "repository_url": "https://github.com/lissy93/dashy",
      "github_repository_id": 343078060,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/lissy93/dashy/license",
      "features": [
        "多个页面、分区与条目由用户自行编排，支持界面内编辑模式",
        "小组件展示天气、日历、RSS、行情、加密资产、新闻、服务状态等动态内容",
        "可为小部件设置 updateInterval 开启连续自动更新",
        "支持自定义小部件、主题、图标包与多语言界面"
      ],
      "deployment": [
        "官方 Docker 镜像 lissy93/dashy（Docker Hub 与 GHCR，多架构），提供 compose 示例",
        "Node.js 源码构建运行（yarn build / yarn start）"
      ],
      "technology_stack": [
        "Vue",
        "Node.js",
        "YAML 配置",
        "Docker"
      ],
