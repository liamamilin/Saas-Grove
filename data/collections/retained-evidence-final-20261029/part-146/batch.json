    {
      "id": "github:1269449119",
      "name": "Massing",
      "track": "open_source",
      "summary": "MIT 许可、可自托管的开源 AEC Web 应用；在浏览器中以 IFC 为单一模型源创作墙、柱、板、门窗与 MEP 等类型化构件，并由模型生成平面、剖面、立面、明细表和可签发图纸（SVG/PDF/DXF）。",
      "homepage": "https://massing.build/",
      "repository_url": "https://github.com/ibuilder/massing",
      "github_repository_id": 1269449119,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/ibuilder/massing/license",
      "features": [
        "浏览器内 IFC 原生 BIM 创作：墙、柱、板、梁、屋顶、房间、门窗与 MEP 构件",
        "类型化构件与 GUID 稳定编辑，门窗开洞并填充宿主墙",
        "由单一 IFC 模型派生平面、剖面、立面、明细表与可签发图纸",
        "图纸与明细表导出 SVG、PDF、DXF，并支持工程量与 COBie 导出",
        "Docker Compose 自托管全栈，MIT 许可"
      ],
      "deployment": [
        "Docker Compose 自托管全栈（web、API、Postgres、MinIO）",
        "浏览器访问（PWA）",
        "Windows/macOS/Linux 桌面安装包（Tauri）"
      ],
      "technology_stack": [
        "That Open Fragments / web-ifc",
        "IfcOpenShell",
        "three.js",
        "FastAPI",
        "Tauri"
      ],
