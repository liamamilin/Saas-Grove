    {
      "id": "github:86956808",
      "name": "WriteFreely",
      "track": "open_source",
      "summary": "WriteFreely 是 AGPL-3.0 开源的写作与发布平台，可自托管。其编辑器刻意精简到只做写作一件事：无通知、无统计横幅，正文以 Markdown 轻量标记录入，格式化留到渲染/发布时呈现；写作内容自动保存，并可用草稿与博客文章形式长期保留。",
      "homepage": "https://writefreely.org/",
      "repository_url": "https://github.com/writefreely/writefreely",
      "github_repository_id": 86956808,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/writefreely/writefreely/license",
      "features": [
        "精简的纯文本编辑器，官方说明其只服务于写作，不推送通知或统计",
        "Markdown/HTML 轻量标记录入，格式化在发布渲染时呈现",
        "写作自动保存，离开后可回到原处继续",
        "草稿（Drafts）与博客文章均可持久保存，支持多博客"
      ],
      "deployment": [
        "以 Go 静态二进制自托管，内置 SQLite 或连接 MySQL/MariaDB",
        "提供 Docker 镜像"
      ],
      "technology_stack": [
        "Go",
        "SQLite",
        "MySQL/MariaDB",
        "ActivityPub"
      ],
