  "entries": [
    {
      "id": "github:1163607752",
      "name": "CloudCertPrep",
      "track": "open_source",
      "summary": "CloudCertPrep 是面向 AWS 认证考试的开源备考 Web 应用，覆盖 AWS Cloud Practitioner（CLF-C02）与 AWS AI Practitioner（AIF-C01）两个由外部权威定义的目标考试。题库按官方考试域组织，提供全真限时模考（题量、时长与及格分按各认证配置）、逐题解析、按域练习与自适应间隔重复；登录后由 Supabase 持久保存模考历史、逐题结果与各域掌握度，形成可回看的评分练习闭环。代码 MIT 许可，可自托管（Astro 静态站 + 自备 Supabase），也有官方在线实例。",
      "homepage": "https://www.cloudcertprep.io",
      "repository_url": "https://github.com/nastaso/cloudcertprep",
      "github_repository_id": 1163607752,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/nastaso/cloudcertprep/license",
      "features": [
        "按 AWS CLF-C02 / AIF-C01 官方考试域组织的题库，合计 1,469+ 道题",
        "全真限时模考：题量、时长、及格分按各认证考试配置",
        "逐题正确答案与干扰项解析，域练习即时反馈",
        "自适应间隔重复，优先推送答错或未见的题",
        "登录后持久保存模考历史、逐题结果、域掌握度与薄弱域分析",
        "游客模式可免注册完成整卷模考",
        "多认证架构，可按域扩展新的目标考试"
      ],
      "deployment": [
        "Astro 静态站可部署到 Cloudflare Pages 或任意静态托管",
        "认证与进度持久化需自备 Supabase 项目（PostgreSQL + Auth + RLS）",
        "本地开发：npm install，配置 .env 中的 Supabase URL 与 anon key，运行 npm run dev",
        "官方在线实例：https://www.cloudcertprep.io"
      ],
      "technology_stack": [
        "Astro 6 + React 19 islands + TypeScript",
        "Tailwind CSS 3.4",
        "Supabase（PostgreSQL、Auth、Row Level Security）",
        "Cloudflare Pages 与 Turnstile",
        "GitHub Actions + Playwright"
      ],
