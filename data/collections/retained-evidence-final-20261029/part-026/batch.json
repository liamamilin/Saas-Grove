  "entries": [
    {
      "id": "github:119160553",
      "name": "PhotoPrism",
      "track": "open_source",
      "summary": "PhotoPrism 是自托管照片库 Web 应用（社区版，Docker 部署、浏览器访问）：把照片与视频索引进自有数据库并生成元数据边车，提供跨全库的搜索、相册、标签、人物与地点组织，以及审核、编辑元数据/旋转、堆栈、下载和相册分享链接，覆盖导入—筛选—编辑—交付的照片工作流。",
      "homepage": "https://photoprism.app",
      "repository_url": "https://github.com/photoprism/photoprism",
      "github_repository_id": 119160553,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://raw.githubusercontent.com/photoprism/photoprism/develop/LICENSE",
      "license_review": {
        "rationale": "本轮重新抓取仓库 LICENSE 全文（33824 字节），确认包含 GNU Affero General Public License 第 3 版完整条款与“terms and conditions”，并在第 18 节保留 PhotoPrism® 商标与品牌资产权利；商标保留不改变软件本体 AGPL-3.0 的许可范围。README 与文档另标明文档采用 CC BY-NC-SA 4.0，未将其误作软件许可。",
        "reviewer": "source_research",
        "scope": "repository",
        "source_url": "https://raw.githubusercontent.com/photoprism/photoprism/develop/LICENSE",
        "spdx_id": "AGPL-3.0"
      },
      "features": [
        "把照片与视频索引进自有数据库，读取 Exif/XMP 并生成 YAML/JSON 元数据边车",
        "从导入目录摄取文件（复制或移动、跳过重复、按年月归档）或直接索引既有 originals 目录",
        "跨全库搜索并按标签、地点、分辨率、颜色、质量等过滤",
        "相册、标签、人物、地点、时刻等组织与检索结构",
        "审核机制：低质量照片需人工批准后才进入搜索，可关闭",
        "编辑对话框修改标题、日期、地点、说明、版权与标签，修改值在重新索引后保留",
        "旋转 JPG/PNG、RAW/JPEG 堆栈与主文件切换",
        "下载原图，可配置每个照片下载哪些关联文件",
        "为相册/时刻/月份/地区/文件夹创建带密钥与有效期的分享链接，观众只能查看和下载非私有照片，不能修改内容或元数据"
      ],
      "deployment": [
        "官方提供 Docker Compose 等自托管社区版，用户通过 Web 浏览器/PWA 访问",
        "服务器可运行于 Mac、Linux、Windows，也支持 PikaPods、DigitalOcean、Raspberry Pi 与多种 NAS",
        "另有成员版/商业托管选项；本条目按社区版自托管应用记录"
      ],
      "technology_stack": [
        "Go 服务端",
        "Vue.js 前端",
        "SQLite 或 MariaDB"
      ],
