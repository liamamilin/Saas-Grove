  "entries": [
    {
      "id": "github:1325693726",
      "name": "AuditOne",
      "track": "open_source",
      "summary": "开源自托管的内部审计管理系统，覆盖审计范围（universe）、风险评估、基于风险的年度计划、审计项目执行与工作底稿、发现整改到验证关闭、被审计方门户与报告，并按 IIA 2024 全球内审准则组织工作流。",
      "homepage": "https://github.com/daniellewisDL/auditone",
      "repository_url": "https://github.com/daniellewisDL/auditone",
      "github_repository_id": 1325693726,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/daniellewisDL/auditone/license",
      "features": [
        "审计范围：部门→流程→实体层级与业务背景画像",
        "风险评估：加权因子评分、冻结期间历史、带阈值的关键风险指标",
        "基于风险的年度计划：审批时快照版本化、修订差异、人力容量与分配",
        "审计项目：阶段、范围文档、风险与控制矩阵、模板化审计程序、证据工作底稿、编制/复核签字",
        "数据工作台：CSV/Excel 导入、DuckDB 沙箱 SQL、可复用测试挂接到工作底稿",
        "发现事项台账：条件/标准/原因/影响结构化记录，受控生命周期至验证关闭、风险接受、逾期老化",
        "被审计方门户：问题责任人回复、上传证据、申请延期、查看已签发报告",
        "报告：区块式构建、版本化签发、PDF 与 Word 输出",
        "产品内 IIA 2024 准则符合性映射"
      ],
      "deployment": [
        "self-hosted"
      ],
      "technology_stack": [
        "Next.js",
        "TypeScript",
        "PostgreSQL",
        "DuckDB"
      ],
