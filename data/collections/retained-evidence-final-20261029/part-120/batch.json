      "id": "github:117503394",
      "name": "Roxy-WI",
      "track": "open_source",
      "summary": "Roxy-WI is a self-hosted web application for managing HAProxy load balancers: operators configure listeners and backend pools, control backend servers through the HAProxy Runtime API, inspect server states and backend health, and review configuration changes.",
      "homepage": "https://roxy-wi.org",
      "repository_url": "https://github.com/roxy-wi/roxy-wi",
      "github_repository_id": 117503394,
      "license": "Apache-2.0",
      "license_evidence_url": "https://raw.githubusercontent.com/roxy-wi/roxy-wi/master/LICENSE",
      "features": [
        "Web forms and a configuration editor for HAProxy listeners and backends",
        "HAProxy Runtime API operations including backend server controls",
        "HAProxy statistics view for sessions, server states and backend health",
        "Configuration editing, saved-version comparison and service actions across connected HAProxy servers"
      ],
      "deployment": [
        "Self-hosted Linux packages, Docker Compose, or Kubernetes Helm chart",
        "Connects to existing HAProxy servers over SSH"
      ],
      "technology_stack": [
        "Python"
      ],
