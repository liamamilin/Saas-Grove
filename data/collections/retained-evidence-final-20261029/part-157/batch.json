    {
      "id": "github:805297890",
      "name": "TianGong LCA",
      "track": "open_source",
      "summary": "TianGong LCA（天工 LCA）是 MIT 许可、完全开源的 Web 生命周期评估平台，提供在线服务与 Docker 私有部署：用户在浏览器工作区创建 flow/process、连接输入输出并设定 reference flow，把多个 processes 组装成 model，保存后生成聚合清单，并运行 process/model 级 LCIA、影响类别对比与贡献路径分析。",
      "homepage": "https://tiangong.earth",
      "repository_url": "https://github.com/tiangong-lca/platform",
      "github_repository_id": 805297890,
      "license": "MIT",
      "license_evidence_url": "https://raw.githubusercontent.com/tiangong-lca/platform/main/LICENSE",
      "license_review": {
        "reviewer": "opencode-go/deepseek-v4.1-flash",
        "source_url": "https://raw.githubusercontent.com/tiangong-lca/platform/main/LICENSE",
        "spdx_id": "MIT",
        "scope": "repository",
        "rationale": "仓库根目录 LICENSE 快照包含完整 MIT 许可正文（版权声明、授权条款与免责声明），与 tiangong-lca/platform 仓库身份绑定，据此确认仓库整体为 MIT 许可。"
      },
      "features": [
        "在 My Data 中创建 flow 与 process，填写输入输出并指定 reference flow",
        "用节点选择器把 processes 组装为 model，连接节点流并设置 reference process 与 reference flow quantity",
        "保存 model 后生成聚合清单结果，供其他模型复用",
        "process 级与 model 级 LCIA，支持影响方法、特征化因子覆盖检查、影响类别对比与贡献路径分析",
        "TIDAS ZIP 导入导出、OpenAPI/MCP/CLI 集成、团队数据空间与审核协作"
      ],
      "deployment": [
        "官方托管 Web 服务 https://lca.tiangong.earth",
        "Docker 私有部署",
        "团队数据空间、审核与系统管理工作区"
      ],
      "technology_stack": [
        "Web 前端（浏览器访问）",
        "Docker",
        "OpenAPI / MCP / CLI 集成"
      ],
