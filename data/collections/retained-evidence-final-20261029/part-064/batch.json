      "leaf_matches": [
        {
          "slug": "bookkeeping-application",
          "reason": "README 说明其为复式记账软件，以纯文本 journal 逐笔记录并按账户分类（示例含资产/负债/权益/收入/费用账户），生成余额与报表；账簿文件由用户长期保存、可版本控制。本轮补证的 hledger-web 官方手册正文进一步说明其为可浏览与添加交易的 Web 应用，--serve 常驻提供 Web UI 与 JSON API，读写同一 journal 并在每次编辑后写编号备份，可多用户共享——原“网页界面仅有概述、持久使用边界不明”的缺口已由正文解决。边界如实收窄为本地优先的单 journal 工具，无访问控制、默认仅监听 127.0.0.1。",
          "source_urls": [
            "https://api.github.com/repos/hledgerorg/hledger",
