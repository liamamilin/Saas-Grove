  "entries": [
    {
      "id": "github:121619061",
      "name": "GenericCDSS",
      "track": "open_source",
      "summary": "GPL-3.0 的开源 Web 临床决策支持应用。面向医护人员提供患者仪表盘、临床变量与临床方案管理；方案由 inquiry、decision、action 元素组成，运行时按患者输入的临床数据走决策分支，并在界面列出 “Actions recommended” 供医生执行。执行由当前登录用户的医生 Profile 触发，执行记录保存执行医生、执行时间与状态。使用 Django REST Framework + ReactJS + PostgreSQL，可通过 Docker Compose 自托管。",
      "homepage": "https://github.com/bioinformatics-ua/GenericCDSS",
      "repository_url": "https://github.com/bioinformatics-ua/GenericCDSS",
      "github_repository_id": 121619061,
      "license": "GPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/bioinformatics-ua/GenericCDSS/license",
      "features": [
        "医护人员患者仪表盘与患者临床信息维护",
        "自定义临床方案（protocol）及 inquiry/decision/action 元素",
        "按患者临床变量执行方案决策分支",
        "执行后列出建议动作（Actions recommended）；执行记录保存执行医生、执行时间与状态",
        "按计划分配与执行方案，并按排程计算下一次测量时间"
      ],
      "deployment": [
        "Docker Compose + Make 自托管",
        "PostgreSQL 数据库",
        "Django REST API 与 ReactJS 前端"
      ],
      "technology_stack": [
        "Python",
        "Django",
        "Django REST Framework",
        "ReactJS",
        "PostgreSQL",
        "Docker"
      ],
