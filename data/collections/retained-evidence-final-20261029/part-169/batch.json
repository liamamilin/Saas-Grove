    {
      "id": "github:1169459491",
      "name": "Clinical Insight Engine",
      "track": "open_source",
      "summary": "MIT 许可的全栈开源临床决策支持应用，面向糖尿病早期风险，定位为教育与研究用途。采集年龄、性别、BMI、HbA1c、血糖、高血压/心脏病史与吸烟史等患者数据，使用可解释逻辑回归模型输出风险百分比、主要贡献因素及建议的临床随访动作，并区分医生视图与患者视图；提供评估历史留存与查看，跨就诊纵向追踪仍为 Roadmap 规划项。React + Express + Python/scikit-learn + PostgreSQL，可本地自托管。",
      "homepage": "https://github.com/gopaljilab/Clinical-Insight-Engine",
      "repository_url": "https://github.com/gopaljilab/Clinical-Insight-Engine",
      "github_repository_id": 1169459491,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/gopaljilab/Clinical-Insight-Engine/license",
      "features": [
        "患者风险表单（年龄、BMI、HbA1c、血糖、病史、吸烟史等）",
        "可解释逻辑回归模型输出风险百分比与因素贡献",
        "医生视图展示风险、主要因素及建议临床随访动作",
        "患者视图提供简化风险等级与预防性生活方式说明",
        "评估历史留存与查看（跨就诊纵向追踪仍为 Roadmap 规划项）"
      ],
      "deployment": [
        "React + Express + PostgreSQL 本地自托管",
        "Python/scikit-learn 模型服务",
        "按 README 的环境变量与数据库步骤部署"
      ],
      "technology_stack": [
        "React",
        "TypeScript",
        "Express.js",
        "PostgreSQL",
        "Python",
        "scikit-learn"
      ],
