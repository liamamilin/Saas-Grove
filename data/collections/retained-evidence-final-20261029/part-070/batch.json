    {
      "id": "github:1046293319",
      "name": "MinuteBooks",
      "track": "open_source",
      "summary": "面向加拿大联邦（LCSA）与魁北克（LSAQ）公司的开源数字公司账簿平台：按组织与公司维护主体登记信息、董事/高管任命、股权登记与公司治理文件库，并提供带到期时间的只读账簿共享链接。",
      "homepage": "https://github.com/vsaintloup/minutebooks",
      "repository_url": "https://github.com/vsaintloup/minutebooks",
      "github_repository_id": 1046293319,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/vsaintloup/minutebooks/license",
      "features": [
        "公司主体记录：法定名称、商号（d/b/a）、管辖地（CBCA/LSAQ）、注册编号、商业编号、注册办事处与记录办事处",
        "任职记录：董事与高管绑定自然人或法人主体，带 started_on/ended_on 生效与终止日期",
        "股权登记：股份类别、证书、发行/转让/赎回事件（occurred_on）与计算出的股权结构",
        "公司治理文件库：章程、会议记录、股东/董事会决议、证书等按公司归档，含 SHA-256 与内容类型",
        "按组织成员身份与角色授权，支持带过期时间的只读账簿共享链接"
      ],
      "deployment": [
        "Django 本地运行（SQLite 开发 / PostgreSQL 生产）",
        "Docker Compose（PostgreSQL + Redis + MinIO）",
        "支持 S3/MinIO 对象存储作为文件后端"
      ],
      "technology_stack": [
        "Django 5 + Django REST Framework",
        "PostgreSQL / SQLite",
        "django-allauth + django-guardian",
        "MinIO / S3 + django-storages",
        "docxtpl 文书模板生成"
      ],
