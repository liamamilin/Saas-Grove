    {
      "id": "github:1283596730",
      "name": "Pathology LIS",
      "track": "open_source",
      "summary": "面向解剖病理科的自托管开源 LIS，覆盖病例登记、标本大体检查、组织处理/包埋/切片/染色、玻片分发、病理医师诊断签署以及 PDF 报告归档，使用 React、FastAPI 与 PostgreSQL，可通过 Docker Compose 部署。",
      "homepage": "https://github.com/korawit-t/Pathology-LIS",
      "repository_url": "https://github.com/korawit-t/Pathology-LIS",
      "github_repository_id": 1283596730,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/korawit-t/Pathology-LIS/license",
      "features": [
        "外科病理、妇科细胞学和非妇科细胞学病例登记与统一 accession",
        "大体检查、标本管理、大体图像上传及组织块生成",
        "组织处理、包埋、切片和 H&E/特殊染色工作流跟踪",
        "组织块与玻片管理、分发和存储追踪",
        "病理医师结构化诊断、多角色签署与报告审批",
        "PDF 报告生成、报告归档及修订/补充报告",
        "基于角色的访问控制与审计日志"
      ],
      "deployment": [
        "Docker Compose 自托管部署",
        "医院内网直接访问或 HTTPS 反向代理部署"
      ],
      "technology_stack": [
        "React 18 + Vite + Ant Design 5",
        "Python 3.11 + FastAPI",
        "PostgreSQL 15",
        "WeasyPrint + Jinja2",
        "Docker Compose"
      ],
