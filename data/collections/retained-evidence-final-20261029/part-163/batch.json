      "leaf_matches": [
        {
          "slug": "blood-bank-management",
          "reason": "官方项目页说明 BSIS 覆盖献血登记、采集、检测、成分制备/贴签、储存及向医院/诊所分发；代码把每个 Component 作为单独标识的血液单位（献血识别号 DIN、成分代码、血型、有效期、状态、库存状态），状态按隔离/可用/过期/发放/输血/不安全/废弃/处理流转，可用状态需放行、血型确认与 TTI 安全门控；库存可按地点、成分类型、血型、到期日查询，OrderForm 以患者/机构请求匹配并发放单位，Transfusion 将单位与患者关联，ComponentStatusChange 记录操作者、时间和原因，构成从献血到最终处置的追溯链。",
          "source_urls": [
            "https://www.jembi.org/Project/blood-safety-strengthening-programme-(bssp)",
            "https://raw.githubusercontent.com/jembi/bsis/develop/README.md",
