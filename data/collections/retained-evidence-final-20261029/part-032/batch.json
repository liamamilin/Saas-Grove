  "entries": [
    {
      "id": "github:1266672576",
      "name": "SwitchFrame",
      "track": "open_source",
      "summary": "SwitchFrame 是自托管的浏览器控制实时视频切换台：服务端完成多路源的切换、转场、抠像与合成并编码为持续节目，操作员在浏览器控制台完成导播，节目同时输出到录制、SRT/RTMP 目的地、MXL 基带与浏览器监看。代码现行托管于 thiagopnts/switchframe（仓库 id 1266672576）；仓库自带的 README 徽章、git clone 地址与 LICENSE 署名仍指向 zsiec/switchframe 与 Thomas Symborski（GitHub 用户 zsiec），该地址已不可访问，归属与发布主体核对结果见研究记录。",
      "homepage": "https://github.com/thiagopnts/switchframe",
      "repository_url": "https://github.com/thiagopnts/switchframe",
      "github_repository_id": 1266672576,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/thiagopnts/switchframe/license",
      "license_review": {
        "reviewer": "open-design/deepseek-v4.1-flash unit-32 correction",
        "source_url": "https://api.github.com/repos/thiagopnts/switchframe/license",
        "spdx_id": "MIT",
        "scope": "repository",
        "rationale": "LICENSE 端点返回 base64 编码的完整 MIT 文本（1073 字节，含授权、版权声明保留与免责条款），非摘要或 SPDX 字段；版权署名为 Copyright (c) 2026 Thomas Symborski，与 README/CI 指向的 zsiec 一致而与仓库当前 owner 不同，归属差异已在研究记录留档。"
      },
      "features": [
        "多路实时源：SRT 输入（listener/caller）、MoQ 摄像头、MXL 共享内存、文件片段与播放通道",
        "切换与转场：cut、mix、dip-to-black、六方向 wipe、stinger、手动 T-bar",
        "帧内合成：上游色度/亮度抠像、DVE、画中画与并排/四宫格布局、8 层下游键（DSK）图形叠加",
        "音频混合：每路推子、EQ、压缩、限幅与响度计量",
        "并发输出：MPEG-TS 录制、SRT（push/pull）与 RTMP 目的地、MXL 基带输出与浏览器节目监看",
        "浏览器控制台与多操作员角色（导播/音频/图形/观看）"
      ],
      "deployment": [
        "自托管：单个 Go 二进制，内嵌 SvelteKit 控制台，systemd/Nomad 进程监管",
        "浏览器通过 QUIC/WebTransport 连接服务器，操作员登录后使用",
        "提供 Docker 与 Dockerfile.cuda 构建",
        "仓库文档仍以 https://github.com/zsiec/switchframe.git 作为克隆地址与 CI 徽章目标；该地址在 2026-10-28 核对时返回 404，本条目以实际托管代码的 thiagopnts/switchframe 及其仓库 id 为准，不据徽章文字另立条目"
      ],
      "technology_stack": [
        "Go",
        "SvelteKit",
        "TypeScript",
        "FFmpeg",
        "QUIC/WebTransport",
        "SRT",
        "RTMP"
      ],
