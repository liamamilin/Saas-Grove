  "entries": [
    {
      "id": "github:19141754",
      "name": "uData",
      "track": "open_source",
      "summary": "uData 是由法国公共机构 data.gouv.fr 维护的开源开放数据平台（后端 API 与核心平台），配套独立前端 cdata；支持数据集与资源记录、元数据与许可字段、DCAT 分发/目录输出、搜索索引与 API 检索、远端门户元数据采集，可自托管部署为面向公众的开放数据门户。",
      "homepage": "https://udata.readthedocs.io/",
      "repository_url": "https://github.com/opendatateam/udata",
      "github_repository_id": 19141754,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/opendatateam/udata/license",
      "features": [
        "数据集记录与元数据（标识、标题、描述、标签、创建/修改时间、时间覆盖、更新频率、许可）",
        "资源作为 DCAT Distribution（下载/访问 URL、格式、MIME、大小、校验和）",
        "站点与机构级 DCAT Catalog 输出及数据集/资源 API 检索",
        "基于 Elasticsearch（未配置时回退 MongoDB 全文检索）的搜索索引与自动补全",
        "从其他开放数据门户采集/汇聚元数据（DCAT 等 harvesting）",
        "可定制的 cdata 前端，与后端 API 分离部署"
      ],
      "deployment": [
        "官方安装文档提供 Debian 类系统上的生产部署步骤（WSGI 应用、Celery worker、beat/cron 三类服务）",
        "本地开发可用 Docker Compose 启动 MongoDB、Redis 等外部服务",
        "官方 getting-started 说明后端 udata 与前端 cdata 为两个独立服务器，分别启动"
      ],
      "technology_stack": [
        "Python",
        "MongoDB",
        "Redis",
        "Elasticsearch"
      ],
