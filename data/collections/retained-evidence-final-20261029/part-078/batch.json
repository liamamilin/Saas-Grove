    {
      "id": "github:45261230",
      "name": "Kuali Research COI",
      "track": "open_source",
      "summary": "Kuali Research 的利益冲突（COI）管理模块，自托管 Web 应用：研究人员提交披露与财务实体/关系记录，管理员和审查人完成审查与处置，披露可修订并归档保留。仓库整体以 AGPL-3.0 发布；默认使用内置 mock 认证，官方参考认证服务需另行配置。",
      "homepage": "https://github.com/kuali/research-coi",
      "repository_url": "https://github.com/kuali/research-coi",
      "github_repository_id": 45261230,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://raw.githubusercontent.com/kuali/research-coi/master/LICENSE",
      "license_review": {
        "reviewer": "collection-agent",
        "source_url": "https://raw.githubusercontent.com/kuali/research-coi/master/LICENSE",
        "spdx_id": "AGPL-3.0",
        "scope": "repository",
        "rationale": "读取该仓库 master 分支 LICENSE 完整文本（约 34KB），含 GNU Affero General Public License 标题、Version 3 与完整条款，与该仓库元数据标注的 AGPL-3.0 一致。"
      },
      "features": [
        "研究人员填写披露问卷，记录财务实体、关系类型、金额区间、差旅与支持文件",
        "支持年度披露、按项目触发的披露、修订与到期/需更新状态",
        "区分 COI 管理员与审查人角色，可将披露指派给审查人并请求补充",
        "审查产生处置结果（disposition）与状态，支持批量设置处置",
        "归档披露与最近归档版本可供管理员和本人检索，保留审查和修订轨迹",
        "项目与发起人关联、通知与披露汇总/过滤"
      ],
      "deployment": [
        "Node.js + npm 自托管运行，使用 Express 提供 Web 与 REST API",
        "MySQL 或 Oracle 数据库，通过 knex 迁移建表并可选用演示种子数据",
        "默认启用内置 mock 认证；接入官方 Kuali Core Auth Service 需单独配置 AUTH_URL 等变量"
      ],
      "technology_stack": [
        "Node.js / Express",
        "React 15 + Alt（前端）",
        "Knex（MySQL / Oracle）",
        "REST API"
      ],
