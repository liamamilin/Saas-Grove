  "entries": [
    {
      "id": "github:776886715",
      "name": "BookLogr",
      "track": "open_source",
      "summary": "自托管的个人图书管理 Web 应用：以书目记录为中心建立个人馆藏，按 Currently Reading / To Be Read / Read / Did Not Finish 阅读状态列表组织书籍，记录阅读进度（页码或百分比）、起止日期、评分、笔记与摘录，并支持 CSV/JSON/HTML 导入导出。",
      "homepage": "https://booklogr.app",
      "repository_url": "https://github.com/Mozzo1000/booklogr",
      "github_repository_id": 776886715,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/Mozzo1000/booklogr/license",
      "features": [
        "预置阅读状态列表：Currently Reading、To Be Read、Read、Did Not Finish",
        "通过 OpenLibrary 按书名/作者/ISBN 检索并添加书籍，支持手动添加 OpenLibrary 未收录书目",
        "阅读进度跟踪：按页码或完成百分比更新",
        "阅读会话日志，含每本书的开始与结束日期",
        "评分（0.5-5 星）、个人笔记、书评与带页码的摘录",
        "书架/列表排序与视图切换（Gallery/List），按标题、作者、进度、评分或添加日期排序",
        "数据导入导出：从 Goodreads 迁移或 CSV 重新导入，随时导出 CSV/JSON/HTML",
        "可选公开个人主页分享馆藏与公开笔记",
        "单用户私有模式与多用户共享模式"
      ],
      "deployment": [
        "自托管部署，运行于用户自有服务器",
        "SQLite（默认）或 PostgreSQL 数据库"
      ],
      "technology_stack": [
        "Python",
        "Flask",
        "React",
        "SQLite",
        "PostgreSQL"
      ],
