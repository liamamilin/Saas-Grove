    {
      "id": "github:16085812",
      "name": "SimpleRisk",
      "track": "open_source",
      "summary": "SimpleRisk Core 是免费、可自托管的开源 GRC Web 应用，提供组织级风险登记册、统一的评分方法、缓解计划与管理评审，并通过仪表盘和自定义报表汇总风险敞口。",
      "homepage": "https://simplerisk.com/",
      "repository_url": "https://github.com/simplerisk/code",
      "github_repository_id": 16085812,
      "license": "MPL-2.0",
      "license_evidence_url": "https://raw.githubusercontent.com/simplerisk/code/master/simplerisk/LICENSE",
      "features": [
        "组织级风险登记册（自定义字段、负责人、状态）",
        "统一风险评分（Classic 5×5 等多套方法，管理员配置默认量表）",
        "缓解计划与独立验收（Mitigate / Accept / Transfer / Avoid）",
        "提交后管理评审与按风险等级授权的审批",
        "周期性风险复核",
        "固有风险与残余风险评估",
        "风险仪表盘与自定义报表",
        "基于角色的权限与审计轨迹"
      ],
      "deployment": [
        "self-hosted",
        "脚本安装",
        "虚拟机镜像",
        "Docker",
        "手动安装"
      ],
      "technology_stack": [
        "PHP",
        "MySQL"
      ],
