  "entries": [
    {
      "id": "github:934715082",
      "name": "openDAW",
      "track": "open_source",
      "summary": "开源浏览器端数字音频工作站：在持久工程中录制音频与 MIDI、用音符编辑器与设备编排轨道、经混音台按轨混音，并在离线渲染中导出成品音频或分轨，全部在 Web 浏览器内运行，无需安装或账号。",
      "homepage": "https://opendaw.studio",
      "repository_url": "https://github.com/andremichelle/openDAW",
      "github_repository_id": 934715082,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/andremichelle/openDAW/license",
      "features": [
        "浏览器内工程：项目、采样与 soundfont 保存在浏览器私有文件系统（OPFS），可保存、另存、存为模板并重新打开",
        "音频与 MIDI 录制：轨道预备录音、输入设备选择、监听模式与录音 take",
        "编排与音符编辑：时间线轨道、音符编辑器、自动化与速度/拍号自动化",
        "混音台：通道推子、声像、发送、音频总线与主输出汇总",
        "离线渲染导出：整轨音频与分轨导出、冻结轨道离线渲染，另有 DAWproject 与项目包交换"
      ],
      "deployment": [
        "浏览器内运行，无需安装、无需账号（需支持 WebAssembly SIMD、SharedArrayBuffer 与 AudioWorklet 的现代浏览器）",
        "源码可自行克隆并以 npm 构建自托管（开发服务器或静态构建）"
      ],
      "technology_stack": [
        "TypeScript",
        "Rust / WebAssembly",
        "Web Audio API（AudioWorklet）"
      ],
