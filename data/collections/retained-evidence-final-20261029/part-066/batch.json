  "entries": [
    {
      "id": "github:1211443189",
      "name": "HRPulsar",
      "track": "open_source",
      "summary": "开源人才与胜任力管理平台（社区版 AGPL-3.0，可 Docker Compose 自托管）：维护分层的组织胜任力模型（能力、指标、熟练度等级），在岗位/职级上配置所需等级，按自评、经理及 360° 评估记录员工能力档案，并按岗位要求计算差距与生成发展计划。",
      "homepage": "https://hrpulsar.com",
      "repository_url": "https://github.com/HRPulsar/hrpulsar",
      "github_repository_id": 1211443189,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/HRPulsar/hrpulsar/license",
      "license_review": {
        "reviewer": "unit-066 collector",
        "source_url": "https://api.github.com/repos/HRPulsar/hrpulsar/license",
        "spdx_id": "AGPL-3.0",
        "scope": "community_core",
        "rationale": "LICENSE 全文（34,523 字符）为 GNU Affero General Public License v3.0 完整文本；README 第 74–78 行写明 Community Edition 采用 AGPLv3（含 Section 7 组合许可）、Enterprise Edition 另行商业许可；NOTICE 正文同样声明 AGPLv3 与 Section 7 additional permission，故仅以社区版范围申报。"
      },
      "features": [
        "分层胜任力库：能力组/能力/行为指标，按等级组织指标与学习材料，支持自定义等级、发布与停用",
        "岗位与职级矩阵：岗位页展示所需能力及要求等级，职级矩阵按能力×职级配置每格所需熟练度",
        "员工胜任力档案：按岗位所需能力展示最近一次已完成评估的等级，未达标显示空缺，并保留高于/低于要求的结果",
        "差距与通过线：低于或等于通过线的能力统一标为 gap，目录、仪表盘与评估增长区复用同一规则",
        "评估：自评、180°、360°，参与者角色含自我、经理、同事、下属，可配置指标与加权量表",
        "由差距生成个人发展计划，并可与职级/职业阶梯关联"
      ],
      "deployment": [
        "Docker Compose 自托管（PostgreSQL + Redis + 反向代理）",
        "官方云托管版本",
        "本地开发模式（FastAPI 后端 + Next.js 前端）"
      ],
      "technology_stack": [
        "Python / FastAPI",
        "Next.js / React / TypeScript",
        "PostgreSQL",
        "Redis"
      ],
