    {
      "id": "github:638951438",
      "name": "Opik",
      "track": "open_source",
      "summary": "Opik 是 Comet 开源的 LLM 可观测与评估平台，Apache-2.0 全量平台可自托管（含服务端与 Web 应用），提供数据集、实验、评分指标与实验对比。",
      "homepage": "https://www.comet.com/site/products/opik/",
      "repository_url": "https://github.com/comet-ml/opik",
      "github_repository_id": 638951438,
      "license": "Apache-2.0",
      "license_evidence_url": "https://raw.githubusercontent.com/comet-ml/opik/main/LICENSE",
      "features": [
        "以数据集和实验（experiments）组织测试用例，对 LLM 应用输出运行自动评分",
        "内置 30+ 指标与 LLM-as-a-judge 评分器，支持自定义指标与人工标注队列",
        "实验记录持久保存，可在仪表盘并排比较不同应用版本的评估结果",
        "支持将评估接入 CI/CD（PyTest 集成）并做生产在线评估"
      ],
      "deployment": [
        "官方 README 提供 Docker Compose 自托管（./opik.sh）与 Kubernetes/Helm 部署；本轮未部署"
      ],
      "technology_stack": [
        "Python",
        "TypeScript",
        "React",
        "PostgreSQL",
        "ClickHouse"
      ],
