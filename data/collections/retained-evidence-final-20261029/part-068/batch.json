  "entries": [
    {
      "id": "github:1306204230",
      "name": "OpenSourcingOS",
      "track": "open_source",
      "summary": "开源的采购价值跟踪 Web 应用（Apache-2.0，自述 MVP/public beta）：把寻源项目、开销基线、供应商报价与最终授标放在同一组合中，节约按月度/年度/一次性排程，区分预计、已执行、已实现并输出财年与组合报表。",
      "homepage": "https://opensourcingos.com/",
      "repository_url": "https://github.com/gruvyo/opensourcingos",
      "github_repository_id": 1306204230,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/gruvyo/opensourcingos/license",
      "features": [
        "寻源项目组合：项目负责人、品类、业务单元、成本中心、截止日期与更新记录",
        "商业锚点：开标提案、基线、供应商报价与最终授标逐项留存，形成可追溯的节约来源",
        "节约排程：按月、按年或一次性记账，跨年期间归属正确财年",
        "状态分层：预计节约、已执行/合同节约与可选已实现节约分开记录",
        "节约方法论：成本降低 = 基线 − 最终报价，成本规避 = 开标提案 − 基线，总节约不可通过更换基线改写",
        "仪表盘与报表：项目、供应商、节约与财年报表，含逾期与临期项目队列",
        "供应商记录：联系人、寻源历史、授标、风险登记与绩效评审"
      ],
      "deployment": [
        "自托管：克隆仓库后以 npm 安装依赖，Supabase CLI 启动本地 PostgreSQL 并执行迁移，npm run dev 启动 Web 应用",
        "托管演示：opensourcingos.com 提供 Google 登录的隔离示例工作区（public beta，自述非生产系统记录）"
      ],
      "technology_stack": [
        "Next.js 16",
        "React 19",
        "TypeScript",
        "Supabase (PostgreSQL + Row Level Security)",
        "Tailwind CSS",
        "Recharts",
        "Vercel"
      ],
