        "多来源书目记录检索与分面筛选",
        "单条记录实时馆藏状态与位置",
        "读者账户续借与预约",
        "图书馆配置的资源检索范围"
      ],
      "deployment": [
        "web",
        "self-hosted"
      ],
      "technology_stack": [
        "PHP"
