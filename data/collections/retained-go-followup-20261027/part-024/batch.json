    {
      "id": "github:295864168",
      "name": "VotingWorks VxSuite",
      "track": "open_source",
      "summary": "开源选举管理套件：VxAdmin 为离线自托管选举配置端，VxHub 由 VotingWorks 托管用于选票设计，VxPrint 用于按选举包打印选票。VotingWorks 官方技术文档说明，选举定义持有 jurisdiction、contests、districts、precincts 与 ballot styles，ballot style 的 contests 由其关联 districts 决定并绑定使用它的 precinct；选举包按 ballot style 与 precinct 组合携带预生成选票 PDF，供 VxPrint 等设备打印。",
      "homepage": "https://voting.works",
      "repository_url": "https://github.com/votingworks/vxsuite",
      "github_repository_id": 295864168,
      "license": "GPL-3.0-only",
      "license_evidence_url": "https://raw.githubusercontent.com/votingworks/vxsuite/main/LICENSE",
      "features": [
        "选举定义：jurisdiction、contests、districts、precincts 与 ballot styles",
        "选票样式按 precinct 绑定，并按关联 district 决定所含 contests",
        "选举包按 ballot style 与 precinct 组合携带预生成选票 PDF",
        "离线选举配置与签名选举包导出（VxAdmin）",
        "选票设计（VxHub，厂商托管）",
        "按 precinct/split/party/language 打印选票（VxPrint）"
      ],
      "deployment": [
        "offline (VxAdmin)",
        "vendor-managed (VxHub)"
      ],
      "technology_stack": [
        "TypeScript",
        "Rust"
      ],
