    {
      "id": "github:116288758",
      "name": "Turtle Creek Code Enforcement",
      "track": "open_source",
      "summary": "面向美国地方政府的开源法规执法与占用许可数据库，以房产为记录锚点，管理执法案件、法规条款违规、整改期限、通知与案件阶段。",
      "homepage": "https://github.com/TechnologyRediscovery/codeenforcement",
      "repository_url": "https://github.com/TechnologyRediscovery/codeenforcement",
      "github_repository_id": 116288758,
      "license": "GPL-3.0-or-later",
      "license_evidence_url": "https://raw.githubusercontent.com/TechnologyRediscovery/codeenforcement/master/LICENSE",
      "license_review": {
        "reviewer": "OpenCode collector (beam-free)",
        "source_url": "https://raw.githubusercontent.com/TechnologyRediscovery/codeenforcement/master/LICENSE",
        "spdx_id": "GPL-3.0-or-later",
        "scope": "repository",
        "rationale": "Raw LICENSE is the complete GNU GPL version 3 text; the Java source headers state \"either version 3 of the License, or (at your option) any later version\", so the repository is recorded as GPL-3.0-or-later."
      },
      "features": [
        "房产档案：地块编号（parID）、lot/block 与地址",
        "房产外部数据与人员关联：业主姓名/电话，业主、租户、物业经理等人员类型",
        "执法案件关联房产、案件阶段与起止日期",
        "违规记录关联可执行法规条款（条例章节/条款编号），含罚金、整改期限与实际合规日期",
        "案件通知文本、记录日期与寄出/退回日期",
        "占用检查与许可",
        "案件事件列表（CECase.eventList）"
      ],
      "deployment": [
        "Java/NetBeans 构建（build.xml）",
        "PostgreSQL 数据库脚本",
        "JSF/PrimeFaces Web 界面"
      ],
      "technology_stack": [
        "Java",
        "JSF",
        "PrimeFaces",
        "PostgreSQL"
      ],
