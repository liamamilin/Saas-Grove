      "id": "github:1259409130",
      "name": "TPT Court",
      "track": "open_source",
      "summary": "开源法院案件管理平台，支持案件编号与状态、当事人、文档、听证、支付、通知及法官/书记员/律师/公众角色权限。",
      "homepage": "https://opensource.tptsolutions.co.nz/tpt-court",
      "repository_url": "https://github.com/tpt-solutions/tpt-court",
      "github_repository_id": 1259409130,
      "license": "MIT",
      "license_evidence_url": "https://raw.githubusercontent.com/tpt-solutions/tpt-court/master/LICENSE",
      "license_review": {
        "reviewer": "OpenCode collector (beam-free)",
        "source_url": "https://raw.githubusercontent.com/tpt-solutions/tpt-court/master/LICENSE",
        "spdx_id": "MIT",
        "scope": "repository",
        "rationale": "Raw LICENSE contains the standard MIT permission and copyright notice; README and Prisma schema describe court case management, parties, documents, hearings and dispositions."
      },
      "features": [
        "案件编号、类型、状态与结案原因",
        "当事人、律师与角色权限",
        "案件文档、听证与动议",
        "支付、通知与审计日志"
      ],
      "deployment": [
        "Docker Compose + PostgreSQL + Redis",
        "Next.js Web 与 Fastify API"
      ],
      "technology_stack": [
        "TypeScript",
        "Next.js",
        "Fastify",
        "Prisma",
        "PostgreSQL"
      ],
