    {
      "id": "github:5769803",
      "name": "uReport",
      "track": "open_source",
      "summary": "uReport 是 City of Bloomington 开源的地方政府轻量级 CRM/问题跟踪 Web 应用，面向较小市政机构。它以人物与案件的关联记录居民/公众互动：可记录报告人、开案人、承办人和被转介人，按部门配置处理动作与状态，保留案件动作历史和对居民的回复记录（联系方式、人员、时间），并提供 Open311 GeoReport v2 接口与 XML/JSON 数据馈送，可自托管。",
      "homepage": "https://github.com/City-of-Bloomington/uReport",
      "repository_url": "https://github.com/City-of-Bloomington/uReport",
      "github_repository_id": 5769803,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://raw.githubusercontent.com/City-of-Bloomington/uReport/master/LICENSE",
      "license_review": {
        "reviewer": "opencode-go/deepseek-v4.1-flash",
        "source_url": "https://raw.githubusercontent.com/City-of-Bloomington/uReport/master/LICENSE",
        "spdx_id": "AGPL-3.0",
        "scope": "repository",
        "rationale": "逐字读取该仓库 raw LICENSE 全文，确认为完整 GNU AGPL-3.0 条款，并与 README 的 GNU Affero GPLv3 声明一致；按仓库整体许可记录。"
      },
      "features": [
        "人物与案件的关联记录（报告人、开案人、承办人、被转介人）",
        "案件/服务请求录入与跟踪",
        "按部门配置的处理动作（Actions）与状态",
        "案件动作历史及对居民的回复记录（联系方式、人员、时间）",
        "Open311 GeoReport v2 API 端点",
        "XML/JSON 等上下文切换数据馈送"
      ],
      "deployment": [
        "Linux + Apache 2.4 + PHP 8.5+ + MySQL 5.7+ + Solr 7.4",
        "支持 Docker Compose 构建开发/部署环境"
      ],
      "technology_stack": [
        "PHP",
        "Apache",
        "MySQL",
        "Solr"
      ],
