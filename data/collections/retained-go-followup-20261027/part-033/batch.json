      "id": "github:23570030",
      "name": "Superdesk",
      "track": "open_source",
      "summary": "Open-source newsroom system whose core organizes desks, stages and roles and produces/publishes news to websites, apps and partner outputs. With the optional Planning module enabled, it adds persistent Events/Planning Items, coverage assignment to desks/users, planning dates and coverage due dates, and assignment views; the optional Broadcasting module covers shows and rundowns.",
      "homepage": "https://superdesk.org",
      "repository_url": "https://github.com/superdesk/superdesk",
      "github_repository_id": 23570030,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/superdesk/superdesk/license",
      "features": [
        "Core desk, stage and role-based newsroom workflow",
        "Optional Planning module: persistent Events and Planning Items",
        "Optional Planning module: coverage assignment to desks and specific users",
        "Optional Planning module: planning date and coverage due dates",
        "Optional Planning module: desk/personal assignment views with reassign/priority",
        "Core production and publishing to websites, apps and partner outputs",
        "Optional Broadcasting module for shows and rundowns (overview only)"
      ],
      "deployment": [
        "Self-hosted Python backend and Node.js frontend",
        "Production Docker Compose deployment"
      ],
      "technology_stack": [
        "Python",
        "Node.js",
        "MongoDB",
        "Elasticsearch",
        "Redis"
