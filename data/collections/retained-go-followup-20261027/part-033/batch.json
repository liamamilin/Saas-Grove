      "id": "github:9852918",
      "name": "Ghost",
      "track": "open_source",
      "summary": "Open-source publishing platform for persistent posts and newsletters; editors preview and explicitly publish or schedule posts, change publish dates, permanently delete posts (deleted posts cannot be recovered), restore earlier edits from post history, and organize content through a featured-post toggle, tag/author archives and routes.yaml collection filters. Homepage, archive and collection listings are reverse-chronological by default; manual editorial re-ranking of front/section pages is not claimed.",
      "homepage": "https://ghost.org",
      "repository_url": "https://github.com/TryGhost/Ghost",
      "github_repository_id": 9852918,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/TryGhost/Ghost/license",
      "features": [
        "Persistent posts with authors, tags and media",
        "Preview before explicit publish or scheduled publication",
        "Permanent post deletion with confirmation; deleted posts cannot be recovered",
        "Publish-date changes after publication",
        "Post history storing multiple versions; individual edits can be restored",
        "Featured-post toggle, tag/author archives and routes.yaml filter-based collections",
        "Memberships and email newsletters"
      ],
      "deployment": [
        "Self-hosted Node.js application via ghost-cli",
        "Official Ghost(Pro) managed hosting"
      ],
      "technology_stack": [
        "Node.js",
        "JavaScript"
