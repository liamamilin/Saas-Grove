      "id": "github:567123100",
      "name": "JRaceman",
      "track": "open_source",
      "summary": "开源皮划艇静水与激流回旋赛事管理 Web 系统，覆盖赛事与子比赛创建、参赛者/队伍与报名条目管理、泳道与出发顺序编排，以及成绩和奖牌统计报表。",
      "homepage": "https://github.com/jimmc/jraceman",
      "repository_url": "https://github.com/jimmc/jraceman",
      "github_repository_id": 567123100,
      "license": "GPL-2.0",
      "license_evidence_url": "https://api.github.com/repos/jimmc/jraceman/license",
      "features": [
        "赛事（event）与子比赛（race）创建",
        "参赛者、队伍与报名条目（entry）管理",
        "泳道分配与出发顺序（lane order）编排",
        "成绩、名次与奖牌统计报表",
        "用户与基于角色的 API 权限管理"
      ],
      "deployment": [
        "自托管 Go Web 服务器",
        "SQLite 数据库，可导入赛事定义与历史数据"
      ],
      "technology_stack": [
        "Go",
        "Lit / TypeScript 前端",
        "SQLite"
      ],
