      "id": "github:1201466005",
      "name": "OpenFieldService",
      "track": "open_source",
      "summary": "自托管的现场服务管理应用，README 明确支持家电维修、清洁与电气等上门服务垂直：以客户服务地址和作业为核心，提供排程、技术员派工、场地与设备记录、检查表/物料、完工开票，使用 SQLite 本地运行。维护计划、客户门户等尚未包含。",
      "homepage": "https://github.com/clawnify/OpenFieldService",
      "repository_url": "https://github.com/clawnify/OpenFieldService",
      "github_repository_id": 1201466005,
      "license": "MIT",
      "license_evidence_url": "https://raw.githubusercontent.com/clawnify/OpenFieldService/HEAD/LICENSE",
      "license_review": {
        "reviewer": "opencode-go/deepseek-v4.1-flash",
        "source_url": "https://raw.githubusercontent.com/clawnify/OpenFieldService/HEAD/LICENSE",
        "spdx_id": "MIT",
        "scope": "repository",
        "rationale": "仓库 LICENSE 快照为完整 MIT 许可证文本，含授权、版权声明与免责条款，未见附加限制。"
      },
      "features": [
        "客户与多服务地址管理",
        "作业排程、状态流转与周历派工",
        "技术员派工与可用性/工作量视图",
        "客户场地与序列化设备记录、设备服务历史",
        "可配置服务类型、默认价格与时长",
        "作业检查表、物料与库存记录",
        "按完工作业生成明细发票并跟踪状态",
        "客户历史、营收与未结发票仪表板",
        "只读离线查看当日作业包（不排队离线写入）"
      ],
      "deployment": [
        "本地自托管，README 提供 git clone、pnpm install、pnpm run dev 启动步骤",
        "使用 SQLite / Cloudflare D1 本地持久化（.wrangler/state）",
        "无强制云依赖，可自行部署"
      ],
      "technology_stack": [
        "Preact",
        "Hono",
        "SQLite",
        "Cloudflare D1 / Wrangler"
      ],
