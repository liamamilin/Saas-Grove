      "name": "Folk Care",
      "track": "open_source",
      "summary": "Folk Care 是 AGPL-3.0 的开源家庭护理机构管理平台，覆盖客户与护理员档案、周期性访视排班、GPS/EVV 签到、护理计划与任务、家庭门户以及账单/发票；薪资处理仍标注为后端部分完成。",
      "homepage": "https://folk.care/",
      "repository_url": "https://github.com/neighborhood-lab/folk-care",
      "github_repository_id": 1084967884,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/neighborhood-lab/folk-care/license",
