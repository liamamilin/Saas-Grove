      },
      "features": [
        "客户与人口学档案管理",
        "护理员/员工目录与资质管理",
        "服务模式、周期性访视排班与开放班次匹配",
        "GPS/地理围栏 EVV 签到签出与离线同步",
        "护理计划、目标与任务清单",
        "账单/发票与支付跟踪",
        "家庭门户"
      ],
      "deployment": [
        "README 提供 Node.js 20 + PostgreSQL 自托管安装、迁移与演示数据步骤",
        "README 说明可自托管或使用托管服务，但未明确托管服务与开源自托管版的功能边界"
      ],
      "technology_stack": [
        "TypeScript",
        "Node.js",
        "React",
        "PostgreSQL",
        "React Native"
      ],
