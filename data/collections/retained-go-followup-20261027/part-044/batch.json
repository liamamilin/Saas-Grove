    {
      "id": "github:664013991",
      "name": "Postiz",
      "track": "open_source",
      "summary": "Postiz 是开源的社交媒体排期与发布工具（AGPL-3.0）：连接创作者自有社交账号，在内容日历上安排草稿与定时帖子，按渠道独立设定时间并自动发布；自托管版与 Postiz Cloud 共用核心功能，不设功能门槛。",
      "homepage": "https://postiz.com",
      "repository_url": "https://github.com/gitroomhq/postiz-app",
      "github_repository_id": 664013991,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://raw.githubusercontent.com/gitroomhq/postiz-app/main/LICENSE",
      "license_review": {
        "reviewer": "opencode-go/deepseek-v4.1-flash",
        "source_url": "https://raw.githubusercontent.com/gitroomhq/postiz-app/main/LICENSE",
        "spdx_id": "AGPL-3.0",
        "scope": "repository",
        "rationale": "该仓库 LICENSE 为完整 GNU AGPL v3 文本，包含标题、版本 3 条款与免责声明；README 同时声明源代码以 AGPL-3.0 发布。"
      },
      "features": [
        "连接自有社交渠道（OAuth、凭据、应用内对话框等方式）",
        "内容日历：日/周/月/列表视图，按渠道与客户筛选",
        "计划帖子：保存草稿、加入日历定时、立即发布与周期重复",
        "同一帖子跨渠道保存，各渠道保留独立日期与时间",
        "发布失败在日历卡片上显示红色标记与平台错误，不静默重试"
      ],
      "deployment": [
        "Docker / Coolify / Railway / 任意 VPS 自托管",
        "需自备 PostgreSQL、Redis、存储与环境变量",
        "官方托管版 Postiz Cloud"
      ],
      "technology_stack": [
        "NextJS (React)",
        "NestJS",
        "Prisma（默认 PostgreSQL）",
        "Temporal",
        "Pnpm workspaces（Monorepo）"
      ],
