    {
      "id": "github:92313258",
      "name": "cert-manager",
      "track": "open_source",
      "summary": "Kubernetes 原生证书管理控制器，依据 Certificate 资源向 Issuer/ClusterIssuer 申请签发 X.509 证书，写入 Secret，并在到期前按 duration/renewBefore 自动续订和重新签发。",
      "homepage": "https://cert-manager.io",
      "repository_url": "https://github.com/cert-manager/cert-manager",
      "github_repository_id": 92313258,
      "license": "Apache-2.0",
      "license_evidence_url": "https://raw.githubusercontent.com/cert-manager/cert-manager/master/LICENSE",
      "features": [
        "从 Issuer/ClusterIssuer 申请并签发 X.509 证书",
        "将证书与私钥写入指定的 Kubernetes Secret",
        "按 duration 与 renewBefore 在到期前自动续订并重新签发",
        "支持 ACME DNS-01/HTTP-01 等签发方式（文档导航可见）"
      ],
      "deployment": [
        "作为 Kubernetes 集群内控制器运行",
        "通过 Certificate/Issuer 等自定义资源声明式管理"
      ],
      "technology_stack": [
        "Kubernetes",
        "Go"
      ],
