    {
      "id": "github:679421146",
      "name": "OpenTofu",
      "track": "open_source",
      "summary": "OpenTofu 是一个 MPL-2.0 开源基础设施即代码工具，以配置文件声明资源、生成执行计划、按依赖图执行变更，并通过状态记录管理资源生命周期。",
      "homepage": "https://opentofu.org",
      "repository_url": "https://github.com/opentofu/opentofu",
      "github_repository_id": 679421146,
      "license": "MPL-2.0",
      "license_evidence_url": "https://api.github.com/repos/opentofu/opentofu/license",
      "features": [
        "以可版本化和复用的配置文件声明期望的基础设施",
        "生成 execution plan，预览将创建、修改或销毁的资源",
        "用状态文件保存声明资源与真实对象的绑定，并据此计算后续变更",
        "基于资源依赖图并行创建/修改资源，支持 change automation 与重复 apply"
      ],
      "deployment": [
        "命令行工具；状态默认保存在本地文件，也可配置远端后端",
        "官方安装文档见 opentofu.org/docs/intro/install"
      ],
      "technology_stack": [
        "Go"
      ],
