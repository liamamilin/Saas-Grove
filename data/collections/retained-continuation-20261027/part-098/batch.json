      "leaf_matches": [
        {
          "slug": "hotel-booking-engine",
          "reason": "官方用户指南前台正文可核对完整流程：Home Page 的 Room Search Panel 按入住/离店日期与入住人数查询房量，Our Rooms 展示每晚房价并进入预订；Room Listing 按所选酒店/日期/入住人数列出可订房型、当前可用状态与每晚房价；Room Detail 的 Booking Summary 显示日期、入住人数、房价、附加服务与 Book Now；Checkout 复核房型、日期、入住人数、房价和税费后进入 Guest Information；Guest Information 支持访客结账或登录，填写姓名、邮箱和电话；Payment Information 支持全额/部分付款并点击“I confirm my order”；Booking Confirmation 显示付款与预订摘要。后台 Book Now 页面说明管理员可查看全部房态、用预订日历跟踪和管理预订，并为散客创建预订；Orders 页面说明管理员管理已收到的订单、更新付款状态并重新分配房间。因此自有渠道实时可售、客人自助捕获、预订进入物业后台三个属性均有正文证据。关系仅限预订引擎组件，不把 PMS/前台运营、渠道管理器或商业附加模块计为证据。",
          "source_urls": [
            "https://docs.qloapps.com/front_office/home_page/",
            "https://docs.qloapps.com/front_office/room_listing/",
            "https://docs.qloapps.com/front_office/room_detail/",
            "https://docs.qloapps.com/front_office/checkout/",
            "https://docs.qloapps.com/front_office/guest_information/",
            "https://docs.qloapps.com/front_office/payment_information/",
            "https://docs.qloapps.com/front_office/booking_confirmation/",
            "https://docs.qloapps.com/hrs/book_now/",
            "https://docs.qloapps.com/orders/"
          ]
        }
