      "features": [
        "记录会计交易并生成现金流等财务报表",
        "跟踪库存、补货、销售订单、客户与供应商及发货履约",
        "管理生产周期、物料消耗、产能计划与外包制造"
      ],
      "deployment": [
        "Frappe Cloud 托管",
        "Docker Compose 自托管（README 快速示例用于试用，生产配置需遵循完整文档）"
      ],
      "technology_stack": [
        "Python / JavaScript（Frappe Framework）",
        "Vue（Frappe UI）",
        "MariaDB"
      ],
