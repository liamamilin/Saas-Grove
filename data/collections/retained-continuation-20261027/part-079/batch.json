  "entries": [
    {
      "id": "github:9455072",
      "name": "TCExam",
      "track": "open_source",
      "summary": "用于创作、排期、分发和管理考试、测验与调查，并支持名册准入、限时场次与受控评分发布的开源计算机化评估系统。",
      "homepage": "https://tcexam.org/",
      "repository_url": "https://github.com/tecnickcom/tcexam",
      "github_repository_id": 9455072,
      "license": "AGPL-3.0-or-later",
      "license_evidence_url": "https://raw.githubusercontent.com/tecnickcom/tcexam/main/LICENSE",
      "features": [
        "题库、试卷与考试创作，支持随机组卷与 OMR 纸笔考试",
        "按用户组、IP 范围与考试密码控制考生准入，tce_tests_users 绑定考生与考试",
        "服务器保存并强制执行考试时长，到时自动关闭，记录 IP、答题与反应时间，可锁定/解锁/延长",
        "客观题自动评分，主观题通过 Answer Evaluation 人工评分并写评语",
        "成绩统计、结果管理与受控发布（面向考生展示、邮件、PDF/XML/TSV 导出）"
      ],
      "deployment": [
        "官方 README 为 PHP LAMP 应用，支持 Docker；本次未部署"
      ],
      "technology_stack": [
        "PHP",
        "MySQL",
        "PostgreSQL"
      ],
