    {
      "id": "github:1199643986",
      "name": "OpenConstructionERP",
      "track": "open_source",
      "summary": "OpenConstructionERP 是 AGPL-3.0 开源核心（另有可选商业许可）的自托管建筑 ERP，覆盖 BOQ 与 PDF/CAD/BIM 工程量提取、从机会到招标/比价/授标的施工前流程、合同进度款申请（含 AIA G702/G703 与保留款）、Last Planner 周计划/约束/PPC，以及 4D/5D 成本与挣值控制。",
      "homepage": "https://openconstructionerp.com",
      "repository_url": "https://github.com/datadrivenconstruction/OpenConstructionERP",
      "github_repository_id": 1199643986,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://raw.githubusercontent.com/datadrivenconstruction/OpenConstructionERP/main/LICENSE",
      "license_review": {
        "reviewer": "opencode-go/deepseek-v4.1-flash",
        "source_url": "https://raw.githubusercontent.com/datadrivenconstruction/OpenConstructionERP/main/LICENSE",
        "spdx_id": "AGPL-3.0",
        "scope": "repository",
        "rationale": "仓库根目录 LICENSE 全文为 GNU Affero General Public License Version 3（AGPL-3.0），包含完整条款与免责声明；人工核对的是整仓许可文本，而非仅依赖 API 分类或首页徽章。"
      },
      "features": [
        "PDF、DWG/DXF 与 IFC/BIM 工程量提取并汇入 BOQ",
        "Last Planner：主计划、阶段计划、六周前瞻、约束日志、周承诺、PPC 与未完成原因",
        "招标/投标包、投标人门户、逐项比价与平衡、授标",
        "合同进度款申请、SOV、AIA G702/G703、保留款与最终结算",
        "4D 进度、5D 成本模型、挣值（EVM）、完工预测与项目控制仪表板",
        "CRM 机会记录可转换为项目并进入招标"
      ],
      "deployment": [
        "Docker Compose",
        "pip install openconstructionerp",
        "Windows/macOS/Linux 桌面安装包",
        "源码开发（Python 3.12+、Node.js 22+）"
      ],
      "technology_stack": [
        "Python 3.12+/FastAPI",
        "React 18/TypeScript/Vite",
        "PostgreSQL 16+"
      ],
