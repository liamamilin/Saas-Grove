    {
      "id": "github:30856851",
      "name": "ChurchCRM",
      "track": "open_source",
      "summary": "ChurchCRM 是 MIT 许可、可自托管的开源教会管理系统；Volunteer Management v2 以事工、团队、岗位、排期 occurrence、志愿者分配状态和替换审批覆盖事工排班核心。",
      "homepage": "https://churchcrm.io",
      "repository_url": "https://github.com/ChurchCRM/CRM",
      "github_repository_id": 30856851,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/ChurchCRM/CRM/license",
      "features": [
        "事工（ministry）、团队与岗位作为可排班记录，岗位可设置 Min/Max 人数",
        "按日历事件生成排期与 occurrence，并把志愿者分配到具体日期的岗位",
        "分配状态包含 Pending、Accepted、Declined、Cancelled、Substituted、Completed，并保留历史",
        "志愿者提出已同意的替代人选，协调员或团队负责人批准或拒绝，替换写回排班记录",
        "分配后发送邮件、保留提醒队列，并提供空缺统计与事工仪表盘"
      ],
      "deployment": [
        "README 提供官方安装文档、Docker 镜像 churchcrm/crm 与自托管安装方式"
      ],
      "technology_stack": [
        "PHP（GitHub 仓库元数据列出的主要语言）"
      ],
