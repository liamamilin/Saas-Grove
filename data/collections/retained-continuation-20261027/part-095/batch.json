    {
      "id": "github:115276245",
      "name": "EcclesiaCRM",
      "track": "open_source",
      "summary": "EcclesiaCRM 是 MIT 许可、可自托管的开源教会管理系统；SundaySchool 模块以班级小组维护教师与学生，由教师逐次点名并保留出勤历史与统计。",
      "homepage": "https://ecclesiacrm.com",
      "repository_url": "https://github.com/phili67/ecclesiacrm",
      "github_repository_id": 115276245,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/phili67/ecclesiacrm/license",
      "features": [
        "SundaySchool 班级以 group 记录，分别维护 Teacher 与 Student 成员",
        "教师可按班级逐次发起 call the register，勾选/取消学生后 Validate Attendance",
        "出勤列表保留最近数月历史并附带出勤统计，可导出 CSV 或 PDF",
        "支持学生徽章/二维码点名、按性别与年龄名单及过敏等自定义属性",
        "人员、家庭、小组与事件共用同一教会记录库"
      ],
      "deployment": [
        "README 说明可自托管，测试环境为 Ubuntu Server 24.04 与 PHP 8.1 及以上；官方文档提供安装与升级说明"
      ],
      "technology_stack": [
        "PHP（GitHub 仓库元数据列出的主要语言）"
      ],
