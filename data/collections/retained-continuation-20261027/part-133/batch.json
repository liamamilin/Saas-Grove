      "id": "github:49670957",
      "name": "Eclipse RDF4J Workbench",
      "track": "open_source",
      "summary": "Eclipse RDF4J 的 Web 工作台，连接运行中的 RDF4J Server/RDF 仓库，编写并执行 SPARQL 查询与 SPARQL Update，以表格或图查看结果、分页加载并下载完整结果，同时提供 Explore、Contexts、Namespaces 与数据导出界面。",
      "homepage": "https://rdf4j.org/",
      "repository_url": "https://github.com/eclipse-rdf4j/rdf4j",
      "github_repository_id": 49670957,
      "license": "BSD-3-Clause",
      "license_evidence_url": "https://api.github.com/repos/eclipse-rdf4j/rdf4j/license",
      "features": [
        "Web-based RDF4J Workbench UI for RDF4J repositories and SPARQL endpoints",
        "SPARQL query editor with save, execute, cancel, paging and result download",
        "SPARQL 1.1 Update editor",
        "Explore resources, contexts/named graphs, namespaces and summary views",
        "Export all quads with selectable RDF serializations"
      ],
      "deployment": [
        "Java servlet web application (WAR) deployed on Tomcat or Jetty",
        "Docker Compose quick start in the source distribution's docker/ directory",
        "Self-hosted alongside RDF4J Server"
      ],
      "technology_stack": [
        "Java 25+",
        "Java Servlet / JSP container (Tomcat 9 or Jetty 9.4 recommended)",
        "Spring Boot runner for the Workbench"
      ],
