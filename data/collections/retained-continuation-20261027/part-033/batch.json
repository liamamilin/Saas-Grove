      "leaf_matches": [
        {
          "slug": "assortment-planning-application",
          "reason": "Oracle Retail Assortment Planning Cloud Service 用户指南说明：计划以 Assortment Group 组织，由 Assortment Period（定义计划窗口）与 Cluster version（门店集群）共同构成时间与地点框架；Assortment Strategy 以 option counts、attribute mix 与对齐财务目标的销售预期定义组合广度，Assortment Fit 决定哪些 style-color 分配到哪些门店集群，Item Flow 为短生命周期商品制定周销售与收货计划。流程还要求对齐 MFP 目标、为入选商品规划采购数量（Planning Buy Quantity），并以销售单位、零售额、成本与毛利衡量，最后审批组合。四项定义属性均有官方正文。",
          "source_urls": [
            "https://docs.oracle.com/en/industries/retail/retail-assortment-planning-cloud-service/26.1.201.0/apcsu/to_2523introduction.htm",
            "https://docs.oracle.com/en/industries/retail/retail-assortment-planning-cloud-service/25.1.201.0/apcsu/to_assortment_planning.htm"
          ]
        }
      ],
