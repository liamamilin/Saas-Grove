      "id": "github:146009627",
      "name": "ArkCase",
      "track": "open_source",
      "summary": "ArkCase 社区版是面向政府与公共部门案件管理的开源平台，提供案件与文档 360° 视图、可配置任务/审批工作流、队列、检索报表与集成能力；企业版另提供扩展支持与高可用等商业能力。",
      "homepage": "https://www.arkcase.com/",
      "repository_url": "https://github.com/ArkCase/ArkCase",
      "github_repository_id": 146009627,
      "license": "LGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/ArkCase/ArkCase/license",
      "features": [
        "案件、文档与记录的统一 360° 视图",
        "可配置的审批、任务与工作流自动化",
        "队列与通信、文档管理",
        "元数据与全文检索、报表与分析",
        "FOIA、投诉、事件、法律案件等预置解决方案",
        "REST 接口及日历、LDAP、邮件、ECM/CRM 集成"
      ],
      "deployment": [
        "本地部署",
        "混合部署",
        "云部署"
      ],
      "technology_stack": [
        "Java",
