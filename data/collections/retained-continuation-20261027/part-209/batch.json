    {
      "id": "github:16999809",
      "name": "openSenseMap",
      "track": "open_source",
      "summary": "openSenseMap 是开源的环境传感器数据发布与可视化平台：以 senseBox 为监测点，持续接收传感器测量，提供站点最新读数、历史测量查询和多站点聚合统计；本条目以 MIT 许可的 API 后端为身份，展示层由同为 MIT 的独立前端提供。",
      "homepage": "https://opensensemap.org/",
      "repository_url": "https://github.com/sensebox/openSenseMap-API",
      "github_repository_id": 16999809,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/sensebox/openSenseMap-API/license",
      "features": [
        "senseBox 监测点注册、位置与归属管理",
        "传感器最新测量与按时间段查询历史测量",
        "多监测点/标签聚合及描述统计、IDW 插值接口",
        "JWT 用户认证与设备转移"
      ],
      "deployment": [
        "Node.js 16、MongoDB 与 Docker Compose 自托管",
        "README 引用 OSeM-compose 作为整套平台部署方式"
      ],
      "technology_stack": [
        "Node.js",
        "MongoDB",
        "Docker"
      ],
