    {
      "id": "github:12462033",
      "name": "openLCA",
      "track": "open_source",
      "summary": "openLCA 是 GreenDelta 开发的开源生命周期评估桌面应用：构建由量化单元过程连接而成的产品系统，计算生命周期清单，并选择 LCIA 方法得到环境影响结果；同时提供图形化建模、分配/系统扩展、贡献树、Sankey、不确定性与导入导出功能。桌面端可本地自托管使用，协作服务器与在线产品为可选配套。",
      "homepage": "https://www.openlca.org/",
      "repository_url": "https://github.com/GreenDelta/olca-app",
      "github_repository_id": 12462033,
      "license": "MPL-2.0",
      "license_evidence_url": "https://api.github.com/repos/GreenDelta/olca-app/license",
      "features": [
        "图形化/自动构建产品系统并连接单元过程供应链",
        "生命周期清单（LCI）计算与可选 LCIA 方法的影响评价",
        "分配与系统扩展、参数分析、Monte Carlo、贡献树、Sankey 图",
        "ILCD、EcoSpold、JSON-LD、zolca 数据库导入导出与 IPC API",
        "可与 LCA Collaboration Server 协作，但桌面核心可独立运行"
      ],
      "deployment": [
        "Windows/Linux/macOS 桌面发行包",
        "可从 Java/Eclipse RCP 源码构建",
        "本地数据库运行；LCA Collaboration Server 为独立可选服务"
      ],
      "technology_stack": [
        "Java",
        "Eclipse Rich Client Platform (RCP)",
        "SQL/Jython 脚本与 REST/gRPC IPC"
      ],
