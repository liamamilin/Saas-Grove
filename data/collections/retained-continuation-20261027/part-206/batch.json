    {
      "id": "github:202363022",
      "name": "Energy Web Origin",
      "track": "open_source",
      "summary": "Energy Web Origin 是用于能源属性证书（EAC/GO/REC/I-REC）签发与管理的开源工具集：包含设备/组织注册、证书申请与签发、账户间转移、声明/注销、声明报告与交易所组件，并提供可部署的 UI 与后端。其声明报告可追溯到证书 ID、已声明电量、受益方与链上交易历史。",
      "homepage": "https://www.energyweb.org/",
      "repository_url": "https://github.com/energywebfoundation/origin",
      "github_repository_id": 202363022,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/energywebfoundation/origin/license",
      "features": [
        "证书申请、签发、转移、声明/注销与撤销的 REST 接口",
        "设备/组织注册与 I-REC 兼容的注册表模块",
        "Claims Report：查看退役并声明用于报告的证书、已声明/剩余电量、受益方与链上交易历史",
        "交易所与 ERC-1888 存取组件",
        "可部署的 React UI 与 NestJS 后端"
      ],
      "deployment": [
        "Docker/Heroku 演示环境；本地 UI 默认 localhost:3000",
        "Rush monorepo 构建；前端、后端、issuer 与 exchange 组件按需组合部署",
        "可选 I-REC API 连接器"
      ],
      "technology_stack": [
        "TypeScript",
        "NestJS",
        "React",
        "PostgreSQL",
        "ERC-1888 区块链证书",
        "Rush monorepo"
      ],
