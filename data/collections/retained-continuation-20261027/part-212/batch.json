  "entries": [
    {
      "id": "github:679584",
      "name": "OpenEMR",
      "track": "open_source",
      "summary": "OpenEMR 是开源电子健康记录与医疗实践管理应用；官方功能页与用户指南记录患者图表、问题/诊断、药物、SOAP/临床笔记、encounter 组织以及登录与角色访问控制，并提供实践管理、预约调度与电子计费。",
      "homepage": "https://open-emr.org/",
      "repository_url": "https://github.com/openemr/openemr",
      "github_repository_id": 679584,
      "license": "GPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/openemr/openemr/license",
      "features": [
        "集成 EHR 患者图表：患者人口学与 Patient Summary、问题/诊断、药物、SOAP/临床笔记",
        "Encounter 组织诊疗记录，并可把问题与 encounter 关联",
        "登录与角色权限：基于角色菜单、细粒度逐用户访问控制，未授权用户无法查看问题、免疫与处方",
        "实践管理、预约调度与电子计费",
        "国际化与多平台部署支持",
        "Procedures 模块支持实验室、影像与操作类医嘱的创建、传输、审阅及签署后结果回链"
      ],
      "deployment": [
        "官方 README 与文档支持在 Windows、Linux、macOS 等平台自托管部署",
        "官方提供 Docker 部署说明"
      ],
      "technology_stack": [
        "PHP",
        "JavaScript",
        "Docker"
      ],
