      "leaf_matches": [
        {
          "slug": "electronic-health-record-ehr",
          "reason": "OpenEMR 官方 Features 页与用户指南记录：患者人口学与 Patient Summary；Medical Issues（文档明确 issue 为 medical problem、allergy、medication 等）与 Encounter 关联；Medications；SOAP/临床笔记；encounters 与 past encounters；登录后按 provider 工作，未授权用户无法查看问题、免疫与处方，Features 页并称基于角色菜单与细粒度逐用户访问控制。据此匹配以已识别患者纵向图表、问题/药物/笔记、encounter 组织与角色限制访问为核心的 EHR 定义。",
          "source_urls": [
            "https://api.github.com/repos/openemr/openemr",
            "https://api.github.com/repos/openemr/openemr/license",
            "https://raw.githubusercontent.com/openemr/openemr/master/README.md",
            "https://www.open-emr.org/wiki/index.php/OpenEMR_Features",
            "https://www.open-emr.org/wiki/index.php/Issues_%26_Immunizations_4.1",
            "https://www.open-emr.org/wiki/index.php/New_Encounters_%26_Coding_4.1",
            "https://www.open-emr.org/wiki/index.php/Patient_Notes_%26_Transactions_4.1"
          ]
        },
        {
          "slug": "cpoe-clinical-order-management",
          "reason": "OpenEMR 仓库内 Procedures 帮助明确该模块用于 place and review orders，并说明其满足实验室与影像 CPOE，覆盖 Procedure、Laboratory Test、Imaging 等可开项；官方 wiki 记录医嘱可保存/传输、进入 pending review、更新状态，并在签署后回写患者结果与 encounter。关系限定在检查、影像与操作类医嘱的创建、传输、审阅与签署后结果回链；所引帮助文件中的 Canceled 属于 Procedure Report/Result Statuses，仅表示报告/结果取消状态，不作为医嘱停用证据；不主张药物医嘱修订/续开/停用或开嘱医生归属。",
          "source_urls": [
            "https://raw.githubusercontent.com/openemr/openemr/master/README.md",
            "https://raw.githubusercontent.com/openemr/openemr/master/Documentation/help_files/procedure_provider_help.php",
