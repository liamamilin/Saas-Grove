    {
      "id": "github:1150018630",
      "name": "OpenCTEM",
      "track": "open_source",
      "summary": "开源持续威胁暴露管理（CTEM）平台，将资产发现、风险排序、安全验证与修复闭环放在同一套 Go API + Next.js 控制台中；以传感器安全检查复验与复测证据驱动发现项关闭，支持自托管或官方云。",
      "homepage": "https://openctem.io/",
      "repository_url": "https://github.com/openctemio/openctem",
      "github_repository_id": 1150018630,
      "license": "GPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/openctemio/openctem/license",
      "features": [
        "持续暴露面发现与资产清单",
        "多格式结果合并去重与风险排序",
        "传感器安全复验、复测与回归重开",
        "修复任务、SLA 与 Jira/GitHub 同步"
      ],
      "deployment": [
        "Docker Compose",
        "all-in-one 容器",
        "Kubernetes Helm",
        "自托管或官方云服务"
      ],
      "technology_stack": [
        "Go API",
        "Next.js Web 控制台",
        "PostgreSQL",
        "Redis"
      ],
