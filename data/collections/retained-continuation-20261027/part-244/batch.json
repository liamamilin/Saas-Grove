      "id": "github:459095253",
      "name": "LinkStack",
      "track": "open_source",
      "summary": "开源自托管的 Link-in-Bio/链接聚合平台：用户通过管理面板维护有序外链与主题，在自托管实例或托管实例上发布个人链接页，替代社交资料中的单一链接；采用 AGPL-3.0，社区核心可自托管，官方亦提供付费托管套餐。",
      "homepage": "https://linkstack.org/",
      "repository_url": "https://github.com/LinkStackOrg/LinkStack",
      "github_repository_id": 459095253,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/LinkStackOrg/LinkStack/license",
      "features": [
        "有序外链链接页",
        "多用户与单用户模式",
        "主题自定义",
        "管理面板",
        "点击分析",
        "数据导入导出",
        "内置 SMTP"
      ],
      "deployment": [
        "自托管 Web 服务器（PHP 8 + Apache/Nginx）",
