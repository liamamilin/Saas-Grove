    {
      "id": "github:4917029",
      "name": "PhotoDemon",
      "track": "open_source",
      "summary": "PhotoDemon 是便携式开源照片编辑器：打开相机原图后用图层、调整与滤镜修改曝光、色调、色彩与几何，实时预览并保存导出为常见格式。",
      "homepage": "https://photodemon.org",
      "repository_url": "https://github.com/tannerhelland/PhotoDemon",
      "github_repository_id": 4917029,
      "license": "BSD-2-Clause",
      "license_evidence_url": "https://api.github.com/repos/tannerhelland/PhotoDemon/license",
      "features": [
        "多图层与可编辑文本图层",
        "色阶、曲线、阴影/高光、白平衡等调整",
        "透视校正、降噪、内容感知填充等滤镜",
        "色彩管理与 ICC 配置支持",
        "宏录制与文件夹批处理",
        "支持 PSD、XCF、PSP 与主流 RAW"
      ],
      "deployment": [
        "Windows 便携应用，无需安装",
        "可从 USB/SD 卡运行"
      ],
      "technology_stack": [
        "Visual Basic 6.0"
      ],
