    {
      "id": "github:934441434",
      "name": "Atlas CMMS",
      "track": "open_source",
      "summary": "Self-hosted CMMS for assets, work orders and maintenance history. The AGPL-3.0 codebase documents asset/location registers, work orders with labor and history, preventive maintenance, service requests and a React Native mobile app; inventory/purchasing and some enterprise or white-label features may be edition- or license-gated.",
      "homepage": "https://atlas-cmms.com/",
      "repository_url": "https://github.com/Grashjs/cmms",
      "github_repository_id": 934441434,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/Grashjs/cmms/license",
      "features": [
        "Asset, equipment and location register with maintenance history",
        "Work order creation, assignment, priority, time logging and closure records",
        "Preventive maintenance and automated work-order triggers",
        "Service requests and custom roles/permissions",
        "Parts inventory and purchasing capabilities described in the README (edition/license gating may apply)",
        "Web dashboard plus React Native mobile app"
      ],
      "deployment": [
        "Self-hosted Docker Compose deployment (README quick start)",
        "Cloud-hosted service optionally available at atlas-cmms.com"
      ],
      "technology_stack": [
        "Java Spring Boot backend",
        "React/TypeScript web frontend",
        "React Native mobile app"
      ],
