      "id": "github:981534981",
      "name": "LGDXRobot Cloud",
      "track": "open_source",
      "summary": "Open-source web-based fleet management system for autonomous mobile robots: robot and fleet registration, real-time status and map monitoring, task creation/prioritization/assignment, multi-fleet operation, SLAM mapping, notifications and role-based access, with Docker Compose self-hosting.",
      "homepage": "https://lgdxrobot.uk/cloud/",
      "repository_url": "https://github.com/yukaitung/lgdxrobot-cloud",
      "github_repository_id": 981534981,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/yukaitung/lgdxrobot-cloud/license",
      "features": [
        "Robot and fleet setup/configuration with live status",
        "Real-time map monitoring of robot location, status and planned path",
        "Task and mission creation with priority and assignment to specific robots",
        "Multi-fleet management across rooms/floors from one instance",
        "SLAM map generation, navigation rules and workflow triggers",
        "Email notifications, API keys, 2FA and certificate-based robot authentication"
      ],
      "deployment": [
        "Docker Compose self-hosted deployment (README fast setup)",
        "Any ROS 2 compatible robot via the LGDXRobot Cloud Adapter"
      ],
      "technology_stack": [
        ".NET ASP.NET Web API backend",
        "Blazor frontend",
        "RabbitMQ, Redis and PostgreSQL",
        "gRPC robot communication"
      ],
