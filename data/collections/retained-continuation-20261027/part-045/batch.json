      "id": "commercial:dealhub",
      "name": "DealHub",
      "track": "commercial",
      "summary": "面向 B2B 销售的 CPQ 与收入编排平台，以引导式配置、自适应价格簿和审批工作流生成可修订的报价，并与主流 CRM 同步。",
      "homepage": "https://dealhub.io",
      "sources": [
        {
          "url": "https://dealhub.io/platform/cpq/",
          "sha256": "c3b092a106711ff244b3efa7e85468c9cfb3483dad431ed28d7773176529f914",
          "snapshot_path": "sources/c3b092a106711ff244b3efa7e85468c9cfb3483dad431ed28d7773176529f914.txt",
          "fetched_at": "2026-10-24T18:44:41.262082+08:00",
          "kind": "documentation"
        }
      ],
      "leaf_matches": [
        {
          "slug": "configure-price-quote-cpq",
          "reason": "DealHub 官方 CPQ 产品页列出引导式报价配置（guided selling、结构化产品与筛选）、可承载用量/分层/固定计价的自适应价格簿、可配置捆绑与折扣、按报价行实时调整并保留版本化订单表单、自动化审批工作流，以及与 Salesforce、Dynamics 365、HubSpot 的实时报价/产品/交易数据同步。这些功能说明其在产品目录与规则约束下组装报价、由系统按价格规则计算，并生成可修订、可审批的报价记录；Configure/Price/Quote 三段仅按该产品页所列能力描述，不引用术语表的品类通识。缺口：产品目录的兼容规则细节与报价接受后的下游转换未在该页说明。",
          "source_urls": [
            "https://dealhub.io/platform/cpq/"
          ]
        }
      ],
      "verification_status": "official_sources_reviewed",
      "runtime_tested": false
    },
