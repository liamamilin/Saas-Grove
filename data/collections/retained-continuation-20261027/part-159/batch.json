    {
      "id": "github:12776324",
      "name": "frePPLe",
      "track": "open_source",
      "summary": "frePPLe 社区版是开源的需求预测与生产计划/排程（APS）应用：将销售订单与统计预测汇总为需求，按库存、BOM/工艺路线和产能生成分时段计划与详细排程，计划员可在甘特图中调整，并可通过 Odoo 连接器把计划回写为生产/采购订单。社区版 MIT；企业版与云版为商业扩展。",
      "homepage": "https://frepple.com",
      "repository_url": "https://github.com/frePPLe/frepple",
      "github_repository_id": 12776324,
      "license": "MIT",
      "license_evidence_url": "https://raw.githubusercontent.com/frePPLe/frepple/master/COPYING",
      "license_review": {
        "reviewer": "opencode-go/deepseek-v4.1-flash",
        "source_url": "https://raw.githubusercontent.com/frePPLe/frepple/master/COPYING",
        "spdx_id": "MIT",
        "scope": "community_core",
        "rationale": "仓库 COPYING 含完整 MIT 许可文本，并明确 Community Edition 使用 MIT；Enterprise 与 Cloud 为商业版本，故 scope 取 community_core。"
      },
      "features": [
        "统计需求预测、异常值处理与预测消耗",
        "生产计划与排程：约束/非约束计划、前后向排程、甘特图调整",
        "BOM 与工艺路线、替代资源、换型矩阵",
        "物料/产能净算与瓶颈约束",
        "通过 Odoo 等连接器发布生产/采购订单",
        "Web 界面、REST API 与多语言"
      ],
      "deployment": [
        "自托管 Linux/Ubuntu",
        "Docker 容器",
        "源代码安装"
      ],
      "technology_stack": [
        "Python",
        "Django",
        "PostgreSQL",
        "C++",
        "AngularJS"
      ],
