    {
      "id": "github:867131396",
      "name": "Utility Billing & Property Management (ERPNext)",
      "track": "open_source",
      "summary": "ERPNext 的开源公用事业计费与物业管理子模块（AGPL-3.0），提供公用事业服务申请、抄表用量计算、费率与批量开票，并接入 ERPNext 的销售订单、发票与收款；同样覆盖物业/租户计费。",
      "homepage": "https://github.com/navariltd/utility-billing",
      "repository_url": "https://github.com/navariltd/utility-billing",
      "github_repository_id": 867131396,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/navariltd/utility-billing/license",
      "features": [
        "服务申请→勘察→BOM→销售订单",
        "抄表读数与用量自动计算",
        "价格清单/费率与客户分组",
        "批量计费与按客户合并发票",
        "销售订单→发票→收款（ERPNext 会计）",
        "物业、租约与租户公用事业计费"
      ],
      "deployment": [
        "Frappe Bench 自托管",
        "安装于 ERPNext 站点"
      ],
      "technology_stack": [
        "Python",
        "Frappe Framework",
        "ERPNext",
        "MariaDB"
      ],
