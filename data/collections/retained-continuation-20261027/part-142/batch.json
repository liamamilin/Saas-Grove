    {
      "id": "github:378310716",
      "name": "Logto",
      "track": "open_source",
      "summary": "Logto 是 MPL-2.0 开源的客户身份与访问管理平台，面向 SaaS 与 AI 应用提供终端用户注册与注册确认、登录、密码找回、账户设置、OIDC/OAuth 2.1、面向终端用户的多租户、RBAC、管理 Console、外部 IdP 连接器与 30+ SDK。账户删除可由 Management API 管理端执行，或由开发者在自有自助端点中封装。OSS 覆盖多数核心能力；Console 多租户、Console 协作者邀请、Console MFA、IdP 发起 SSO、内置邮件服务、Protected App、隐藏 Logto 品牌与无限 SAML 应用属 Cloud 或需自托管许可，OSS 的 SAML 应用上限为 3。",
      "homepage": "https://logto.io/",
      "repository_url": "https://github.com/logto-io/logto",
      "github_repository_id": 378310716,
      "license": "MPL-2.0",
      "license_evidence_url": "https://raw.githubusercontent.com/logto-io/logto/master/LICENSE",
