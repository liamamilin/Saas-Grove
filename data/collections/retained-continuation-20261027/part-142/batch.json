    {
      "id": "github:332880689",
      "name": "Coolify",
      "track": "open_source",
      "summary": "Coolify 是 Apache-2.0 开源、可自托管的 PaaS 管理控制台：以应用为记录单元，从 Git 构建并部署应用，保留应用镜像用于回滚，并提供环境变量/密钥、域名与自动 HTTPS、部署/运行日志及团队权限。它同时暴露服务器与容器终端，和容器管理的边界有重叠，本次仅以应用部署与发布回滚等应用粒度能力作为类型匹配依据。",
      "homepage": "https://coolify.io/",
      "repository_url": "https://github.com/coollabsio/coolify",
      "github_repository_id": 332880689,
      "license": "Apache-2.0",
      "license_evidence_url": "https://raw.githubusercontent.com/coollabsio/coolify/main/LICENSE",
      "license_review": {
        "reviewer": "collection-editor",
        "source_url": "https://raw.githubusercontent.com/coollabsio/coolify/main/LICENSE",
        "spdx_id": "Apache-2.0",
        "scope": "repository",
        "rationale": "完整读取仓库根目录 LICENSE，正文为 Apache License Version 2.0 全文，包含 Terms and Conditions 与 limitations under the license，按仓库整体适用 Apache-2.0。"
      },
      "features": [
        "从 GitHub/GitLab/Bitbucket/Gitea 或 Dockerfile/Docker Compose 构建并部署应用",
        "保留应用镜像并回滚到先前部署",
        "环境变量、密钥、域名与自动 HTTPS 管理",
        "部署与运行日志、资源状态监控",
        "控制台、API、CLI 与团队级访问控制"
      ],
      "deployment": [
        "官方安装脚本部署到自有服务器",
        "官方托管 Coolify Cloud 选项"
      ],
      "technology_stack": [
        "Docker",
        "Nixpacks",
        "Railpack",
        "Docker Compose"
      ],
