  "entries": [
    {
      "id": "github:16508135",
      "name": "farmOS",
      "track": "open_source",
      "summary": "GPL-2.0 开源、可自托管的农场记录与计划 Web 应用；以 Land 资产保存地块，以 Plant 资产和日志承载作物季（非独立对象）的种植、投入、观察与收获，并支持计划/实际状态与历史留存。",
      "homepage": "https://farmos.org",
      "repository_url": "https://github.com/farmOS/farmOS",
      "github_repository_id": 16508135,
      "license": "GPL-2.0",
      "license_evidence_url": "https://api.github.com/repos/farmOS/farmOS/license",
      "features": [
        "Land 资产表示地块、田块、苗床和牧场，可映射并层级组织",
        "Plant 资产按作物/品种表示种植批次，支持精细作物计划与记录",
        "Seeding、transplanting、input、observation、harvest、lab test 等日志",
        "日志状态 pending/done/abandoned，支持计划与实际对比",
        "资产可归档；归档资产可在资产列表用 Filters 检索"
      ],
      "deployment": [
        "自托管 Web 应用，官方提供安装指南",
        "官方 Docker 镜像",
        "README 另提及 Farmier 付费托管；未说明社区版/企业版功能切分"
      ],
      "technology_stack": [
        "PHP",
        "Drupal",
        "Docker"
      ],
