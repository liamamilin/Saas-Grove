      },
      "features": [
        "客户（业主）账户与多宠物患者档案",
        "按医生/诊室排班的预约及到诊/就诊/结账状态流",
        "SOAP 病历、问题列表、疫苗、化验、处方与附件",
        "服务/产品目录、估价转发票、付款与账户余额",
        "库存、受控药品、报表与客户门户"
      ],
      "deployment": [
        "Docker Compose 自托管（PostgreSQL 16 + MinIO）",
        "Vercel 云托管",
        "pnpm/Turborepo 单仓构建，含数据库迁移脚本"
      ],
      "technology_stack": [
        "Next.js 15 / React 19 / TypeScript",
        "PostgreSQL 16 + Drizzle ORM",
        "tRPC + /api/v1 REST API",
        "NextAuth.js 与 Stripe"
      ],
