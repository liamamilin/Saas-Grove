      "leaf_matches": [
        {
          "slug": "legal-matter-management",
          "reason": "README 说明系统以“收案登记→冲突检索→转正式案件→持续跟进→财务记录→结案归档→数据导出”组织律所案件，并提供案件档案、办案进程、委托与财务、审批、岗位/团队与归档；DATA-MODEL 把 Matter 定义为法律争议或非诉项目的持久容器，挂客户、案由、标的、状态、合同、财务、沟通，并以 MatterProcedure/MatterStage/Task/Hearing/Deadline/Document 承载案卷。据此符合事务为记录单位、累积案卷、人员与状态受管的定义核心。",
          "source_urls": [
            "https://raw.githubusercontent.com/lawflow-boop/LawLink/main/README.md",
            "https://raw.githubusercontent.com/lawflow-boop/LawLink/main/docs/DATA-MODEL.md"
          ]
        },
        {
          "slug": "litigation-management-platform",
          "reason": "DATA-MODEL 将诉讼细分民商事/刑事/行政，MatterProcedure 记录一审/二审/再审/仲裁/执行等程序及独立案号、法院/仲裁机构、立案日、结案日与结果；Party 以 CLIENT_PARTY/OPPOSING_PARTY/THIRD_PARTY/CO_LITIGANT/AGENT/WITNESS 等角色记录当事人与代理人，ProcedureParty 记录同一当事人不同程序中的诉讼地位；MatterStage 下挂 Hearing/Deadline/Document，Document 设 EVIDENCE 证据材料类别。README 当前版还列出法院来件、期限与提醒、办案进程和案件档案。据此可匹配诉讼案件持久记录、当事人/代理、法院/程序态势、阶段、期限与证据案卷层的核心；未把资料未明确的证据开示请求/制作清单写成已实现。",
          "source_urls": [
            "https://raw.githubusercontent.com/lawflow-boop/LawLink/main/README.md",
            "https://raw.githubusercontent.com/lawflow-boop/LawLink/main/docs/DATA-MODEL.md"
          ]
        }
