    {
      "id": "github:1199643986",
      "name": "OpenConstructionERP",
      "track": "open_source",
      "summary": "开源、自托管的建筑 ERP，提供分层 BOQ 估算、ISO 19650 CDE 与文档发行、现场日记录/缺陷清单、人员与现场工时，以及采购收货和现场材料库存等模块。",
      "homepage": "https://openconstructionerp.com",
      "repository_url": "https://github.com/datadrivenconstruction/OpenConstructionERP",
      "github_repository_id": 1199643986,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/datadrivenconstruction/OpenConstructionERP/license",
      "features": [
        "层级 BOQ 估算：章节/位置、数量×单价、资源与 assemblies、markups 和总计",
        "ISO 19650 CDE：受控修订、WIP/Shared/Published/Archived 状态、适用性代码与状态级访问控制",
        "文档 transmittals：收件人、发送/接收/回执跟踪和已废止修订提醒",
        "现场日记录：daily diary、field reports、照片/视频与签名归档",
        "缺陷与质量闭环：punch list、inspections、NCR 及验证状态",
        "劳务资源：人员/班组技能与可用性、带成本编码的现场工时、工资批次草稿",
        "材料流动：采购订单、收货单、现场材料移动与在手库存"
      ],
      "deployment": [
        "自托管 Web 应用（pip install openconstructionerp）",
        "Docker 镜像 ghcr.io/datadrivenconstruction/openconstructionerp",
        "Windows/macOS/Linux 桌面安装包"
      ],
      "technology_stack": [
        "React 前端",
        "FastAPI 后端",
        "PostgreSQL"
      ],
