      "id": "github:161860953",
      "name": "Resgrid Core",
      "track": "open_source",
      "summary": "面向消防、EMS、救援与应急管理团队的开源自托管计算机辅助调度（CAD）与运营平台；支持事件/呼叫创建、人员与单位状态跟踪、AVL 地图、值班、通知和运行记录，托管版使用同一代码库。",
      "homepage": "https://resgrid.com/",
      "repository_url": "https://github.com/Resgrid/Core",
      "github_repository_id": 161860953,
      "license": "Apache-2.0",
      "license_evidence_url": "https://raw.githubusercontent.com/Resgrid/Core/master/LICENSE",
      "license_review": {
        "reviewer": "opencode-go/deepseek-v4.1-flash",
