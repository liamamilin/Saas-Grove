        "spdx_id": "Apache-2.0",
        "scope": "repository",
        "rationale": "完整 Apache License 2.0 原文由本仓库 master 分支 LICENSE 直接取得，含明确的许可证标题、版本 2.0 与责任限制条款，仓库范围适用。"
      },
      "features": [
        "计算机辅助调度：创建事件/呼叫并人工或自动派遣人员、单位、角色或小组",
        "人员、单位、小组与驻地的状态、可用性和问责记录",
        "AVL 地图与 BigBoard 实时状态板（人员/单位状态、呼叫、地图）",
        "值班、消息/聊天、通知、部门链接与互援协作",
        "运行记录、报告、检查清单、库存、文档存储与记录管理（RMS）"
      ],
      "deployment": [
        "自托管：Docker、Kubernetes/k3s、Windows 桌面",
        "托管 SaaS 版与开源自托管版使用同一代码库"
      ],
      "technology_stack": [
        "Web 应用",
        "REST API",
        "iOS/Android 移动应用",
        "Docker/Kubernetes 自托管"
      ],
