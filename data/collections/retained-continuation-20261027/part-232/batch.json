    {
      "id": "github:72849464",
      "name": "Primero",
      "track": "open_source",
      "summary": "开源核心 Primero 是面向儿童保护与社会工作者的个案管理应用，公开核心覆盖个案/事件、寻亲、转介与记录分配，以及儿童-家庭关联、保护关注、风险等级、评估/个案计划审批、照护安排与重新团聚记录；CPIMS+/GBVIMS+ 配置包需另行申请，不在开源核心内。公开证据未覆盖正式筛查决定及收养等永久性流程。",
      "homepage": "https://www.primero.org",
      "repository_url": "https://github.com/primeroIMS/primero",
      "github_repository_id": 72849464,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/primeroIMS/primero/license",
      "license_review": {
        "reviewer": "opencode-go/deepseek-v4.1-flash (初审后修正)",
        "source_url": "https://api.github.com/repos/primeroIMS/primero/license",
        "spdx_id": "AGPL-3.0",
        "scope": "community_core",
        "rationale": "LICENSE 全文为 GNU AGPL v3，前言写明可按 version 3 或任何更晚版本使用；GitHub license API 将其分类为 AGPL-3.0，本条目沿用该 SPDX 分类。LICENSE 前言与仓库 description 均说明 CPIMS+/GBVIMS+ 配置 JSON 包需另行联系获取，因此仅对开源代码核心记录，不把受限配置包计入开源范围。"
      },
      "features": [
        "儿童保护个案记录",
        "事件（incident）记录及与个案的关联",
        "寻亲请求、追踪与潜在匹配",
        "转介、分配与记录转移",
        "附件与记录标记",
        "儿童与家庭/照顾者关联记录（Child、Family 模型）",
        "保护关注、风险等级及评估/个案计划到期记录（Child 模型）",
        "评估、个案计划与结案的监督审批（Approval）",
        "照护安排（安置类型/照顾者/起始日期）与重新团聚记录"
      ],
      "deployment": [
        "Ansible 生产部署",
        "Docker Compose 开发/评估部署",
        "PostgreSQL 14/15（README：14 为默认，15 自 v2.10 起支持）"
      ],
      "technology_stack": [
        "Ruby",
        "PostgreSQL",
        "Ansible",
        "Docker Compose"
      ],
