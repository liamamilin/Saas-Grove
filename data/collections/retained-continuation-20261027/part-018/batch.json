    {
      "id": "github:202983854",
      "name": "Pixelorama",
      "track": "open_source",
      "summary": "Pixelorama 是像素画与精灵动画编辑器：在刻意限制的小画布上逐像素绘制，管理调色板与帧/图层，导出 PNG、动画 PNG、GIF、精灵表或视频。",
      "homepage": "https://www.pixelorama.org",
      "repository_url": "https://github.com/Orama-Interactive/Pixelorama",
      "github_repository_id": 202983854,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/Orama-Interactive/Pixelorama/license",
      "features": [
        "可将工具映射到左右鼠标键的像素绘制工具箱",
        "像素完美线条、索引模式与像素专用缩放算法",
        "图层与帧时间轴、洋葱皮、帧标签",
        "平铺模式与等距网格",
        "导出 PNG、动画 PNG、GIF、精灵表与视频"
      ],
      "deployment": [
        "桌面版支持 Windows、Linux、macOS",
        "提供 Web 版与 Steam/itch.io 分发",
        "提供命令行自动化导出"
      ],
      "technology_stack": [
        "GDScript",
        "Godot"
      ],
