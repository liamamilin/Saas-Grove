        "动物资产可按个体或头数（head count）记录",
        "动物可组织为群体/畜群（Group 资产）",
        "出生与医疗日志",
        "移动与位置日志",
        "库存随日志记录对账"
      ],
      "deployment": [
        "自托管部署（官方安装/托管指南）"
      ],
      "technology_stack": [
        "Drupal",
        "PHP"
      ],
