    {
      "id": "github:73817618",
      "name": "Animal Shelter Manager (ASM3)",
      "track": "open_source",
      "summary": "Animal Shelter Manager (ASM3) 是 GPL-3.0 的动物收容所管理应用，围绕动物个体记录、入所/在护/结果的移动记录、医疗与人员记录及报告发布运行。",
      "homepage": "https://sheltermanager.com/",
      "repository_url": "https://github.com/sheltermanager/asm3",
      "github_repository_id": 73817618,
      "license": "GPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/sheltermanager/asm3/license",
      "features": [
        "动物个体记录，含名称/代码、品种、微芯片、地点与状态",
        "入所与领养、转出、归还、寄养等移动记录，同一动物仅一个未归还移动",
        "疫苗、检测、医疗、日誌、费用与死亡记录",
        "人员、领养人、寄养人与工作人员记录",
        "报告、文档模板与网站/第三方领养平台发布"
      ],
      "deployment": [
        "Linux/Unix 自托管，提供 Debian/Ubuntu 包与源码包",
        "Apache/WSGI 运行 Python 应用，可连接 MySQL、PostgreSQL 或 SQLite"
      ],
      "technology_stack": [
        "Python 3",
        "HTML5",
        "Apache/WSGI",
        "MySQL/PostgreSQL/SQLite"
      ],
