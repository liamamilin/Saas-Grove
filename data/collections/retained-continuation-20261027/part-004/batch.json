      "leaf_matches": [
        {
          "slug": "discussion-board",
          "reason": "Discourse 官方 README 把 “Create discussion topics” 列为用户可执行的操作；官方功能页说明它是扁平论坛、回复沿页面成线排布并可展开上下文，并列出自动/自定义头像与帖子修订历史；官方界面文案给出 “Create Topic” 与 “Posted by <a ...>%{user}</a>”。成员可开启主题、他人随时间异步追加回复、线程持久可读，帖子带显示作者与修订记录，符合在线讨论板。",
          "source_urls": [
            "https://www.discourse.org/features",
            "https://raw.githubusercontent.com/discourse/discourse/main/README.md",
            "https://raw.githubusercontent.com/discourse/discourse/main/config/locales/client.en.yml"
          ]
        },
        {
          "slug": "private-community-platform",
          "reason": "Discourse 官方设置文案对 login required 的说明是 “Require authentication to read content on this site, disallow anonymous access”，即整站内容要求登录后才能阅读；同一文案说明 invite only 下新用户必须由受信用户或员工明确邀请、公开注册关闭。整站禁止匿名阅读、仅受邀可加入，加上成员在主题空间内发帖，构成场所层面的成员/非成员边界。",
          "source_urls": [
            "https://www.discourse.org/features",
            "https://raw.githubusercontent.com/discourse/discourse/main/config/locales/server.en.yml"
          ]
        }
      ],
