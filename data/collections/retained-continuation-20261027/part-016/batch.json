    {
      "id": "github:1190598050",
      "name": "Yuvomi",
      "track": "open_source",
      "summary": "Yuvomi 是自托管家庭/个人事务管理器：任务、日历、笔记、联系人、预算、餐食等模块共用一个 SQLite 数据库，模块间通过记录属性互相引用。",
      "homepage": "https://yuvomi.cloud",
      "repository_url": "https://github.com/ulsklyc/yuvomi",
      "github_repository_id": 1190598050,
      "license": "MIT",
      "license_evidence_url": "https://api.github.com/repos/ulsklyc/yuvomi/license",
      "features": [
        "任务（看板、截止日期、子任务、重复事项）",
        "日历同步与单事件可见性",
        "笔记、联系人、生日、健康记录",
        "预算、账目、共享支出与债务简化",
        "模块共用同一 SQLite 数据库并互相引用"
      ],
      "deployment": [
        "Docker 或 Podman 容器部署",
        "提供浏览器引导安装，也支持 NAS 应用商店",
        "单文件 SQLite 数据库，可整体复制备份"
      ],
      "technology_stack": [
        "Node.js",
        "SQLite",
        "Docker"
      ],
      "sources": [
