    {
      "id": "github:57224308",
      "name": "ActivityWatch",
      "track": "open_source",
      "summary": "ActivityWatch 是本地优先的自动时间追踪器：watcher 持续记录前台应用、窗口标题与浏览器标签，形成可查询的事件时间线，并用用户可编辑的分类规则把时间归入工作/娱乐等类别。",
      "homepage": "https://activitywatch.net",
      "repository_url": "https://github.com/ActivityWatch/activitywatch",
      "github_repository_id": 57224308,
      "license": "MPL-2.0",
      "license_evidence_url": "https://api.github.com/repos/ActivityWatch/activitywatch/license",
      "features": [
        "自动记录前台应用、窗口标题与浏览器标签 URL",
        "键鼠活动检测用于判断离开状态",
        "事件持久化存储并可按时间线查看",
        "用户自定义类别层级与正则分类规则",
        "支持暂停记录、过滤数据、导出数据"
      ],
      "deployment": [
        "本地运行 watcher 与服务器，数据保存在本机",
        "提供各平台安装包与文档"
      ],
      "technology_stack": [
        "Python",
        "Rust",
        "SQLite"
      ],
