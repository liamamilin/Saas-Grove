    {
      "id": "github:178079595",
      "name": "OpenCost",
      "track": "open_source",
      "summary": "OpenCost 是开源的 Kubernetes 与云成本监控应用：摄取云账单与定价数据，将当前和历史支出按集群、命名空间、控制器、服务或 Pod 分配，并通过成本 API、Prometheus 指标和配套 UI 提供成本可见性。",
      "homepage": "https://www.opencost.io",
      "repository_url": "https://github.com/opencost/opencost",
      "github_repository_id": 178079595,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/opencost/opencost/license",
      "features": [
        "按集群、节点、命名空间、控制器类型、控制器、服务或 Pod 实时分配 Kubernetes 成本",
        "监控 AWS、Azure、GCP 多云服务成本，并支持本地集群自定义 CSV 定价",
        "通过 /metrics 导出定价数据到 Prometheus",
        "提供成本 API、kubectl cost CLI 与配套 Web UI",
        "支持通过 OpenCost Plugins 接入外部成本（如 Datadog）"
      ],
      "deployment": [
        "通过官方 Helm chart 安装到 Kubernetes 1.20+ 集群",
        "多云成本摄取需配置云厂商账单/定价集成"
      ],
      "technology_stack": [
        "Go",
        "Kubernetes",
        "Prometheus"
      ],
