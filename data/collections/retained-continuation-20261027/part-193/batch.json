    {
      "id": "github:1111749091",
      "name": "fishfarm",
      "track": "open_source",
      "summary": "fishfarm 是自托管的水产养殖管理 Web 应用，按养殖场/单元/池塘或网箱登记生产单元，以生产周期记录放养、现存数量、投喂、死亡、水质与收获，并核算周期产出。",
      "homepage": "https://github.com/JavisOTie/fishfarm",
      "repository_url": "https://github.com/JavisOTie/fishfarm",
      "github_repository_id": 1111749091,
      "license": "BSD-3-Clause",
      "license_evidence_url": "https://api.github.com/repos/JavisOTie/fishfarm/license",
      "features": [
        "养殖场、养殖单元与池塘/网箱档案",
        "生产周期及放养/现存数量、状态",
        "放养记录（物种、数量、来源、成本）",
        "投喂、死亡、水质、健康与生物安全日志",
        "收获记录（日期、公斤、售价）并归属生产周期",
        "饲料与物资库存、成本/KPI 控制器"
      ],
      "deployment": [
        "Docker Compose：PHP 7.4 + Apache，映射 8000 端口",
        "标准 PHP Web 服务器 + MySQL"
      ],
      "technology_stack": [
        "PHP",
        "Yii2",
        "MySQL",
        "Docker"
      ],
