  "entries": [
    {
      "id": "github:1402200883",
      "name": "Madrona",
      "track": "open_source",
      "summary": "面向博物馆与文化机构的开源藏品管理平台。Collections 应用覆盖对象编目、入藏与征集、借入借出、展览、状况报告、保护处理、层级位置与移动跟踪、盘点及退出；Apache-2.0，可通过 Docker Compose 自托管。",
      "homepage": "https://www.madrona.app",
      "repository_url": "https://github.com/madrona-app/madrona",
      "github_repository_id": 1402200883,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/madrona-app/madrona/license",
      "features": [
        "对象级编目：标题、尺寸、铭文、材料、分类及人物/机构关联",
        "藏品流程：入库、征集、借入借出、展览、退出与去藏",
        "状况报告与保护处理记录，含事件报告、估值与保险",
        "层级位置树、对象移动跟踪与位置历史",
        "条码标签、扫描盘点与位置核对",
        "多租户与基于角色的访问控制",
        "IIIF 媒体与可选公开发现"
      ],
      "deployment": [
        "Docker Compose 自托管",
        "本地开发：Python 3.12 + Node.js 20.19 + PostgreSQL 16 + Redis",
        "可选 OpenSearch；数据库搜索回退",
        "S3 兼容对象存储（默认 SeaweedFS）"
      ],
      "technology_stack": [
        "Python 3.12",
        "FastAPI",
        "SQLAlchemy",
        "Alembic",
        "Celery",
        "React 19",
        "TypeScript",
        "PostgreSQL 16",
        "Redis",
        "Docker Compose"
      ],
