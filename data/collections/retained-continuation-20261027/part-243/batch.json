    {
      "id": "github:4337337",
      "name": "CollectiveAccess (Providence)",
      "track": "open_source",
      "summary": "历史悠久的开源藏品编目与数据管理后端。Providence 支持可配置元数据、层级关系、媒体、使用/状况/保护管理数据及对象位置历史；GPL-3.0，Web 自托管，需 PHP 8.2+、MySQL 8.4+ 与 Apache/nginx。",
      "homepage": "https://collectiveaccess.org",
      "repository_url": "https://github.com/collectiveaccess/providence",
      "github_repository_id": 4337337,
      "license": "GPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/collectiveaccess/providence/license",
      "features": [
        "可配置元数据字段、界面与报表",
        "层级关系与权威记录",
        "对象当前位置与跨时间位置历史",
        "使用、状况与保护管理数据",
        "媒体与文档管理",
        "批量导入导出、报告与 GraphQL API"
      ],
      "deployment": [
        "Web 自托管部署",
        "支持 Linux、macOS 与 Windows Server",
        "Apache 2.4.43+ 或 nginx 1.30+",
        "PHP 8.2+（建议 8.4/8.5）",
        "MySQL 8.4/9.7；等效 MariaDB 版本可用"
      ],
      "technology_stack": [
        "PHP",
        "MySQL",
        "Apache/nginx",
        "GraphQL API",
        "Web-based"
      ],
