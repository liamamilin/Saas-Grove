      "id": "github:313740591",
      "name": "Cloud Carbon Footprint",
      "track": "open_source",
      "summary": "开源云碳核算应用；以云账号/组织为边界，将 AWS、GCP、Azure 用量按公开方法论和供应商排放因子转换为能耗与 CO2e，按服务、账号和时段汇总并可导出，属于完整的云口径碳核算子模块。",
      "homepage": "https://www.cloudcarbonfootprint.org/",
      "repository_url": "https://github.com/cloud-carbon-footprint/cloud-carbon-footprint",
      "github_repository_id": 313740591,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/cloud-carbon-footprint/cloud-carbon-footprint/license",
      "features": [
        "按云服务用量与供应商排放因子估算能源消耗（kWh）和碳排放（tCO2e）",
        "支持 AWS、Google Cloud、Microsoft Azure 多云账号统一查看",
        "按云厂商、账号、服务和时段下钻，支持 CSV 导出",
        "提供 CLI、Web 应用与 API"
      ],
      "deployment": [
        "自托管 Node.js Web 应用（API + 前端）",
        "支持 Docker 运行",
        "提供 create-app 脚手架与 CLI"
      ],
      "technology_stack": [
        "TypeScript",
        "Node.js",
        "MongoDB"
      ],
