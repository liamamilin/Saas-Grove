    {
      "id": "github:1211634422",
      "name": "CareSync",
      "track": "open_source",
      "summary": "CareSync 是面向小型英国住宿照护机构的开源护理管理系统，以住户记录、支持计划、数字用药管理记录（MAR）和班次任务为核心，并提供审计轨迹。",
      "homepage": "https://github.com/djsmacker01/CareSync",
      "repository_url": "https://github.com/djsmacker01/CareSync",
      "github_repository_id": 1211634422,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/djsmacker01/CareSync/license",
      "features": [
        "住户/service user 记录与支持计划、同意及目标",
        "数字 MAR：append-only，记录 given/refused/pending",
        "药品库存随给药自动扣减与低库存提醒",
        "班次任务板、交接备注与审计轨迹"
      ],
      "deployment": [
        "Node 18+ 与 Supabase（要求 EU region）",
        "前后端分别安装启动，可自托管为 PWA"
      ],
      "technology_stack": [
        "React 19",
        "Node.js/Express",
        "PostgreSQL/Supabase",
        "PWA"
      ],
