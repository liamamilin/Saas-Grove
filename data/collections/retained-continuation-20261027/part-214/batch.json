    {
      "id": "github:679584",
      "name": "OpenEMR",
      "track": "open_source",
      "summary": "OpenEMR 是开源电子健康记录与医疗实践管理应用，提供集成 EHR、实践管理、预约调度、电子计费与国际化支持。",
      "homepage": "https://open-emr.org/",
      "repository_url": "https://github.com/openemr/openemr",
      "github_repository_id": 679584,
      "license": "GPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/openemr/openemr/license",
      "features": [
        "集成电子健康记录、问题列表、药物与临床笔记",
        "实践管理、预约调度与电子计费",
        "国际化与多平台部署支持"
      ],
      "deployment": [
        "官方 README 与文档支持在 Windows、Linux、macOS 等平台自托管部署",
        "官方提供 Docker 部署说明"
      ],
      "technology_stack": [
        "PHP",
        "JavaScript",
        "Docker"
      ],
