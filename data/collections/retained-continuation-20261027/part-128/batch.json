      "leaf_matches": [
        {
          "slug": "corporate-investigation-management",
          "reason": "官方用户手册与 README 共同证明：案件按 ID 贯穿分诊、分配、证据收集、调查记录、结案与报告；结案时调查员必须选择 Closed Refuted/Confirmed/Inconclusive 处置结果并附调查结论，由监督者审批或退回，报告锁定并归档；角色权限限制案件可见范围（合规官仅见 Closed Confirmed），审计轨迹不可变。该系统面向金融欺诈/AML 交易告警案件，不是通用 HR/道德调查；但案件生命周期、事实记录、记录在案的决定与按角色保密四项核心均有官方正文。",
          "source_urls": [
            "https://raw.githubusercontent.com/tazama-lf/case-management-system/main/README.md",
            "https://raw.githubusercontent.com/tazama-lf/docs/dev/Guides/User%20Manuals%20for%20Downloading/Tazama%20Case%20Management%20System%20-%20User%20Manual.docx"
          ]
        }
      ],
      "features": [
        "从交易告警或手工输入创建案件，按案件 ID 管理分诊、分配与调查",
        "证据上传、任务记录、案件笔记与调查摘要",
        "结案处置结果（Closed Refuted/Confirmed/Inconclusive）与监督审批",
        "按角色限制案件可见范围，合规官仅见确认结案案件",
        "不可变案件时间线、评论审计、调查报告生成与归档"
      ],
      "deployment": [
        "NestJS 后端 + React 前端的自托管部署",
        "PostgreSQL 数据库与 Keycloak 认证服务",
        "仓库提供 Docker 服务配置"
      ],
      "technology_stack": [
        "NestJS",
        "React + TypeScript + Vite",
        "PostgreSQL",
        "Keycloak",
        "CouchDB / Flowable BPMN"
      ],
