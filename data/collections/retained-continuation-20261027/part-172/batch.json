  "entries": [
    {
      "id": "github:1269449119",
      "name": "Massing",
      "track": "open_source",
      "summary": "Massing 是 MIT 许可、可自托管的 IFC 原生 AEC 平台，内含通用记录模块与总承包门户；本单元采用其 RFI、施工日报和 Punchlist 三个有独立字段与角色门控工作流的完整登记簿模块。",
      "homepage": "https://github.com/ibuilder/massing",
      "repository_url": "https://github.com/ibuilder/massing",
      "github_repository_id": 1269449119,
      "license": "MIT",
      "license_evidence_url": "https://raw.githubusercontent.com/ibuilder/massing/main/LICENSE",
      "features": [
        "RFI 登记簿：draft→open→answered→closed/void，答复字段必填，answered 可重开，记录支持图纸/规范引用与分发",
        "施工日报：按项目/日期记录天气、人力与工种、已完成工作、到货、设备、延误、访客、安全观察和照片，支持 draft→submitted",
        "Punchlist：缺陷项含位置、责任方、截止日、照片；open→ready→verified，仅 GC 方验证，可拒绝退回",
        "通用模块引擎：CRUD、角色/公司门控工作流、评论、CSV/PDF、IFC 模型锚点、审计时间线",
        "Docker Compose 自托管，MIT 许可，无按席位许可"
      ],
      "deployment": [
        "自托管：docker compose --profile full up --build（web 8080、api 8000，含 PostgreSQL 与 MinIO）",
        "可选演示数据：docker compose --profile full --profile seed run --rm seed",
        "另有 Tauri 桌面版（单项目）"
      ],
      "technology_stack": [
        "FastAPI",
        "React/Vite",
        "PostgreSQL",
        "MinIO/S3",
        "That Open / web-ifc / IfcOpenShell",
        "Docker Compose"
      ],
