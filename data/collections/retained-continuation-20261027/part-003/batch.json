      "leaf_matches": [
        {
          "slug": "internet-calling-application",
          "reason": "Signal 官方帮助文档说明用户从联系人列表选择联系人发起 1:1 语音通话，通话屏幕依次显示 Calling/Connecting、对方在线时的 Ringing、接通后的计时；未接通会显示 No Answer 并挂断。桌面快捷键另列 Answer call、Decline call 与 End call。个人身份、指定联系人、拨出—响铃—接听/拒接—结束的状态化通话与互联网实时语音四项成立。",
          "source_urls": [
            "https://support.signal.org/api/v2/help_center/en-us/articles/360007060492.json",
            "https://support.signal.org/api/v2/help_center/en-us/articles/360007060672.json",
            "https://support.signal.org/api/v2/help_center/en-us/articles/360036517511.json"
          ]
        },
        {
          "slug": "video-calling-application",
          "reason": "同一组 Signal 官方文档说明可在与联系人的会话中点击摄像头图标发起 1:1 视频通话，对方接听后互见，通话中可开关本侧视频；状态同样经历 Calling/Connecting、Ringing 与接通后计时，快捷键提供带视频接听、拒接与结束通话。以视频为媒介的个人定向呼叫与有界生命周期成立；仅取该完整子工作流，不称 Signal 为视频优先产品。",
          "source_urls": [
            "https://support.signal.org/api/v2/help_center/en-us/articles/360007060492.json",
            "https://support.signal.org/api/v2/help_center/en-us/articles/360007060672.json",
            "https://support.signal.org/api/v2/help_center/en-us/articles/360036517511.json"
          ]
        }
      ],
