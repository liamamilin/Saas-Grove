    {
      "id": "github:193416728",
      "name": "HandicapTracker",
      "track": "open_source",
      "summary": "HandicapTracker 是自托管的开源高尔夫差点记录器：按球场评分与坡度录入成绩，持久保存差分历史，并计算、保存个人差点指数。",
      "homepage": "https://github.com/srukelman/HandicapTracker",
      "repository_url": "https://github.com/srukelman/HandicapTracker",
      "github_repository_id": 193416728,
      "license": "GPL-3.0",
      "license_evidence_url": "https://raw.githubusercontent.com/srukelman/HandicapTracker/master/LICENSE",
      "license_review": {
        "reviewer": "opencode-go/deepseek-v4.1-flash",
        "source_url": "https://raw.githubusercontent.com/srukelman/HandicapTracker/master/LICENSE",
        "spdx_id": "GPL-3.0",
        "scope": "repository",
        "rationale": "完整 GNU GPL v3 许可证文本随仓库提供，正文含第 3 版条款与条款条件，仓库代码与许可证同属该仓库。"
      },
      "features": [
        "按球场保存名称、评分、坡度与 9 洞/18 洞标记",
        "录入总分并按球场评分/坡度计算差点差分",
        "持久保存差分历史，并通过 handicap-updater 维护差点指数",
        "PHP/MySQL 自托管 Web 界面"
      ],
      "deployment": [
        "AMP（Apache、MySQL、PHP）环境，自建 Web 服务"
      ],
      "technology_stack": [
        "PHP",
        "MySQL",
        "Apache"
      ],
