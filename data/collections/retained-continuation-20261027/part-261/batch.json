      "id": "github:320998981",
      "name": "Auto Repair SaaS",
      "track": "open_source",
      "summary": "Apache-2.0 的 Django 汽修店管理应用，提供客户/供应商、车辆、员工档案，以及带估价→确认→进行中→完成状态、派工与收款记录的工单流程；未见 labor/parts 行项目或 invoice 模型，车辆字段仅见号牌和车主。",
      "homepage": "https://github.com/wangonya/auto-repair-saas",
      "repository_url": "https://github.com/wangonya/auto-repair-saas",
      "github_repository_id": 320998981,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/wangonya/auto-repair-saas/license",
      "features": [
        "客户与供应商联系人档案",
        "车辆档案（号牌、车主）",
        "工单/估价状态流转（pending、confirmed、in_progress、done）",
        "工单派工、金额、支付方式与支付日期",
        "销售与员工业绩看板"
      ],
      "deployment": [
        "自托管 Django 应用",
        "有 DigitalOcean 演示部署；README 未提供逐步部署教程"
      ],
      "technology_stack": [
        "Django",
        "Python"
      ],
