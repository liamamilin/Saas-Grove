    {
      "id": "github:568098118",
      "name": "Plane",
      "track": "open_source",
      "summary": "用工作项、迭代和文档组织项目的开源社区版应用。商业版与云服务的能力和许可另计。",
      "homepage": "http://plane.so",
      "repository_url": "https://github.com/makeplane/plane",
      "github_repository_id": 568098118,
      "license": "AGPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/makeplane/plane/license",
      "features": [
        "创建和跟踪工作项、任务及关联问题",
        "用 Cycles 管理迭代",
        "以模块、保存视图和文档页面组织项目工作",
        "项目级 Intake（应用内与邮件渠道；公开表单属 Business）及内置自动归档/自动关闭"
      ],
      "deployment": [
        "Docker Compose",
        "Kubernetes/Helm",
        "自托管服务器或 Plane Cloud（云服务不等同于开源仓库）"
      ],
      "technology_stack": [
        "TypeScript",
        "Django",
        "React Router",
        "Node.js",
        "PostgreSQL",
        "Redis",
        "Docker",
        "Kubernetes"
      ],
