    {
      "id": "github:21484781",
      "name": "JumpServer",
      "track": "open_source",
      "summary": "开源特权访问管理（PAM）平台（堡垒机），围绕资产与特权账户提供凭证发现/轮换与加密备份、RBAC/JIT 授权、多协议代理接入和会话录制审计。本条只计入社区版核心能力；README 列为私有或企业版的组件与工单审批、多云同步不纳入。",
      "homepage": "https://www.jumpserver.com",
      "repository_url": "https://github.com/jumpserver/jumpserver",
      "github_repository_id": 21484781,
      "license": "GPL-3.0",
      "license_evidence_url": "https://api.github.com/repos/jumpserver/jumpserver/license",
      "features": [
        "统一管理 SSH、RDP、Kubernetes、数据库、Web 等资产的特权访问",
        "发现特权账户、定期轮换密码并加密备份凭据",
        "基于 RBAC 与 JIT 的细粒度授权和访问审批",
        "会话视频录制、命令审计、实时监控与 SIEM 转发"
      ],
      "deployment": [
        "官方 quick_start.sh 在 64 位 Linux 服务器上一键安装",
        "提供 Docker 镜像作为自托管部署路径",
        "本记录未实际部署运行"
      ],
      "technology_stack": [
        "Web 管理控制台与多协议连接/代理组件（KoKo、Chen 等）",
        "面向服务器、数据库与网络设备的自托管堡垒机架构"
      ],
