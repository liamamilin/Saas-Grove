      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/dremio/dremio-oss/license",
      "features": [
        "连接 catalogs、对象存储和关系数据库等外部数据源",
        "通过 SQL 视图创建虚拟表，转换、连接和聚合数据而不移动或复制源数据",
        "支持跨对象存储、关系数据库和 NoSQL 系统的联邦查询",
        "内置基于 Apache Polaris 的 Open Catalog 与 Apache Iceberg 表能力",
        "自托管 Web UI（默认 9047 端口）与 SQL 查询界面"
      ],
      "deployment": [
        "自托管 Java 服务端应用，README 要求 JDK 21，可用 Maven 构建",
        "构建后通过 dremio start 启动，Web UI 默认位于 http://localhost:9047"
      ],
      "technology_stack": [
        "Java",
        "Apache Arrow",
        "SQL",
        "Apache Iceberg / Apache Polaris",
        "Web UI"
      ],
