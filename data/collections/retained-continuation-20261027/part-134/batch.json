    {
      "id": "github:27911088",
      "name": "Apache NiFi",
      "track": "open_source",
      "summary": "Apache 旗下的开源数据流平台，用于设计、运行和监控在外部系统之间路由、转换和分发数据的持久化管道；提供连接组件、定时/事件驱动调度、运行监控、数据溯源与版本化数据流。",
      "homepage": "https://nifi.apache.org/",
      "repository_url": "https://github.com/apache/nifi",
      "github_repository_id": 27911088,
      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/apache/nifi/license",
      "features": [
        "以 Connection 连接 Processor 组成有向数据流，FlowFile 在连接队列中流转",
        "Process Group 支持命名、保存、版本化与重跑数据流",
        "Processor 支持定时驱动和事件驱动调度，内置重试、退避与背压",
        "Web UI 与 REST API 提供设计、控制、运行状态监控和报告任务",
        "可搜索的数据溯源与端到端血缘"
      ],
      "deployment": [
        "自托管 Java 服务端应用（README 要求 Java 21）",
        "支持单机与集群横向扩展部署，并提供 Docker 相关构建支持"
      ],
      "technology_stack": [
        "Java",
        "Web 浏览器界面",
        "REST API",
        "可插拔 Processor / Controller Service"
      ],
