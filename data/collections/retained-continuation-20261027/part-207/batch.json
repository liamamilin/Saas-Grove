      },
      "features": [
        "监测站点、数据流、观测值与元数据管理",
        "流式数据加载与作业编排（ETL）",
        "数据质量查看、导出下载与 HydroShare 归档",
        "工作区、角色与访问控制",
        "基于 REST/SensorThings 接口的数据共享",
        "独立部署的环境数据实例，支持自托管或云主机"
      ],
      "deployment": [
        "自托管实例（本地服务器、虚拟机或云主机）",
        "Docker Compose 部署",
        "Google Cloud Platform 与 AWS 部署指南"
      ],
      "technology_stack": [
        "Django",
        "TypeScript",
        "PostgreSQL",
        "VitePress"
      ],
