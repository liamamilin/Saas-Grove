      "license": "Apache-2.0",
      "license_evidence_url": "https://api.github.com/repos/netbox-community/netbox/license",
      "features": [
        "Inter-linked data model covering racks, devices, cables, IP addresses, VLANs, circuits and power",
        "Rack view and cable trace for physical placement and connectivity",
        "Single user interface and programmable APIs for infrastructure records",
        "Configuration rendering from stored data via templates"
      ],
      "deployment": [
        "Self-hosted web application (NetBox Community); NetBox Cloud/Enterprise are separate offerings"
      ],
