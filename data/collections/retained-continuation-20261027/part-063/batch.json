      "leaf_matches": [
        {
          "slug": "agent-evaluation-platform",
          "reason": "Promptfoo 官方 agent 评估与 Tracing 文档说明：可通过 Codex SDK、Claude Agent SDK、OpenCode SDK 等 agent provider 执行多步/工具调用型 agent，按测试用例用 trajectory、JavaScript、LLM-rubric 等断言逐案评分；启用 tracing 后每个测试用例执行生成独立 trace，记录 agent 动作、工具调用与评分 span，并以 evaluation ID / test case ID 关联持久化评估结果，可在本地 Web 查看器查看；每次评估保存其配置与结果记录（启用 tracing 时另存 trace），可在同一测试集上比较多次运行。对应 agent 测试用例执行、逐案评分与持久化运行记录核心；运行以配置与 evaluation ID 记录界定，不声称自动打 agent 版本标签。",
          "source_urls": [
            "https://raw.githubusercontent.com/promptfoo/promptfoo/main/README.md",
            "https://www.promptfoo.dev/docs/tracing/",
            "https://www.promptfoo.dev/docs/guides/evaluate-coding-agents/"
          ]
        },
        {
          "slug": "llm-evaluation-platform",
          "reason": "官方 README 说明 Promptfoo 可对提示与模型运行自动化评估、查看/共享结果、并排比较模型并接入 CI/CD；对应 LLM 应用评估的测试用例执行、评分/比较与结果留存工作流。",
          "source_urls": [
            "https://raw.githubusercontent.com/promptfoo/promptfoo/main/README.md"
          ]
