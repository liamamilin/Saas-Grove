      "name": "ERPNext",
      "track": "open_source",
      "summary": "整合财务、采购销售、库存与制造流程的开源 ERP，支持自托管和 Frappe Cloud 托管。",
      "homepage": "https://frappe.io/erpnext",
      "repository_url": "https://github.com/frappe/erpnext",
