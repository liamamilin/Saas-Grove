    {
      "id": "commercial:art-galleria",
      "name": "Art Galleria",
      "track": "commercial",
      "summary": "面向画廊、艺术家工作室与收藏机构的商业艺术品管理平台；官方功能页将 consignments 列为库存与收藏模块管理的实体之一（同列 artworks、artists、editions、locations）。本条目仅按“寄售关系被列为库存实体”作基本类型记录；逐件处置状态、寄售条款、佣金/结算与艺术家共享记录均未在来源中核实。",
      "homepage": "https://www.artgalleria.com/",
      "sources": [
        {
          "url": "https://www.artgalleria.com/features",
          "sha256": "95b5fd04cf9c1b46ed5a0baa11a0d36c07a0e55a9bb6b67d8227645251826be5",
          "snapshot_path": "sources/95b5fd04cf9c1b46ed5a0baa11a0d36c07a0e55a9bb6b67d8227645251826be5.txt",
          "fetched_at": "2026-10-27T01:27:49.197502+08:00",
          "kind": "documentation"
        }
      ],
      "leaf_matches": [
        {
          "slug": "artwork-consignment-management",
          "reason": "官方功能页在 Inventory & Collections 下明确列出 artworks、artists、locations、consignments，For Artists 一节亦列出 consignments；据此只确认官方把 consignments 作为库存与收藏模块管理的实体之一。逐件寄售作品记录、处置（sold/returned）状态、寄售条款、佣金/结算及艺术家与画廊共享记录未在快照中说明，均不作断言。",
          "source_urls": [
            "https://www.artgalleria.com/features"
          ]
        }
      ],
      "verification_status": "official_sources_reviewed",
      "runtime_tested": false
    },
