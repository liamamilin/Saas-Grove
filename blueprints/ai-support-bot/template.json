{
  "formatVersion": "0",
  "id": "ai-support-bot",
  "name": "AI Support Bot",
  "version": "0.1.0-draft",
  "category": "ai-native-template",
  "status": "draft",
  "entry": "TEMPLATE.md",
  "defaultStack": {
    "language": "TypeScript",
    "framework": "Next.js (App Router), single app, npm",
    "database": "PostgreSQL 16 + Drizzle",
    "jobs": "pg-boss (document processing)",
    "auth": "Better Auth behind the contract, or own sessions (argon2id)",
    "models": "Vercel AI SDK, OpenAI-compatible provider; fake provider for tests",
    "pdf": "unpdf",
    "docx": "mammoth",
    "html": "an HTML parser that keeps visible text only (e.g. parse5 or cheerio)",
    "widget": "/widget.js rendered into the host page DOM or an open shadow root (no iframe)"
  },
  "spec": {
    "product": "spec/product.md",
    "architecture": "spec/architecture.md",
    "api": "spec/api.yaml",
    "decisions": "spec/decisions.md",
    "landscape": "spec/landscape.md"
  },
  "stages": [
    {
      "id": "S1",
      "name": "Foundation: accounts, workspaces, roles",
      "doc": "stages/S1-foundation.md",
      "tests": "acceptance/tests/s1",
      "testCount": 24
    },
    {
      "id": "S2",
      "name": "Knowledge and answers: documents, public widget API, cited answers",
      "doc": "stages/S2-knowledge-and-answers.md",
      "tests": "acceptance/tests/s2",
      "testCount": 24
    },
    {
      "id": "S3",
      "name": "Cost and handoff: usage, hard budget, feedback, handoff",
      "doc": "stages/S3-cost-and-handoff.md",
      "tests": "acceptance/tests/s3",
      "testCount": 13
    },
    {
      "id": "S4",
      "name": "Maturity: analytics, conversations, audit, export, deletion, embed",
      "doc": "stages/S4-maturity.md",
      "tests": "acceptance/tests/s4",
      "testCount": 14
    }
  ],
  "acceptance": {
    "runner": "acceptance/run.mjs",
    "invoke": "node run.mjs --app <product-dir> --stage <S1|S2|S3|S4>",
    "selfCheck": "node run.mjs --self-check",
    "cumulative": true,
    "startContract": {
      "script": "scripts/acceptance-start.sh",
      "env": [
        "PORT",
        "DATABASE_URL",
        "TEST_MODE=1",
        "MODEL_PROVIDER=fake",
        "APP_SECRET",
        "APP_BASE_URL"
      ],
      "readiness": "GET /api/health returns 200",
      "startupTimeoutSeconds": 300
    },
    "requires": [
      "node >= 22",
      "psql with rights to CREATE DATABASE",
      "a Chromium for the UI tests (Playwright's, or the local cache)"
    ]
  },
  "humanDecisionPoints": [
    "H1",
    "H2",
    "H3",
    "H4",
    "H5",
    "H6",
    "H7",
    "H8",
    "H9",
    "H10",
    "H11",
    "H12",
    "H13"
  ],
  "humanCheckpoints": [
    "approve spec and acceptance before building",
    "approve each stage when its acceptance passes"
  ],
  "adaptedFrom": {
    "blueprint": "ai-research-assistant",
    "version": "0.3.0-draft"
  }
}
