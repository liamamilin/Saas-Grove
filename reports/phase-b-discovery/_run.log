const r = await fetch(\"https://pay.wechatpay.cn/doc/v3/merchant/4012365342\", { headers: H });
const html = await r.text();
const out = { status: r.status, len: html.length };
// look for embedded json / api hints
out.has_window_init = /window\.__|__NUXT__|__NEXT_DATA__|window\.\w+\s*=/.test(html);
const scriptSrcs = [...html.matchAll(/<script[^>]+src=\"([^\"]+)\"/g)].map(m=>m[1]);
out.script_srcs = scriptSrcs.slice(0,20);
const jsonish = [...html.matchAll(/\"(\/[^\"]*?(?:api|content|doc|md|json)[^\"]*?)\"/gi)].map(m=>m[1]);
out.api_like_paths = [...new Set(jsonish)].slice(0,30);
// where do keywords appear in raw html?
for (const kw of [\"微信支付公钥\",\"APIv3 密钥\",\"SHA256withRSA\",\"数据库\",\"时间戳\"]) {
  const i = html.indexOf(kw);
  out[\"raw_\"+kw] = i;
}
// count occurrences of content markers
out.occ_签名 = (html.match(/签名/g)||[]).length;
out.occ_公钥 = (html.match(/公钥/g)||[]).length;
return out;
"} 
