const H = { \"User-Agent\": \"phase-b-discovery\", \"Accept\": \"application/vnd.github+json\" };
async function j(url) {
  const r = await fetch(url, { headers: H });
  const t = await r.text(); let d=null; try{d=JSON.parse(t)}catch{}
  return { status: r.status, body: d ?? t.slice(0,150) };
}
const out = {};
const rels = [\"temporalio/temporal\",\"triggerdotdev/trigger.dev\",\"hatchet-dev/hatchet\",\"taskforcesh/bullmq\",\"restatedev/restate\"];
for (const slug of rels) {
  const r = await j(`https://api.github.com/repos/${slug}/releases/latest`);
  out[slug] = r.body?.tag_name ? { tag: r.body.tag_name, published: r.body.published_at, name: r.body.name } : { status: r.status, note: \"no latest release or error\" };
}
// CRM finalists
for (const slug of [\"twentyhq/twenty\",\"frappe/crm\",\"espocrm/espocrm\",\"krayin/laravel-crm\"]) {
  const r = await j(`https://api.github.com/repos/${slug}/releases/latest`);
  out[slug] = r.body?.tag_name ? { tag: r.body.tag_name, published: r.body.published_at } : { status: r.status, note: \"no latest release or error\" };
}
const rl = await j(\"https://api.github.com/rate_limit\");
out.remaining = rl.body?.resources?.core?.remaining;
return out;
"} 
