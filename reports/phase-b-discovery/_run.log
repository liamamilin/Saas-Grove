async function md(id){ const r=await fetch(`https://pay.weixin.qq.com/doc/v3/merchant/${id}.md`,{headers:H}); const t=await r.text(); return {status:r.status,len:t.length,text:t}; }
const ids = {
  sign: \"4012365342\",        // APIv3 签名与验签
  createOrder: \"4012791856\", // JSAPI 下单
  queryOrder: \"4012791858\",  // 微信支付订单号查询订单
  payNotify: \"4012791861\",   // 支付成功回调通知
  refund: \"4012791862\",      // 退款申请
  queryRefund: \"4012791863\", // 查询单笔退款
  bill: \"4012791866\",        // 申请交易账单
  pubkeyVerify: \"4013053249\",// 微信支付公钥如何验签
  decryptNotify: \"4012071382\", // 如何解密回调报文
};
const out={};
const got = await Promise.all(Object.entries(ids).map(async ([k,id])=>{ const v=await md(id); return [k,v]; }));
for (const [k,v] of got) out[k] = { status:v.status, len:v.len, head:v.text.slice(0,600).replace(/\n{2,}/g,\"\n\") };
return out;
"} 
