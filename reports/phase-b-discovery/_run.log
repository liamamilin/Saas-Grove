async function j(url) {
  try {
    const r = await fetch(url, { headers: H });
    const t = await r.text();
    let d = null; try { d = JSON.parse(t); } catch {}
    return { status: r.status, body: d ?? t.slice(0, 300) };
  } catch (e) { return { error: String(e) }; }
}
const out = {};
// discover official WeChat Pay SDK org repos
const org = await j(\"https://api.github.com/orgs/wechatpay-apiv3/repos?per_page=100\");
out[\"org wechatpay-apiv3 repos\"] = Array.isArray(org.body)
  ? org.body.map(r => ({ name: r.name, lang: r.language, lic: r.license?.spdx_id, archived: r.archived, pushed: r.pushed_at, desc: (r.description||\"\").slice(0,60) }))
  : org;

// commit SHAs (top candidates)
const repos = [
  [\"twenty\", \"twentyhq/twenty\"],
  [\"frappe-crm\", \"frappe/crm\"],
  [\"espocrm\", \"espocrm/espocrm\"],
  [\"krayin\", \"krayin/laravel-crm\"],
  [\"dolibarr\", \"Dolibarr/dolibarr\"],
];
for (const [k, slug] of repos) {
  const r = await j(`https://api.github.com/repos/${slug}/commits?per_page=1`);
  out[\"sha \" + k] = Array.isArray(r.body) && r.body[0]
    ? { sha: r.body[0].sha, date: r.body[0].commit?.author?.date, msg: r.body[0].commit?.message?.split(\"\n\")[0].slice(0,70) }
    : r;
}
return out;
"} 
