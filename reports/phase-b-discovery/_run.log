const H = { \"User-Agent\": \"phase-b-discovery\" };
async function getHtml(u){ const r=await fetch(u,{headers:H}); return { status:r.status, html: await r.text(), url:u }; }
function toText(html){
  return html
    .replace(/<script[\s\S]*?<\/script>/gi,\" \")
    .replace(/<style[\s\S]*?<\/style>/gi,\" \")
    .replace(/<[^>]+>/g,\" \")
    .replace(/&nbsp;/g,\" \").replace(/&amp;/g,\"&\").replace(/&lt;/g,\"<\").replace(/&gt;/g,\">\").replace(/&quot;/g,'\"').replace(/&#39;/g,\"'\")
    .replace(/\s+/g,\" \").trim();
}
const out={};
const p = await getHtml(\"https://pay.wechatpay.cn/doc/v3/merchant/4012365342\");
out.status = p.status;
const txt = toText(p.html);
out.text_len = txt.length;
// find sentences about signing/verification
for (const kw of [\"签名\",\"验签\",\"SHA256\",\"RSA\",\"时间戳\",\"Nonce\",\"证书\",\"序列号\",\"公钥\"]) {
  const i = txt.indexOf(kw);
  out[\"kw_\"+kw] = i>=0 ? txt.slice(Math.max(0,i-60), i+160) : \"NOT FOUND\";
}
// collect doc links
const links = [...p.html.matchAll(/\/doc\/v3\/merchant\/(\d+)/g)].map(m=>m[1]);
out.unique_doc_ids_count = new Set(links).size;
out.sample_doc_ids = [...new Set(links)].slice(0,40);
return out;
"} 
