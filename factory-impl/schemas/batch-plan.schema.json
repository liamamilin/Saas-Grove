{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/factory/v1.2/batch-plan.schema.json",
  "title": "batch-plan",
  "description": "CF-2 fix. Adds riskClass / retryPolicy / timeout / approvalStrategy / auditScope. PRODUCTION_SENSITIVE is representable but may only appear with dedicatedRiskExecution=true, DUAL_CONTROL approval and FULL_ARTIFACTS audit, so a generic batch cannot smuggle it in.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.2"
      ]
    },
    "batchId": {
      "type": "string",
      "minLength": 1
    },
    "catalogRevision": {
      "type": "string",
      "minLength": 1
    },
    "targetIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "riskClass": {
      "type": "string",
      "enum": [
        "READ_ONLY",
        "SANDBOX_CODE",
        "EXTERNAL_SANDBOX_API",
        "PRODUCTION_SENSITIVE"
      ]
    },
    "dedicatedRiskExecution": {
      "type": "boolean"
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "READ_ONLY",
        "SANDBOX_BUILD",
        "SANDBOX_INTEGRATION"
      ]
    },
    "dryRun": {
      "type": "boolean"
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "discovery": {
          "type": "integer",
          "minimum": 1
        },
        "build": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "discovery",
        "build"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxUsd": {
          "type": "number",
          "minimum": 0
        },
        "maxAttemptsPerJob": {
          "type": "integer",
          "minimum": 1
        },
        "maxRuntimeMinutes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "maxUsd",
        "maxAttemptsPerJob",
        "maxRuntimeMinutes"
      ],
      "additionalProperties": false
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAttempts",
        "backoff"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "backoff": {
          "type": "string",
          "enum": [
            "NONE",
            "LINEAR",
            "EXPONENTIAL"
          ]
        },
        "maxBackoffSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timeout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perJobMinutes",
        "totalMinutes"
      ],
      "properties": {
        "perJobMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "totalMinutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "approvalRequired": {
      "type": "boolean"
    },
    "approvalStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "MANUAL_REQUIRED",
            "RULE_BASED",
            "DUAL_CONTROL"
          ]
        },
        "approverRole": {
          "type": "string",
          "enum": [
            "PRODUCT_OWNER",
            "DISCOVERY_AGENT",
            "BUILDER_AGENT",
            "VALIDATOR",
            "SECURITY_LICENSE_REVIEWER",
            "RELEASE_APPROVER"
          ]
        },
        "approvalRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "auditScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "retentionDays"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "NONE",
            "METADATA",
            "FULL_ARTIFACTS"
          ]
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1
        },
        "includePayloadHashes": {
          "type": "boolean"
        }
      }
    },
    "stopConditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        },
        "required": [
          "before",
          "after"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "batchId",
    "catalogRevision",
    "targetIds",
    "riskClass",
    "executionMode",
    "dryRun",
    "concurrency",
    "budget",
    "retryPolicy",
    "timeout",
    "approvalRequired",
    "approvalStrategy",
    "auditScope",
    "stopConditions",
    "dependencies"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "riskClass": {
            "const": "PRODUCTION_SENSITIVE"
          }
        },
        "required": [
          "riskClass"
        ]
      },
      "then": {
        "required": [
          "dedicatedRiskExecution"
        ],
        "properties": {
          "dedicatedRiskExecution": {
            "const": true
          },
          "approvalStrategy": {
            "properties": {
              "mode": {
                "const": "DUAL_CONTROL"
              }
            }
          },
          "auditScope": {
            "properties": {
              "level": {
                "const": "FULL_ARTIFACTS"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "riskClass": {
            "enum": [
              "READ_ONLY",
              "SANDBOX_CODE",
              "EXTERNAL_SANDBOX_API"
            ]
          }
        },
        "required": [
          "riskClass"
        ]
      },
      "then": {
        "properties": {
          "dedicatedRiskExecution": {
            "const": false
          }
        }
      }
    }
  ]
}
