{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/factory/v1.2/acceptance-report.schema.json",
  "title": "acceptance-report",
  "description": "CF-8 fix. Machine+human readable AcceptanceReport named in 09. Carries no usePolicy of its own (CF-4): it references the DeploymentEligibilityDecision via deploymentEligibilityRef.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resourceId",
    "resourceVersion",
    "artifactSha256",
    "qualityLevelAttested",
    "verificationStatus",
    "deploymentEligibilityRef",
    "claimScope",
    "excludedScenarios",
    "profileIds",
    "gateResults",
    "evidenceIds",
    "upstreamOrigins",
    "licenseDecision",
    "riskExceptions",
    "remainingKnownIssues",
    "reviewer",
    "reviewerRole",
    "approvedAt",
    "reviewDueAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.2"
      ]
    },
    "resourceId": {
      "type": "string",
      "minLength": 1
    },
    "resourceVersion": {
      "type": "string",
      "minLength": 1
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "qualityLevelAttested": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "CATALOGED",
        "VERIFIED",
        "RELEASE_READY"
      ]
    },
    "deploymentEligibilityRef": {
      "type": "string",
      "minLength": 1
    },
    "claimScope": {
      "type": "string",
      "minLength": 1
    },
    "excludedScenarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "profileIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "gateResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gateId",
          "evidenceId",
          "result"
        ],
        "properties": {
          "gateId": {
            "type": "string",
            "minLength": 1
          },
          "evidenceId": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "upstreamOrigins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "revision",
          "usage"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "usage": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "licenseDecision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REVIEW_REQUIRED",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "riskExceptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "remainingKnownIssues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewerRole": {
      "type": "string",
      "enum": [
        "PRODUCT_OWNER",
        "DISCOVERY_AGENT",
        "BUILDER_AGENT",
        "VALIDATOR",
        "SECURITY_LICENSE_REVIEWER",
        "RELEASE_APPROVER"
      ]
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewDueAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
