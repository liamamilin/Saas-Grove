> factory-impl-dev · deepseek/deepseek-v4.1-flash
The environment is a large shared global env, so a raw `pip freeze` is not a project lock. Let me build the lock from the actual installed versions of the declared dependency closure:
[0m$ [0mcd factory-impl && python3 - <<'PY'
from importlib.metadata import version, PackageNotFoundError
# direct declared + transitive runtime/dev closure
pkgs = ["jsonschema","typer","fastapi","uvicorn","pytest","httpx",
        "starlette","pydantic","pydantic-core","annotated-types","typing-extensions",
        "typing-inspection","click","h11","rich","shellingham","jsonschema-specifications",
        "referencing","rpds-py","attrs","pluggy","iniconfig","packaging","httpcore",
        "certifi","idna","sniffio","anyio"]
for p in pkgs:
    try:
        print(f"{p}=={version(p)}")
    except PackageNotFoundError:
        print(f"# MISSING {p}")
PY
