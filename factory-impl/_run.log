run job transition --id j1 --to AWAITING_SELECTION --role DISCOVERY_AGENT --actor d --reason triage
run job transition --id j1 --to PLAN_APPROVED --role PRODUCT_OWNER --actor po --reason approve --cosigner SECURITY_LICENSE_REVIEWER
run job transition --id j1 --to TRANSFORMING --role BUILDER_AGENT --actor b --reason build
run job transition --id j1 --to CALIBRATING --role BUILDER_AGENT --actor b --reason cal
run job transition --id j1 --to STAGING_ARTIFACT --role BUILDER_AGENT --actor b --reason stage --cosigner SECURITY_LICENSE_REVIEWER
run freeze --id business.crm --version 1.0.0 --manifest examples/resource_manifest.json --payload "$WORK/payload" --by b --job-id j1 --attempt-id j1-a1
