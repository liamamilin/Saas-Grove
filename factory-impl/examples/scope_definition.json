{
  "schemaVersion": "1.2",
  "scopeId": "scope.crm.sandbox.single-tenant",
  "deploymentMode": "SELF_HOSTED",
  "runtime": "node>=20",
  "database": "postgres",
  "tenantModel": "SINGLE_TENANT",
  "region": "multi",
  "regulatoryEnvironment": "none-declared",
  "capabilitySet": [
    "customer.create",
    "customer.list",
    "contact.list",
    "opportunity.list",
    "opportunity.move-stage"
  ],
  "thirdPartyChannels": [
    {
      "name": "none",
      "channel": "MOCK"
    }
  ],
  "exclusions": [
    "multi-tenant",
    "live payments",
    "production PII"
  ]
}
