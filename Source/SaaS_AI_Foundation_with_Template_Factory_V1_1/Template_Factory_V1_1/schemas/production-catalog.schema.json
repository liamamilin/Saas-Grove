{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/factory/v1.1/production-catalog.schema.json",
  "title": "production-catalog",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "catalogRevision": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]+$"
          },
          "name": {
            "type": "string"
          },
          "resourceType": {
            "type": "string",
            "enum": [
              "saas-core-module",
              "business-saas-template",
              "ai-native-template",
              "saas-ai-module"
            ]
          },
          "capabilitiesRequired": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]+$"
            },
            "minItems": 1
          },
          "scope": {
            "type": "object",
            "properties": {
              "deployment": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "userScenario": {
                "type": "string"
              },
              "exclusions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 0
              }
            },
            "required": [
              "deployment",
              "region",
              "userScenario",
              "exclusions"
            ],
            "additionalProperties": false
          },
          "targetQualityLevel": {
            "type": "string",
            "enum": [
              "L1",
              "L2",
              "L3"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "licensePolicy": {
            "type": "string",
            "enum": [
              "permissive-preferred",
              "manual-legal-review",
              "first-party-only"
            ]
          },
          "acceptanceProfileId": {
            "type": "string"
          },
          "sourceStrategy": {
            "type": "string",
            "enum": [
              "discover",
              "preferred-source",
              "first-party"
            ]
          },
          "preferredSources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "prototypeRequirements": {
            "type": "object",
            "properties": {
              "targetCount": {
                "type": "integer",
                "minimum": 0
              },
              "implementationLevel": {
                "type": "string",
                "enum": [
                  "design-only",
                  "interactive-mock",
                  "integrated"
                ]
              }
            },
            "required": [
              "targetCount",
              "implementationLevel"
            ],
            "additionalProperties": false
          },
          "budget": {
            "type": "object",
            "properties": {
              "maxUsd": {
                "type": "number",
                "minimum": 0
              },
              "maxAttempts": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "maxUsd",
              "maxAttempts"
            ],
            "additionalProperties": false
          },
          "owner": {
            "type": "string"
          },
          "externalDependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "origin",
                "lockedRevision",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "origin": {
                  "type": "string"
                },
                "lockedRevision": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "UNVERIFIED",
                    "VERIFIED",
                    "BLOCKED"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "id",
          "name",
          "resourceType",
          "capabilitiesRequired",
          "scope",
          "targetQualityLevel",
          "priority",
          "licensePolicy",
          "acceptanceProfileId",
          "sourceStrategy",
          "budget",
          "owner"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "catalogRevision",
    "targets"
  ],
  "additionalProperties": false
}
