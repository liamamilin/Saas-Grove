{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/factory/v1.1/batch-plan.schema.json",
  "title": "batch-plan",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "batchId": {
      "type": "string"
    },
    "catalogRevision": {
      "type": "string"
    },
    "targetIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "READ_ONLY",
        "SANDBOX_BUILD",
        "SANDBOX_INTEGRATION"
      ]
    },
    "dryRun": {
      "type": "boolean"
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "discovery": {
          "type": "integer",
          "minimum": 1
        },
        "build": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "discovery",
        "build"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxUsd": {
          "type": "number",
          "minimum": 0
        },
        "maxAttemptsPerJob": {
          "type": "integer",
          "minimum": 1
        },
        "maxRuntimeMinutes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "maxUsd",
        "maxAttemptsPerJob",
        "maxRuntimeMinutes"
      ],
      "additionalProperties": false
    },
    "approvalRequired": {
      "type": "boolean"
    },
    "stopConditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        },
        "required": [
          "before",
          "after"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "batchId",
    "catalogRevision",
    "targetIds",
    "executionMode",
    "dryRun",
    "concurrency",
    "budget",
    "approvalRequired",
    "stopConditions",
    "dependencies"
  ],
  "additionalProperties": false
}
