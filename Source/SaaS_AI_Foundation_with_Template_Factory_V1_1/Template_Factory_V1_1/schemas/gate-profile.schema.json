{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/factory/v1.1/gate-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "profileVersion",
    "resourceType",
    "scopeId",
    "levels",
    "reviewPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "profileVersion": {
      "type": "string",
      "minLength": 1
    },
    "resourceType": {
      "enum": [
        "saas-core-module",
        "business-saas-template",
        "ai-native-template",
        "saas-ai-module"
      ]
    },
    "scopeId": {
      "type": "string",
      "minLength": 1
    },
    "levels": {
      "type": "object",
      "required": [
        "L1",
        "L2",
        "L3"
      ],
      "additionalProperties": false,
      "properties": {
        "L1": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "L2": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "L3": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independentValidatorRequired"
      ],
      "properties": {
        "independentValidatorRequired": {
          "type": "boolean"
        }
      }
    }
  }
}
